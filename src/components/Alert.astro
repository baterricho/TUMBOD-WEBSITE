---
/**
 * Alert — four levels, distinguished by colour, border weight, icon, and
 * explicit leading word. All four pairings clear WCAG 2.2 AA (>= 4.5:1)
 * across both light and dark themes.
 */
import Icon from './Icon.astro'
import type { AlertLevel } from '@/lib/content/types'
import { getDictionary, type Locale } from '@/lib/i18n'

interface Props {
  level: AlertLevel
  locale: Locale
}

const { level, locale } = Astro.props
const t = getDictionary(locale)

const ICON = {
  info: 'info',
  advisory: 'megaphone',
  warning: 'warning',
  emergency: 'warning',
} as const

const isUrgent = level === 'warning' || level === 'emergency'
---

<div role={isUrgent ? 'alert' : 'status'} class={`alert-box alert-box--${level}`}>
  <span class="alert-box__icon" aria-hidden="true">
    <Icon name={ICON[level]} size={20} />
  </span>
  <div class="alert-box__content">
    <strong class="alert-box__label">{t.alert[level]}</strong>
    <div class="alert-box__body"><slot /></div>
  </div>
</div>

<style>
  .alert-box {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    border-inline-start-width: 4px;
  }

  .alert-box__icon {
    flex-shrink: 0;
    margin-top: 2px;
    display: inline-flex;
  }

  .alert-box__content {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .alert-box__label {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    font-size: var(--text-xs);
  }

  .alert-box__body {
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .alert-box--info {
    background: var(--alert-info-surface);
    border-color: var(--alert-info-border);
    border-inline-start-color: var(--alert-info);
    color: var(--alert-info-ink);
  }

  .alert-box--advisory {
    background: var(--alert-advisory-surface);
    border-color: var(--alert-advisory-border);
    border-inline-start-color: var(--alert-advisory);
    color: var(--alert-advisory-ink);
  }

  .alert-box--warning {
    background: var(--alert-warning-surface);
    border-color: var(--alert-warning-border);
    border-inline-start-color: var(--alert-warning);
    color: var(--alert-warning-ink);
  }

  .alert-box--emergency {
    background: var(--alert-emergency);
    border-color: var(--alert-emergency-hover);
    border-inline-start-color: var(--alert-emergency-ink);
    color: var(--alert-emergency-ink);
  }
</style>
