    priority: false,
  },
  {
    id: 'rhu-taytay',
    agencyFil: 'RHU Taytay — Municipal Health Clinic & Trauma',
    agencyEn: 'Rural Health Unit Taytay — Clinic & Trauma Care',
    roleFil: 'Pangunahing Medikal, Gamutan sa Nalunod, First Aid',
    roleEn: 'Emergency Medical Services, Marine Trauma & First Aid',
    contactPerson: 'Triage & Emergency Nurse',
    number: '0919-482-1194',
    displayNumber: '0919-482-1194',
    category: 'health',
    availabilityFil: '24/7 Emergency Triage',
    availabilityEn: '24/7 Emergency Triage',
    badgeFil: 'Medikal',
    badgeEn: 'Medical',
    priority: false,
  },
  {
    id: 'pnp-taytay',
    agencyFil: 'PNP Taytay — Police Station & Maritime Unit',
    agencyEn: 'PNP Taytay — Police Station & Maritime Patrol',
    roleFil: 'Kapayapaan, Kaayusan sa Baybayin, Bantay-Dagat',
    roleEn: 'Law Enforcement, Coastal Security, Sea Patrol',
    contactPerson: 'Desk Officer / Duty Investigator',
    number: '0998-598-5832',
    displayNumber: '0998-598-5832',
    category: 'official',
    availabilityFil: '24/7 Desk Hotline',
    availabilityEn: '24/7 Desk Hotline',
    badgeFil: 'Pulisya',
    badgeEn: 'Police',
    priority: false,
  },
]

const CATEGORY_CHIP: Record<ContactEntry['category'], string> = {
  coastguard: 'chip chip--info',
  rescue: 'chip chip--danger',
  official: 'chip chip--warning',
  health: 'chip chip--open',
}
---

<div class="emergency-directory-wrap" id="emergency-directory">
  <div class="directory-header">
    <div class="header-left">
      <span class="chip chip--danger">
        <Icon name="phone" size={13} />
        <span>{fil ? 'Talaan ng Telepono' : 'Emergency Directory'}</span>
      </span>
      <h3 class="directory-title">
        {fil ? 'Direktoryo ng mga Pang-emerhensyang Numero' : 'Emergency Contact Directory'}
      </h3>
      <p class="directory-subtitle">
        {fil
          ? 'Pindutin ang mga numero upang agad na makatawag sa mga opisyal ng barangay, Coast Guard, at rescue team kahit mahina ang signal.'
          : 'Tap any number below to dial barangay officials, Coast Guard, and rescue teams directly over cellular voice.'}
      </p>
    </div>

    <div class="marine-vhf-box">
      <span class="vhf-icon" aria-hidden="true">
        <Icon name="radio" size={18} />
      </span>
      <div class="vhf-text">
        <strong>{fil ? 'VHF Channel 16 (Distress)' : 'VHF Radio Ch. 16'}</strong>
        <span class="figure">156.800 MHz — Taytay Coast Guard</span>
      </div>
    </div>
  </div>

  <div class="table-wrap">
    <table
      class="data-table directory-table"
      aria-label={fil ? 'Direktoryo ng Pang-emerhensyang Numero' : 'Emergency Contacts Table'}
    >
      <thead>
        <tr>
          <th scope="col">{fil ? 'Ahensya / Pangalan' : 'Agency / Official'}</th>
          <th scope="col">{fil ? 'Tungkulin at Saklaw' : 'Role & Jurisdiction'}</th>
          <th scope="col">{fil ? 'Oras / Antabay' : 'Availability'}</th>
          <th scope="col" class="num">{fil ? 'Tawagan' : 'Call'}</th>
        </tr>
      </thead>
      <tbody>
        {DIRECTORY.map((item) => (
          <tr class={item.priority ? 'row--priority' : ''}>
            <td class="cell-agency">
              <div class="agency-cell-content">
                <span class={CATEGORY_CHIP[item.category]}>
                  {fil ? item.badgeFil : item.badgeEn}
                </span>
                <strong class="agency-name">{fil ? item.agencyFil : item.agencyEn}</strong>
                {item.contactPerson && (
                  <span class="contact-person">
                    <Icon name="user" size={12} />
                    <span>{item.contactPerson}</span>
                  </span>
                )}
                {item.channel && (
                  <span class="radio-channel-tag figure">
                    <Icon name="radio" size={12} />
                    <span>{item.channel}</span>
                  </span>
                )}
              </div>
            </td>

            <td class="cell-role">
              <span class="role-desc">{fil ? item.roleFil : item.roleEn}</span>
            </td>

            <td class="cell-avail">
              <span class="avail-badge">
                <span class="avail-dot" aria-hidden="true"></span>
                <span>{fil ? item.availabilityFil : item.availabilityEn}</span>
              </span>
            </td>

            <td class="cell-action num">
              <div class="action-wrap">
                <a
                  href={`tel:${item.number.replace(/[^0-9+]/g, '')}`}
                  class={`btn ${item.priority ? 'btn--danger' : 'btn--primary'} dir-call-btn`}
                  aria-label={`${fil ? 'Tawagan ang' : 'Call'} ${fil ? item.agencyFil : item.agencyEn} sa ${item.displayNumber}`}
                  data-plain
                >
                  <Icon name="phone" size={14} />
                  <span class="figure">{item.displayNumber}</span>
                </a>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="directory-footer">
    <div class="footer-tip">
      <Icon name="shield" size={15} />
      <span>
        {fil
          ? 'Tip sa Mahinang Signal: Direktang gumagana ang voice call sa 2G/3G kahit walang mobile data.'
          : 'Low-Signal Tip: Voice calls connect over 2G/3G cellular even when mobile data is unavailable.'}
      </span>
    </div>
  </div>
</div>

<style>
  .emergency-directory-wrap {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .directory-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--line);
  }

  .header-left {
    max-width: 60ch;
    display: grid;
    gap: 6px;
    justify-items: start;
  }

  .directory-title {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink-strong);
  }

  .directory-subtitle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .marine-vhf-box {
    background: var(--surface-inverse);
    color: var(--ink-inverse);
    border-radius: var(--r-inner);
    padding: var(--space-3) var(--space-4);
    display: flex;
    align-items: center;
    gap: var(--space-3);
    border: 1px solid var(--line-strong);
  }

  .vhf-icon {
    color: var(--palette-amber-400);
    flex-shrink: 0;
    display: inline-flex;
  }

  .vhf-text {
    display: grid;
    gap: 2px;
  }

  .vhf-text strong {
    font-size: var(--text-sm);
    color: var(--palette-white);
  }

  .vhf-text span {
    font-size: var(--text-xs);
    color: #cbd5e1;
  }

  .row--priority td {
    background-color: var(--alert-emergency-surface);
  }

  .agency-cell-content {
    display: grid;
    gap: 4px;
    justify-items: start;
  }

  .agency-name {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink-strong);
  }

  .contact-person {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .radio-channel-tag {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--interactive);
    font-weight: 600;
  }

  .role-desc {
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: 1.45;
  }

  .avail-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-weight: 600;
  }

  .avail-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--status-open);
    flex-shrink: 0;
  }

  .action-wrap {
    display: flex;
    justify-content: flex-end;
  }

  .directory-footer {
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .footer-tip {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.45;
  }

  /* Responsive mobile cards */
  @media (max-width: 680px) {
    .emergency-directory-wrap {
      padding: var(--space-4);
    }

    .table-wrap {
      border: 0;
      background: transparent;
      box-shadow: none;
      overflow: visible;
    }

    .directory-table,
    .directory-table thead,
    .directory-table tbody,
    .directory-table th,
    .directory-table td,
    .directory-table tr {
      display: block;
    }

    .directory-table thead {
      display: none;
    }

    .directory-table tr {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--r-card);
      margin-bottom: var(--space-3);
      padding: var(--space-4);
    }

    .directory-table tr.row--priority {
      border-color: var(--alert-emergency-border);
      border-inline-start: 4px solid var(--alert-emergency);
    }

    .directory-table td {
      padding: 6px 0;
      border-bottom: 0;
      background: transparent !important;
      text-align: left !important;
    }

    .cell-agency {
      padding-bottom: var(--space-2) !important;
      border-bottom: 1px solid var(--line) !important;
      margin-bottom: var(--space-2);
    }

    .cell-action {
      padding-top: var(--space-3) !important;
      border-top: 1px solid var(--line) !important;
      margin-top: var(--space-2);
    }

    .action-wrap,
    .dir-call-btn {
      width: 100%;
    }
  }
</style>
