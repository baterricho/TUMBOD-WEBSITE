<script is:inline>
  ;(function () {
    var inputs = [].slice.call(document.querySelectorAll('#fisherman-checklist .checklist-item__input'))
    var counter = document.getElementById('checklist-counter')
    var notice = document.getElementById('checklist-notice')
    var total = inputs.length
    if (!total) return

    var KEY = 'tumbod:fisherman-checklist'
    try {
      var saved = JSON.parse(localStorage.getItem(KEY) || '{}')
      inputs.forEach(function (input) {
        if (saved[input.id]) input.checked = true
      })
    } catch (e) {}

    function updateChecklist() {
      var checked = 0
      var state = {}
      inputs.forEach(function (input) {
        if (input.checked) checked++
        state[input.id] = input.checked
      })
      if (counter) counter.textContent = checked + ' / ' + total
      if (notice) notice.hidden = checked !== total
      try {
        localStorage.setItem(KEY, JSON.stringify(state))
      } catch (e) {}
    }

    inputs.forEach(function (input) {
      input.addEventListener('change', updateChecklist)
    })
    updateChecklist()
  })()
</script>
