<script is:inline>
;(function() {
  var inputs = document.querySelectorAll('#fisherman-checklist .checklist-item__input')
  var counter = document.getElementById('checklist-counter')
  var notice = document.getElementById('checklist-notice')
  var total = inputs.length

  function updateChecklist() {
    var checked = 0
    inputs.forEach(function(input) {
      if (input.checked) checked++
    })
    if (counter) counter.textContent = checked + ' / ' + total
    if (notice) {
      if (checked === total) {
        notice.hidden = false
      } else {
        notice.hidden = true
      }
    }
  }

  inputs.forEach(function(input) {
    input.addEventListener('change', updateChecklist)
  })
})()
</script>
