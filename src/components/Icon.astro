---
/**
 * Icon set — 24px grid, single stroke weight, inline SVG.
 * No icon font, no icon library dependency (BUILD-PROMPT.md §8.4).
 *
 * Icons never appear alone where meaning matters; always paired with a label.
 * Omit `title` for decorative use (gets aria-hidden); pass it to give the icon
 * an accessible name.
 */

export type IconName =
  | 'bangka' | 'wave-calm' | 'wave-moderate' | 'wave-rough' | 'wave-dangerous'
  | 'wind' | 'anchor' | 'mangrove' | 'health' | 'rice-sack' | 'document'
  | 'phone' | 'megaphone' | 'calendar' | 'clock' | 'pin' | 'download'
  | 'checklist' | 'warning' | 'info' | 'evacuation' | 'offline' | 'search'
  | 'print' | 'copy' | 'external'
  // Added for the icon navigation and the hero carousel.
  | 'shield' | 'mail' | 'chevron-left' | 'chevron-right' | 'layers'
  // Hero map chrome.
  | 'chevron-down' | 'plus' | 'minus' | 'locate' | 'sun' | 'droplet'

const PATHS: Record<IconName, string> = {
  bangka: 'M3 15h18l-2 4H5l-2-4Zm2-1V9m14 5V9M7 14 12 5l5 9',
  'wave-calm': 'M2 12h20M2 16h20',
  'wave-moderate': 'M2 11c3-2 5 2 8 0s5-2 8 0M2 16c3-2 5 2 8 0s5-2 8 0',
  'wave-rough': 'M2 10c3-4 5 4 8 0s5-4 8 0M2 16c3-4 5 4 8 0s5-4 8 0',
  'wave-dangerous': 'M2 17c3-6 5 6 8 0s5-6 8 0M6 11 9 5l2 4 2-6 3 8',
  wind: 'M3 8h11a3 3 0 1 0-3-3M3 13h15a3 3 0 1 1-3 3M3 18h8',
  anchor: 'M12 8v13M8 11H5a7 7 0 0 0 14 0h-3M12 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z',
  mangrove: 'M12 21V9M12 9 7 4M12 9l5-5M6 21c2-4 4-6 6-6s4 2 6 6',
  health: 'M12 5v14M5 12h14',
  'rice-sack': 'M8 8h8l2 12H6L8 8Zm0 0c0-2 1-4 4-4s4 2 4 4',
  document: 'M6 3h8l4 4v14H6V3Zm8 0v4h4M9 12h6M9 16h6',
  phone: 'M6 3h4l2 5-3 2a12 12 0 0 0 5 5l2-3 5 2v4a2 2 0 0 1-2 2A17 17 0 0 1 4 5a2 2 0 0 1 2-2Z',
  megaphone: 'M4 10v4h4l7 5V5l-7 5H4Zm14-1a4 4 0 0 1 0 6',
  calendar: 'M4 6h16v15H4V6Zm0 5h16M9 3v4M15 3v4',
  clock: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Zm0-14v5l3 2',
  pin: 'M12 21s7-6 7-11a7 7 0 1 0-14 0c0 5 7 11 7 11Zm0-8a3 3 0 1 1 0-6 3 3 0 0 1 0 6Z',
  download: 'M12 3v12m0 0-4-4m4 4 4-4M4 19h16',
  checklist: 'M4 7l2 2 3-3M4 15l2 2 3-3M13 8h7M13 16h7',
  warning: 'M12 3 2 20h20L12 3Zm0 6v6m0 3v.5',
  info: 'M12 21a9 9 0 1 1 0-18 9 9 0 0 1 0 18Zm0-13v.5M12 12v5',
  evacuation: 'M4 20h16M8 20V9l6-4v15M14 12h5v8',
  offline: 'M3 3l18 18M8 15a5 5 0 0 1 6-1M4 11a11 11 0 0 1 5-3m6 0a11 11 0 0 1 5 3M12 19v.5',
  search: 'M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Zm5 -2 5 5',
  print: 'M7 8V3h10v5M7 18H4V8h16v10h-3M7 14h10v7H7v-7Z',
  copy: 'M9 9h11v11H9V9Zm-4 6H4V4h11v1',
  external: 'M14 4h6v6M20 4l-9 9M18 14v6H4V6h6',
  shield: 'M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Zm-3 9 2 2 4-4',
  mail: 'M3 6h18v12H3V6Zm0 1 9 7 9-7',
  'chevron-left': 'M15 5l-7 7 7 7',
  'chevron-right': 'M9 5l7 7-7 7',
  layers: 'M12 3 3 8l9 5 9-5-9-5ZM3 13l9 5 9-5M3 17.5l9 5 9-5',
  'chevron-down': 'M6 9l6 6 6-6',
  plus: 'M12 5v14M5 12h14',
  minus: 'M5 12h14',
  /* Crosshair — "put the barangay back in the middle". */
  locate: 'M12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8ZM12 2v3m0 14v3M2 12h3m14 0h3',
  /* Weather. The sea icons cover the sea; these cover the sky. */
  sun: 'M12 17a5 5 0 1 1 0-10 5 5 0 0 1 0 10ZM12 1v3m0 16v3M4.2 4.2l2.1 2.1m11.4 11.4 2.1 2.1M1 12h3m16 0h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1',
  droplet: 'M12 3s6 6.3 6 10a6 6 0 0 1-12 0c0-3.7 6-10 6-10Z',
}

interface Props {
  name: IconName
  size?: number
  title?: string
}

const { name, size = 24, title } = Astro.props
const decorative = title === undefined
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={decorative ? undefined : 'img'}
  aria-hidden={decorative ? 'true' : undefined}
  focusable="false"
  style="flex-shrink:0"
>
  {title && <title>{title}</title>}
  <path d={PATHS[name]} />
</svg>
