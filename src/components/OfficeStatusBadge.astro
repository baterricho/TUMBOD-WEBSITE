---
/**
 * OfficeStatusBadge — Real-time Asia/Manila Barangay Hall operating status.
 */
import Placeholder from './Placeholder.astro'
import type { OfficeHours } from '@/lib/content/types'
import { getDictionary, type Locale } from '@/lib/i18n'
import { isPlaceholder } from '@/lib/content/placeholder'

interface Props {
  hours: OfficeHours
  locale: Locale
}

const { hours, locale } = Astro.props
const t = getDictionary(locale)

const LABEL = { open: t.office.open, limited: t.office.limited, closed: t.office.closed } as const
---

<div class="office-status">
  <p class="office-status__row">
    <span class={`office-status__pill office-status__pill--${hours.state}`}>
      <span class="office-status__dot" aria-hidden="true"></span>
      <strong>{LABEL[hours.state]}</strong>
    </span>
    <span class="office-status__day">· {hours.todayLabel}</span>
  </p>
  <p class="office-status__sub">
    {
      hours.state === 'closed' ? (
        <>
          {t.office.opensTomorrow},{' '}
          {isPlaceholder(hours.nextOpen) ? (
            <Placeholder value={hours.nextOpen} />
          ) : (
            <span class="figure">{hours.nextOpen}</span>
          )}
        </>
      ) : (
        <>
          {t.office.hoursToday}:{' '}
          {isPlaceholder(hours.hoursToday) ? (
            <Placeholder value={hours.hoursToday} />
          ) : (
            <span class="figure">{hours.hoursToday}</span>
          )}
        </>
      )
    }
  </p>
</div>

<style>
  .office-status {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .office-status__row {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-base);
  }

  .office-status__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: 0.04em;
  }

  .office-status__pill--open {
    background: var(--status-open-surface);
    border-color: var(--status-open-border);
    color: var(--status-open-ink);
  }

  .office-status__pill--limited {
    background: var(--status-caution-surface);
    border-color: var(--status-caution-border);
    color: var(--status-caution-ink);
  }

  .office-status__pill--closed {
    background: var(--status-closed-surface);
    border-color: var(--status-closed-border);
    color: var(--status-closed-ink);
  }

  .office-status__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--radius-full);
    background-color: currentColor;
    flex-shrink: 0;
  }

  .office-status__day {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    letter-spacing: 0;
  }

  .office-status__sub {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    letter-spacing: 0;
  }
</style>
