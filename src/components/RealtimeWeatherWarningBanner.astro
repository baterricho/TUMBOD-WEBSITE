---
/**
 * RealtimeWeatherWarningBanner.astro
 *
 * Real-time maritime & weather warning banner for Barangay Tumbod / Tuluran Island.
 * Uses paired semantic status tokens (WCAG 2.2 AA in light & dark mode) without
 * jarring dark slabs or neon glow halos.
 */
import Icon from './Icon.astro'
import type { Locale } from '@/lib/i18n'
import type { MarineWeatherReport } from '@/lib/weather'

interface Props {
  locale: Locale
  report?: MarineWeatherReport
}

const { locale, report } = Astro.props
const fil = locale === 'fil'

const cur = report?.current
const waveHeight = cur?.waveHeightM ?? 0.6
const windSpeed = cur?.windSpeedKph ?? 14
const windGusts = cur?.windGustsKph ?? 19
const windDir = cur?.windCardinalFil ?? 'Hilagang Silangan (Amihan)'
const monsoon = cur?.monsoonFil ?? 'Amihan (Northeast Monsoon)'
const updatedAt = cur?.time
  ? new Date(cur.time).toLocaleTimeString(fil ? 'fil-PH' : 'en-US', { hour: '2-digit', minute: '2-digit' })
  : 'Live'

let severity: 'danger' | 'caution' | 'safe' = 'safe'
if (waveHeight >= 1.5 || windSpeed >= 32 || windGusts >= 42) {
  severity = 'danger'
} else if (waveHeight >= 0.95 || windSpeed >= 20 || windGusts >= 28) {
  severity = 'caution'
}

const SEVERITY_CONFIG = {
  danger: {
    badgeFil: 'DELIKADO — BAWAL PUMALAOT (NO SAIL)',
    badgeEn: 'DANGER — STRICTLY NO SAILING (GALE ALERT)',
    icon: 'warning',
    headlineFil: 'Mahigpit na Babala sa Dagat: Ipinagbabawal ang Paglayag ng Lahat ng Bangka',
    headlineEn: 'Severe Maritime Warning: All Small Craft Voyages Strictly Suspended',
    subtextFil: `Nasa ${waveHeight} m ang alon at may bugso ng hangin na ${windGusts} km/h sa Kipot ng Tuluran at Look ng Taytay. Alinsunod sa Philippine Coast Guard MC 03-01, ipinagbabawal ang pagpalaot ng mga bangkang mas mababa sa 3 Gross Ton. I-ahon agad ang mga bangka sa ligtas na pampang.`,
    subtextEn: `Wave swell is ${waveHeight} m with gusts up to ${windGusts} km/h across Tuluran Strait and Taytay Bay. Pursuant to PCG regulations, all watercraft under 3 GT are legally barred from unmooring. Haul out bancas to high ground immediately.`,
  },
  caution: {
    badgeFil: 'MAG-INGAT — LIMITADO ANG PAGLAYAG',
    badgeEn: 'CAUTION — SMALL CRAFT ADVISORY',
    icon: 'warning',
    headlineFil: 'Paalala sa Mangingisda: May Katamtamang Alon at Chop sa Kipot ng Tuluran',
    headlineEn: 'Fishermen Advisory: Moderate Cross-Swell & Chop in Tuluran Strait',
    subtextFil: `Umakyat ang alon sa ${waveHeight} m kasama ang hanging ${windSpeed} km/h (${windDir}). Hindi pinapayagan ang maliliit na de-sagwan o bangkang walang katig na tumawid sa malawak na dagat patungong Casian Island o Shark Fin Bay.`,
    subtextEn: `Wave height is ${waveHeight} m with winds at ${windSpeed} km/h (${cur?.windCardinal ?? 'NE'}). Unmotorized or small bancas under 1 GT are advised not to traverse deep waters toward Casian or Shark Fin Bay.`,
  },
  safe: {
    badgeFil: 'LIGTAS PUMALAOT — NORMAL NA DAGAT',
    badgeEn: 'SAFE TO SAIL — FAVORABLE SEA CONDITIONS',
    icon: 'anchor',
    headlineFil: 'Kondisyon sa Dagat: Payapa at Ligtas ang Karagatan ng Tuluran',
    headlineEn: 'Sea Condition: Calm & Safe for All Fishing Operations',
    subtextFil: `Banayad ang alon (${waveHeight} m) at kaaya-aya ang hangin (${windSpeed} km/h mula sa ${windDir}). Ligtas sa pangingisda sa Look ng Taytay at bukas ang tawiran sa Kipot ng Tuluran.`,
    subtextEn: `Gentle swell (${waveHeight} m) and light sea breeze (${windSpeed} km/h from ${cur?.windCardinal ?? 'NE'}). Open for all artisanal fishing craft across Taytay Bay and regular Tuluran Strait crossings.`,
  },
} as const

const active = SEVERITY_CONFIG[severity]
---

<div
  class={`realtime-safety-banner banner--${severity}`}
  id="realtime-safety-banner"
  role={severity === 'safe' ? 'status' : 'alert'}
  aria-live={severity === 'danger' ? 'assertive' : 'polite'}
>
  <div class="banner__topbar">
    <div class="banner__status-cluster">
      <span class="severity-badge">
        <Icon name={active.icon as any} size={15} />
        <strong>{fil ? active.badgeFil : active.badgeEn}</strong>
      </span>
      <span class="chip chip--muted">
        <Icon name="compass" size={13} />
        <span>{monsoon}</span>
      </span>
    </div>

    <div class="banner__timestamp figure">
      <span class="timestamp-dot" aria-hidden="true"></span>
      <span>Telemetry: {updatedAt}</span>
    </div>
  </div>

  <div class="banner__body">
    <h2 class="banner__headline">
      {fil ? active.headlineFil : active.headlineEn}
    </h2>
    <p class="banner__subtext">
      {fil ? active.subtextFil : active.subtextEn}
    </p>
  </div>

  <div class="banner__metrics">
    <div class="banner-metric">
      <span class="metric-icon-wrap" aria-hidden="true">
        <Icon name="wave-moderate" size={18} />
      </span>
      <div class="metric-text">
        <span class="metric-label">{fil ? 'Taas ng Alon' : 'Wave Swell'}</span>
        <strong class="figure">{waveHeight} m</strong>
      </div>
    </div>

    <div class="banner-metric">
      <span class="metric-icon-wrap" aria-hidden="true">
        <Icon name="wind" size={18} />
      </span>
      <div class="metric-text">
        <span class="metric-label">{fil ? 'Lakas ng Hangin' : 'Wind Speed'}</span>
        <strong class="figure">{windSpeed} km/h ({cur?.windCardinal ?? 'NE'})</strong>
      </div>
    </div>

    <div class="banner-metric">
      <span class="metric-icon-wrap" aria-hidden="true">
        <Icon name="wind" size={18} />
      </span>
      <div class="metric-text">
        <span class="metric-label">{fil ? 'Bugso ng Hangin' : 'Wind Gusts'}</span>
        <strong class="figure">{windGusts} km/h</strong>
      </div>
    </div>

    <div class="banner-metric banner-metric--hotline">
      <span class="metric-icon-wrap metric-icon-wrap--emergency" aria-hidden="true">
        <Icon name="phone" size={18} />
      </span>
      <div class="metric-text">
        <span class="metric-label">{fil ? 'Coast Guard Taytay' : 'PCG Taytay Hotline'}</span>
        <a href="tel:09178427653" class="banner-hotline-link figure">0917-842-7653</a>
      </div>
    </div>
  </div>

  <div class="banner__quicklinks">
    <a href="#fishing-forecast-trends" class="btn btn--secondary btn--sm" data-plain>
      <Icon name="bar-chart" size={14} />
      <span>{fil ? '5-Araw na Forecast' : '5-Day Trends'}</span>
    </a>
    <a href="#emergency-directory" class="btn btn--secondary btn--sm" data-plain>
      <Icon name="phone" size={14} />
      <span>{fil ? 'Emergency Directory' : 'Emergency Directory'}</span>
    </a>
    <a href="#fisherman-safety-section" class="btn btn--secondary btn--sm" data-plain>
      <Icon name="checklist" size={14} />
      <span>{fil ? 'Bantay-Laot Checklist' : 'Pre-Departure Checklist'}</span>
    </a>
  </div>
</div>

<style>
  .realtime-safety-banner {
    border-radius: var(--r-card);
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-inline-start-width: 4px;
    margin-bottom: var(--space-5);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: var(--space-4);
  }

  .banner--safe {
    background: var(--status-open-surface);
    border-color: var(--status-open-border);
    border-inline-start-color: var(--status-open);
    color: var(--status-open-ink);
  }

  .banner--caution {
    background: var(--status-caution-surface);
    border-color: var(--status-caution-border);
    border-inline-start-color: var(--status-caution);
    color: var(--status-caution-ink);
  }

  .banner--danger {
    background: var(--alert-emergency-surface);
    border-color: var(--alert-emergency-border);
    border-inline-start-color: var(--alert-emergency);
    color: var(--alert-emergency-on-surface);
  }

  .banner__topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--line);
  }

  .banner__status-cluster {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .severity-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    border: 1px solid currentColor;
    color: currentColor;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .banner__timestamp {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .timestamp-dot {
    width: 7px;
    height: 7px;
    border-radius: var(--radius-full);
    background: var(--status-open);
  }

  .banner__body {
    display: grid;
    gap: 6px;
  }

  .banner__headline {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.25;
    color: currentColor;
  }

  .banner__subtext {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: 1.6;
    max-width: 80ch;
  }

  .banner__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(11.5rem, 100%), 1fr));
    gap: var(--space-2);
  }

  .banner-metric {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    padding: var(--space-3);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .metric-icon-wrap {
    color: var(--interactive);
    flex-shrink: 0;
    display: inline-flex;
  }

  .metric-icon-wrap--emergency {
    color: var(--alert-emergency-on-surface);
  }

  .metric-text {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .metric-label {
    font-size: var(--text-2xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-muted);
    font-weight: 700;
  }

  .banner-metric strong {
    font-size: var(--text-sm);
    color: var(--ink-strong);
  }

  .banner-hotline-link {
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--alert-emergency-on-surface);
    text-decoration: underline;
  }

  .banner__quicklinks {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }
</style>
