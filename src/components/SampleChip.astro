---
/**
 * "SAMPLE DATA" — the label that makes populated placeholder content safe to
 * ship.
 *
 * BUILD-PROMPT.md §0.2 forbids inventing barangay facts. The mega panels need
 * to be reviewable populated, so the rule is met the other way: the content is
 * there, and it is MARKED, everywhere it appears, in the reader's language.
 *
 * It is not `aria-hidden`. A sighted reader can see that a column is sample
 * content from the chip; a screen-reader user must get the same warning, and
 * "this is not real" is exactly the kind of thing that must not be decorative.
 * That is why it is a `<span>` with text rather than a coloured dot.
 */
import type { Locale } from '@/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
---

<span class="samplechip" data-sample="true">
  {locale === 'fil' ? 'Halimbawang datos' : 'Sample data'}
</span>

<style is:global>
  .samplechip {
    display: inline-flex;
    align-items: center;
    padding: 1px var(--space-2);
    border-radius: var(--radius-full);
    /* Amber, not green: green in this palette means "confirmed" — it is the
       verified boundary and the current-page rule. Sample content is the
       opposite of confirmed, so it must not borrow that signal. */
    border: 1px solid color-mix(in srgb, var(--palette-bangka-orange) 45%, transparent);
    background: color-mix(in srgb, var(--palette-bangka-yellow) 18%, transparent);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    white-space: nowrap;
  }
</style>
