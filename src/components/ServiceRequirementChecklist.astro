---
/**
 * ServiceRequirementChecklist — Persistent requirements checklist with
 * zero-JS fallback, clear fee/time/contact summary, and Messenger-ready copy.
 */
import Placeholder from './Placeholder.astro'
import Icon from './Icon.astro'
import type { ServiceDetail } from '@/lib/content/services'
import { getDictionary, type Locale } from '@/lib/i18n'
import { isPlaceholder } from '@/lib/content/placeholder'

interface Props {
  service: ServiceDetail
  locale: Locale
}

const { service, locale } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
---

<div class="req-shell">
  <dl class="req-facts card">
    <div class="req-fact-row">
      <dt>{t.services.fee}</dt>
      <dd>
        {isPlaceholder(service.fee) ? <Placeholder value={service.fee} /> : <span class="figure">{service.fee}</span>}
      </dd>
    </div>
    <div class="req-fact-row">
      <dt>{t.services.processingTime}</dt>
      <dd>
        {isPlaceholder(service.processingTime) ? (
          <Placeholder value={service.processingTime} />
        ) : (
          <span class="figure">{service.processingTime}</span>
        )}
      </dd>
    </div>
    <div class="req-fact-row">
      <dt>{t.services.approach}</dt>
      <dd>
        {isPlaceholder(service.responsibleOfficial) ? (
          <Placeholder value={service.responsibleOfficial} />
        ) : (
          service.responsibleOfficial
        )}
      </dd>
    </div>
  </dl>

  <h2 class="req-heading">{t.services.bringThis}</h2>

  <ul id="req-list" class="req-list list-reset">
    {
      service.requirements.map((req) => {
        const label = fil ? req.labelFil : req.labelEn
        return (
          <li class="req-item">
            <input
              type="checkbox"
              id={`req-${req.id}`}
              data-req={req.id}
              data-service={service.slug}
            />
            <label for={`req-${req.id}`} class="req-item__label">
              {isPlaceholder(label) ? <Placeholder value={label} /> : label}
              {req.noteFil && fil && <span class="req-item__note">{req.noteFil}</span>}
            </label>
          </li>
        )
      })
    }
  </ul>

  <div class="req-actions">
    <button type="button" id="copy-list" class="btn btn--secondary">
      <Icon name="copy" size={18} />
      <span>{t.services.copyList}</span>
    </button>
    <button type="button" id="print-list" class="btn btn--ghost no-print">
      <Icon name="print" size={18} />
      <span>{t.services.print}</span>
    </button>
  </div>

  <p id="copy-status" role="status" class="req-status"></p>
</div>

<style>
  .req-shell {
    max-width: var(--measure);
  }

  .req-facts {
    margin: 0;
    padding: var(--space-2) var(--space-4);
  }

  .req-fact-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--line);
    flex-wrap: wrap;
  }

  .req-fact-row:last-child {
    border-bottom: 0;
  }

  .req-fact-row dt {
    color: var(--ink-muted);
    font-size: var(--text-sm);
  }

  .req-fact-row dd {
    margin: 0;
    font-weight: 700;
    color: var(--ink-strong);
    min-width: 0;
  }

  .req-heading {
    margin-top: var(--space-6);
    font-size: var(--text-xl);
    color: var(--ink-strong);
  }

  .req-list {
    margin-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
  }

  .req-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    min-height: 48px;
    padding: var(--space-3) var(--space-4);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
  }

  .req-item__label {
    flex: 1;
    min-width: 0;
    cursor: pointer;
    color: var(--ink-strong);
  }

  .req-item__note {
    display: block;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin-top: 2px;
  }

  .req-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .req-status {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--status-open-ink);
  }
</style>

<script is:inline define:vars={{ slug: service.slug, copiedLabel: t.services.copied, title: fil ? service.nameFil : service.nameEn }}>
  ;(function () {
    var key = 'tumbod:req:' + slug
    var boxes = document.querySelectorAll('input[data-service="' + slug + '"]')
    var saved = {}
    try {
      saved = JSON.parse(localStorage.getItem(key) || '{}')
    } catch (e) {
      saved = {}
    }
    function persist() {
      var state = {}
      boxes.forEach(function (b) {
        state[b.dataset.req] = b.checked
      })
      try {
        localStorage.setItem(key, JSON.stringify(state))
      } catch (e) {}
    }
    boxes.forEach(function (b) {
      if (saved[b.dataset.req]) b.checked = true
      b.addEventListener('change', persist)
    })

    var copyBtn = document.getElementById('copy-list')
    var status = document.getElementById('copy-status')
    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var lines = [title, '']
        document.querySelectorAll('#req-list label').forEach(function (l) {
          lines.push('- ' + l.textContent.trim())
        })
        lines.push('', location.href)
        var text = lines.join('\n')
        function done() {
          if (status) status.textContent = copiedLabel
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, function () {})
        }
      })
    }

    var printBtn = document.getElementById('print-list')
    if (printBtn) {
      printBtn.addEventListener('click', function () {
        window.print()
      })
    }
  })()
</script>
