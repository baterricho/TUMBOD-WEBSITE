---
/**
 * Footer — structured civic sitemap, verified metadata, data provenance,
 * and ODbL chart attribution. All routes verified against src/pages.
 */
import Placeholder from './Placeholder.astro'
import { SITE } from '@/lib/content/site'
import { getDictionary, type Locale } from '@/lib/i18n'
import { isPlaceholder } from '@/lib/content/placeholder'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
const p = fil ? '' : '/en'

const groups = [
  {
    heading: t.nav.services,
    links: [
      { href: `${p}/serbisyo`, label: t.services.title },
      { href: `${p}/porma`, label: t.nav.forms },
      { href: `${p}/kaganapan`, label: t.nav.calendar },
      { href: `${p}/faq`, label: fil ? 'Madalas Itanong' : 'FAQ' },
    ],
  },
  {
    heading: fil ? 'Kaligtasan at Panahon' : 'Safety & Weather',
    links: [
      { href: `${p}/ligtas`, label: t.safety.title },
      { href: `${p}/ligtas/hotline`, label: t.nav.emergencyLabel },
      { href: `${p}/panahon`, label: fil ? 'Panahon at Dagat' : 'Weather & Marine' },
      { href: `${p}/ligtas#evacuation`, label: t.safety.whereToEvacuate },
    ],
  },
  {
    heading: fil ? 'Pamamahala' : 'Governance',
    links: [
      { href: `${p}/tungkol`, label: t.nav.about },
      { href: `${p}/opisyal`, label: t.nav.officials },
      { href: `${p}/transparency`, label: t.nav.transparency },
      { href: `${p}/proyekto`, label: fil ? 'Mga Proyekto' : 'Projects' },
    ],
  },
  {
    heading: fil ? 'Komunidad' : 'Community',
    links: [
      { href: `${p}/balita`, label: t.nav.news },
      { href: `${p}/turismo`, label: fil ? 'Turismo' : 'Tourism' },
      { href: `${p}/negosyo`, label: fil ? 'Mga Negosyo' : 'Businesses' },
      { href: `${p}/kontak`, label: t.nav.contact },
    ],
  },
]
---

<footer class="sitefooter">
  <div class="wrap">
    <nav aria-label={t.footer.sitemap}>
      <div class="sitefooter__grid">
        {
          groups.map((group) => (
            <div class="sitefooter__col">
              <h2 class="sitefooter__heading">{group.heading}</h2>
              <ul class="sitefooter__list list-reset">
                {group.links.map((link) => (
                  <li class="sitefooter__item">
                    <a href={link.href} class="sitefooter__link">{link.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </nav>

    <div class="sitefooter__meta">
      <p class="sitefooter__brand">
        <strong>{SITE.name}</strong> · {SITE.municipality}, {SITE.province} · {SITE.region}
      </p>
      <p>
        {t.footer.address}:{' '}
        {isPlaceholder(SITE.address) ? <Placeholder value={SITE.address} /> : SITE.address}
      </p>
      <p>
        {t.footer.officeHours}:{' '}
        {isPlaceholder(SITE.officeHours) ? <Placeholder value={SITE.officeHours} /> : SITE.officeHours}
      </p>
      <p>{t.footer.dataNote}</p>
      <p>{t.footer.chartAttribution}</p>
      <p class="sitefooter__legal">
        <a href={`${p}/transparency`}>{t.nav.transparency}</a>
        <span aria-hidden="true">·</span>
        <a href={`${p}/offline`}>{fil ? 'Offline na Gabay' : 'Offline Access'}</a>
        <span aria-hidden="true">·</span>
        <a href={`${p}/hanapin`}>{fil ? 'Hanapin' : 'Search'}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .sitefooter {
    margin-top: var(--space-7);
    padding-block: var(--space-7) var(--space-6);
    background-color: var(--surface-sunken);
    border-top: 1px solid var(--line);
  }

  .sitefooter__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(min(11rem, 100%), 1fr));
  }

  .sitefooter__heading {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--ink-muted);
    margin-bottom: var(--space-2);
  }

  .sitefooter__item {
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .sitefooter__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: var(--text-sm);
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .sitefooter__link:hover,
  .sitefooter__link:focus-visible {
    color: var(--interactive);
  }

  .sitefooter__meta {
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line);
    font-size: var(--text-xs);
    color: var(--ink-muted);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    line-height: 1.55;
  }

  .sitefooter__brand {
    color: var(--ink-strong);
    font-size: var(--text-sm);
  }

  .sitefooter__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }
</style>
