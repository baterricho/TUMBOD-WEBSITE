---
/**
 * SiteHeader — Sticky civic masthead with consistent emergency access
 * (WCAG 2.2 §3.2.6), progressive-enhancement mega panels, accessible mobile
 * drawer (when JS active; full CSS nav fallback when JS disabled), and theme
 * switcher.
 */
import Icon from './Icon.astro'
import MegaMenu from './MegaMenu.astro'
import MegaToday from './mega/MegaToday.astro'
import MegaServices from './mega/MegaServices.astro'
import MegaNews from './mega/MegaNews.astro'
import MegaSafety from './mega/MegaSafety.astro'
import MegaContact from './mega/MegaContact.astro'
import { getDictionary, alternateHref, type Locale, prefix } from '@/lib/i18n'

interface Props {
  locale: Locale
  pathname: string
}

const { locale, pathname } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
const other: Locale = fil ? 'en' : 'fil'
const p = prefix(locale)
const homeHref = fil ? '/' : '/en'

const isInSection = (root: string) =>
  pathname === `${p}${root}` || pathname.startsWith(`${p}${root}/`)

const isHome = pathname === homeHref
const isCurrent = (href: string) => pathname === href

const groups = [
  {
    heading: fil ? 'Ang Barangay' : 'The Barangay',
    items: [
      { href: `${p}/tungkol`, label: fil ? 'Tungkol' : 'About' },
      { href: `${p}/kasaysayan`, label: fil ? 'Kasaysayan' : 'History' },
      { href: `${p}/bisyon`, label: fil ? 'Bisyon at Misyon' : 'Vision and Mission' },
      { href: `${p}/opisyal`, label: t.nav.officials },
    ],
  },
  {
    heading: fil ? 'Pamamahala' : 'Governance',
    items: [
      { href: `${p}/transparency`, label: t.nav.transparency },
      { href: `${p}/proyekto`, label: fil ? 'Mga Proyekto' : 'Projects' },
      { href: `${p}/porma`, label: t.nav.forms },
      { href: `${p}/faq`, label: fil ? 'Madalas Itanong' : 'FAQ' },
    ],
  },
  {
    heading: fil ? 'Komunidad' : 'Community',
    items: [
      { href: `${p}/panahon`, label: fil ? 'Panahon at Dagat' : 'Weather & Marine' },
      { href: `${p}/turismo`, label: fil ? 'Turismo' : 'Tourism' },
      { href: `${p}/negosyo`, label: fil ? 'Mga Negosyo' : 'Businesses' },
      { href: `${p}/larawan`, label: fil ? 'Mga Larawan' : 'Gallery' },
      { href: `${p}/hanapin`, label: fil ? 'Hanapin' : 'Search' },
    ],
  },
]
---

<header class="siteheader">
  <div class="siteheader__bar">
    <a class="brand" href={homeHref} data-plain>
      <span class="brand__seal" aria-hidden="true">BT</span>
      <span class="brand__text">
        <span class="brand__name">{t.meta.siteName}</span>
        <span class="brand__place">{t.meta.municipality}</span>
      </span>
    </a>

    <div class="siteheader__actions">
      <p class="siteclock" id="siteclock" hidden>
        <time class="siteclock__time" id="siteclock-time"></time>
        <span class="siteclock__date" id="siteclock-date"></span>
      </p>

      <button
        type="button"
        id="theme-toggle-btn"
        class="theme-toggle-btn"
        aria-label={fil ? 'Palitan ang tema (liwanag o madilim)' : 'Toggle light or dark theme'}
        aria-pressed="false"
        title={fil ? 'Palitan ang Tema' : 'Toggle Theme'}
      >
        <span class="theme-icon-sun" aria-hidden="true"><Icon name="sun" size={18} /></span>
        <span class="theme-icon-moon" aria-hidden="true"><Icon name="moon" size={18} /></span>
      </button>

      {/* Plain anchor — works with zero JS; accessible name matches exact label ('English' / 'Filipino') */}
      <a
        href={alternateHref(pathname, other)}
        hreflang={other === 'fil' ? 'fil' : 'en'}
        lang={other === 'fil' ? 'fil' : 'en'}
        class="siteheader__lang"
        data-plain
      >{other === 'fil' ? 'Filipino' : 'English'}</a>

      {/* Always-present emergency hotline link in header banner */}
      <a
        href={`${p}/ligtas/hotline`}
        class="siteheader__emergency"
        title={t.nav.emergency}
        data-plain
      >
        <Icon name="phone" size={16} />
        <span class="siteheader__emergency-text">{t.nav.emergency}</span>
      </a>

      {/* Progressive-enhancement mobile drawer trigger (visible only when JS is enabled <=768px) */}
      <button
        type="button"
        class="mobile-menu-btn"
        id="mobile-nav-toggle"
        aria-label={fil ? 'Buksan ang menu' : 'Open navigation menu'}
        aria-expanded="false"
        aria-controls="mobile-nav-overlay"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>

  <nav aria-label={t.nav.menu} class="siteheader__nav">
    <div class="siteheader__navbar">
      <ul class="mainnav" role="list">
        <li>
          <MegaMenu
            id="today"
            label={t.nav.home}
            icon="calendar"
            current={isHome}
            panelLabel={t.nav.home}
          >
            <MegaToday locale={locale} />
          </MegaMenu>
        </li>

        <li>
          <MegaMenu
            id="services"
            label={t.nav.services}
            icon="document"
            current={isInSection('/serbisyo')}
            panelLabel={t.nav.services}
          >
            <MegaServices locale={locale} />
          </MegaMenu>
        </li>

        <li>
          <MegaMenu
            id="news"
            label={t.nav.news}
            icon="megaphone"
            current={isInSection('/balita')}
            panelLabel={t.nav.news}
          >
            <MegaNews locale={locale} />
          </MegaMenu>
        </li>

        <li>
          <MegaMenu
            id="safety"
            label={t.nav.safety}
            icon="shield"
            current={isInSection('/ligtas')}
            panelLabel={t.nav.safety}
          >
            <MegaSafety locale={locale} />
          </MegaMenu>
        </li>

        <li>
          <MegaMenu
            id="contact"
            label={t.nav.contact}
            icon="mail"
            current={isInSection('/kontak')}
            panelLabel={t.nav.contact}
          >
            <MegaContact locale={locale} />
          </MegaMenu>
        </li>
      </ul>

      <details class="navmore" data-mega>
        <summary class="navmore__summary">
          {t.nav.more}
          <span aria-hidden="true">▾</span>
        </summary>
        <div class="navmore__panel">
          {
            groups.map((g) => (
              <div>
                <p class="navmore__heading">{g.heading}</p>
                <ul class="list-reset">
                  {g.items.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isCurrent(item.href) ? 'page' : undefined}
                        class="navmore__link"
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </details>
    </div>
  </nav>

  {/* Accessible Mobile Menu Drawer */}
  <div
    id="mobile-nav-overlay"
    class="mobile-nav-overlay"
    role="dialog"
    aria-modal="true"
    aria-label={fil ? 'Nabigasyon ng Barangay Tumbod' : 'Barangay Tumbod Navigation'}
    hidden
  >
    <div class="mobile-nav-sheet">
      <div class="mobile-nav-sheet__top">
        <div class="brand">
          <span class="brand__seal" aria-hidden="true">BT</span>
          <span class="brand__text">
            <span class="brand__name">{t.meta.siteName}</span>
            <span class="brand__place">{t.meta.municipality}</span>
          </span>
        </div>
        <button
          type="button"
          class="mobile-nav-close"
          id="mobile-nav-close"
          aria-label={fil ? 'Isara ang menu' : 'Close menu'}
        >
          <Icon name="close" size={20} />
        </button>
      </div>

      <form action={`${p}/hanapin`} method="get" class="mobile-nav-search" role="search">
        <label for="mobile-drawer-search" class="sr-only">
          {fil ? 'Maghanap sa buong site' : 'Search the site'}
        </label>
        <span class="mobile-nav-search__icon" aria-hidden="true"><Icon name="search" size={18} /></span>
        <input
          id="mobile-drawer-search"
          type="search"
          name="q"
          placeholder={fil ? 'Maghanap ng serbisyo, balita...' : 'Search services, news...'}
          class="mobile-nav-search__input"
        />
        <button type="submit" class="mobile-nav-search__btn" aria-label={fil ? 'Maghanap' : 'Search'}>
          <Icon name="chevron-right" size={18} />
        </button>
      </form>

      <div class="mobile-nav-scroll">
        <div class="mobile-nav-section">
          <p class="mobile-nav-section__title">{fil ? 'Pangunahing Destinasyon' : 'Primary Destinations'}</p>
          <div class="mobile-nav-grid">
            <a
              href={homeHref}
              class={`mobile-nav-card ${isHome ? 'mobile-nav-card--active' : ''}`}
              aria-current={isHome ? 'page' : undefined}
              data-plain
            >
              <Icon name="home" size={18} />
              <span>{t.nav.home}</span>
            </a>
            <a
              href={`${p}/panahon`}
              class={`mobile-nav-card ${pathname.startsWith(`${p}/panahon`) ? 'mobile-nav-card--active' : ''}`}
              aria-current={pathname.startsWith(`${p}/panahon`) ? 'page' : undefined}
              data-plain
            >
              <Icon name="wind" size={18} />
              <span>{fil ? 'Panahon at Dagat' : 'Weather & Sea'}</span>
            </a>
            <a
              href={`${p}/serbisyo`}
              class={`mobile-nav-card ${isInSection('/serbisyo') ? 'mobile-nav-card--active' : ''}`}
              aria-current={isInSection('/serbisyo') ? 'page' : undefined}
              data-plain
            >
              <Icon name="document" size={18} />
              <span>{t.nav.services}</span>
            </a>
            <a
              href={`${p}/ligtas`}
              class={`mobile-nav-card ${isInSection('/ligtas') ? 'mobile-nav-card--active' : ''}`}
              aria-current={isInSection('/ligtas') ? 'page' : undefined}
              data-plain
            >
              <Icon name="shield" size={18} />
              <span>{t.nav.safety}</span>
            </a>
            <a
              href={`${p}/balita`}
              class={`mobile-nav-card ${isInSection('/balita') ? 'mobile-nav-card--active' : ''}`}
              aria-current={isInSection('/balita') ? 'page' : undefined}
              data-plain
            >
              <Icon name="megaphone" size={18} />
              <span>{t.nav.news}</span>
            </a>
            <a
              href={`${p}/kontak`}
              class={`mobile-nav-card ${isInSection('/kontak') ? 'mobile-nav-card--active' : ''}`}
              aria-current={isInSection('/kontak') ? 'page' : undefined}
              data-plain
            >
              <Icon name="mail" size={18} />
              <span>{t.nav.contact}</span>
            </a>
          </div>
        </div>

        {groups.map((g) => (
          <details class="mobile-nav-accord" open={g.items.some((item) => isCurrent(item.href))}>
            <summary class="mobile-nav-accord__summary">
              <span>{g.heading}</span>
              <span class="mobile-nav-accord__arrow" aria-hidden="true">▾</span>
            </summary>
            <ul class="mobile-nav-accord__list list-reset">
              {g.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isCurrent(item.href) ? 'page' : undefined}
                    class="mobile-nav-accord__link"
                    data-plain
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      {/* Links to verified 24/7 offline hotline directory — never hardcodes unverified numbers */}
      <div class="mobile-nav-sheet__foot">
        <a href={`${p}/ligtas/hotline`} class="btn btn--danger btn--block" data-plain>
          <Icon name="phone" size={18} />
          <span>{fil ? 'Mga Numerong Pang-Emergency (24/7)' : '24/7 Emergency Hotlines'}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  ;(function () {
    var menus = [].slice.call(document.querySelectorAll('[data-mega]'))
    if (!menus.length) return

    var header = document.querySelector('.siteheader')

    var measure = function () {
      if (!header) return
      var h = Math.max(56, Math.round(header.getBoundingClientRect().bottom))
      document.documentElement.style.setProperty('--header-h', h + 'px')
    }
    measure()
    window.addEventListener('resize', measure)

    var overlays = menus.filter(function (m) {
      return !!m.querySelector('.mega__panel')
    })

    var lock = function () {
      var open = overlays.some(function (m) {
        return m.open
      })
      document.documentElement.style.overflow = open ? 'hidden' : ''
    }

    var closeAll = function (except) {
      menus.forEach(function (m) {
        if (m !== except) m.removeAttribute('open')
      })
    }

    menus.forEach(function (m) {
      var summary = m.querySelector('summary')

      m.addEventListener('toggle', function () {
        if (m.open) {
          measure()
          closeAll(m)
        }
        lock()
      })

      m.addEventListener('keydown', function (ev) {
        if (ev.key !== 'Escape' || !m.open) return
        ev.stopPropagation()
        m.removeAttribute('open')
        lock()
        if (summary) summary.focus()
      })

      m.addEventListener('focusout', function (ev) {
        if (!m.open || !ev.relatedTarget) return
        if (!m.contains(ev.relatedTarget)) {
          m.removeAttribute('open')
          lock()
        }
      })
    })

    document.addEventListener('click', function (ev) {
      var inside = menus.some(function (m) {
        return m.contains(ev.target)
      })
      if (!inside) {
        closeAll(null)
        lock()
      }
    })
  })()
</script>

<script is:inline define:vars={{ fil: locale === 'fil' }}>
  ;(function () {
    var box = document.getElementById('siteclock')
    var tEl = document.getElementById('siteclock-time')
    var dEl = document.getElementById('siteclock-date')
    if (box && tEl && dEl) {
      var loc = fil ? 'fil-PH' : 'en-PH'
      var TZ = 'Asia/Manila'
      try {
        var timeFmt = new Intl.DateTimeFormat(loc, {
          timeZone: TZ,
          hour: 'numeric',
          minute: '2-digit',
        })
        var dateFmt = new Intl.DateTimeFormat(loc, {
          timeZone: TZ,
          weekday: 'short',
          day: 'numeric',
          month: 'short',
        })
        var tick = function () {
          var now = new Date()
          tEl.textContent = timeFmt.format(now)
          tEl.setAttribute('datetime', now.toISOString())
          dEl.textContent = dateFmt.format(now)
        }
        tick()
        box.hidden = false
        var timer = setInterval(tick, 10000)
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'visible') {
            tick()
            if (!timer) timer = setInterval(tick, 10000)
          } else {
            clearInterval(timer)
            timer = null
          }
        })
      } catch (e) {}
    }

    var toggle = document.getElementById('mobile-nav-toggle')
    var closeBtn = document.getElementById('mobile-nav-close')
    var overlay = document.getElementById('mobile-nav-overlay')

    function getFocusable() {
      if (!overlay) return []
      return [].slice.call(
        overlay.querySelectorAll('a[href], button:not([disabled]), input:not([disabled]), summary'),
      )
    }

    function openNav() {
      if (!overlay) return
      overlay.hidden = false
      if (toggle) toggle.setAttribute('aria-expanded', 'true')
      document.documentElement.style.overflow = 'hidden'
      if (closeBtn) closeBtn.focus()
    }

    function closeNav(restoreFocus) {
      if (!overlay) return
      overlay.hidden = true
      if (toggle) toggle.setAttribute('aria-expanded', 'false')
      document.documentElement.style.overflow = ''
      if (restoreFocus && toggle) toggle.focus()
    }

    if (toggle) {
      toggle.addEventListener('click', function (e) {
        e.stopPropagation()
        if (overlay && overlay.hidden) openNav()
        else closeNav(true)
      })
    }

    if (closeBtn) {
      closeBtn.addEventListener('click', function (e) {
        e.stopPropagation()
        closeNav(true)
      })
    }

    if (overlay) {
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) {
          closeNav(true)
          return
        }
        var link = e.target && e.target.closest ? e.target.closest('a[href]') : null
        if (link) closeNav(false)
      })

      overlay.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
          e.stopPropagation()
          closeNav(true)
          return
        }
        if (e.key !== 'Tab') return
        var list = getFocusable()
        if (!list.length) return
        var first = list[0]
        var last = list[list.length - 1]
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault()
          last.focus()
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault()
          first.focus()
        }
      })
    }

    var themeBtn = document.getElementById('theme-toggle-btn')
    if (themeBtn) {
      var syncThemeAria = function () {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark'
        themeBtn.setAttribute('aria-pressed', isDark ? 'true' : 'false')
        var meta = document.getElementById('meta-theme-color')
        if (meta) meta.setAttribute('content', isDark ? '#111827' : '#ffffff')
      }
      syncThemeAria()
      themeBtn.addEventListener('click', function () {
        var isDark = document.documentElement.getAttribute('data-theme') === 'dark'
        var next = isDark ? 'light' : 'dark'
        if (next === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark')
        } else {
          document.documentElement.removeAttribute('data-theme')
        }
        syncThemeAria()
        try {
          localStorage.setItem('tumbod:theme', next)
        } catch (e) {}
      })
    }
  })()
</script>

<style>
  .siteheader__actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .theme-toggle-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    background: var(--surface-sunken);
    color: var(--ink-strong);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .theme-toggle-btn:hover {
    background: var(--surface-raised);
    border-color: var(--line-strong);
    color: var(--interactive);
  }

  .theme-icon-sun { display: none; }
  .theme-icon-moon { display: inline-flex; }

  :global(html[data-theme="dark"]) .theme-icon-sun { display: inline-flex; }
  :global(html[data-theme="dark"]) .theme-icon-moon { display: none; }

  .siteheader__lang {
    font-size: var(--text-xs);
    font-weight: 700;
    min-height: 44px;
    min-width: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 10px;
    border-radius: var(--r-inner);
    color: var(--ink-strong);
    text-decoration: none;
    border: 1px solid var(--line);
    background: var(--surface-raised);
    white-space: nowrap;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .siteheader__lang:visited {
    color: var(--ink-strong);
  }

  .siteheader__lang:hover {
    background: var(--surface-sunken);
    border-color: var(--line-strong);
    color: var(--interactive);
  }

  .siteheader__emergency {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-height: 44px;
    min-width: 44px;
    padding-inline: var(--space-3);
    background-color: var(--alert-emergency);
    color: var(--alert-emergency-ink);
    border-radius: var(--r-inner);
    font-family: var(--font-display);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: var(--text-xs);
    text-decoration: none;
    font-weight: 700;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .siteheader__emergency:visited {
    color: var(--alert-emergency-ink);
  }

  .siteheader__emergency:hover,
  .siteheader__emergency:focus-visible {
    background-color: var(--alert-emergency-hover);
    color: var(--alert-emergency-ink);
  }

  .navmore__summary {
    display: flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: var(--space-2);
    white-space: nowrap;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--ink);
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-sm);
  }

  .navmore__summary:hover {
    color: var(--ink-strong);
  }

  .mobile-menu-btn {
    display: none;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink-strong);
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  .mobile-menu-btn:hover {
    background: var(--surface-sunken);
    border-color: var(--line-strong);
  }

  /* Accessible Mobile Drawer */
  .mobile-nav-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgb(2 6 23 / 0.65);
    display: flex;
    justify-content: flex-end;
  }

  .mobile-nav-sheet {
    width: min(360px, 100vw);
    height: 100%;
    background: var(--surface);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--line);
    box-shadow: var(--shadow-lg);
    animation: slide-in var(--motion-base) var(--ease-standard) forwards;
  }

  @keyframes slide-in {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
  }

  .mobile-nav-sheet__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--line);
    background: var(--surface-raised);
  }

  .mobile-nav-close {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    background: var(--surface-sunken);
    color: var(--ink-strong);
    cursor: pointer;
  }

  .mobile-nav-close:hover {
    border-color: var(--line-strong);
  }

  .mobile-nav-search {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: var(--space-3) var(--space-4);
    padding: 0 4px 0 12px;
    background: var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-inner);
