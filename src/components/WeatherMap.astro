---
/**
 * WeatherMap.astro
 *
 * Interactive Wind & Geospatial Route Map for Barangay Tumbod & Palawan:
 *   1. Windy Live Radar (default when online): live ECMWF/GFS radar
 *      centered on Tuluran Island (10.9856 N, 119.2773 E) with 6 live layers;
 *   2. Satellite & Palawan Route Map (Leaflet + Esri World Imagery +
 *      OpenStreetMap): renders verified sea water routes (Endeavor Strait &
 *      Malampaya Sound) + real OSM-derived Palawan highway routes from
 *      Liminangcong Port, synchronized live with InteractiveCrossingPlanner.
 */
import Icon from './Icon.astro'
import type { Locale } from '@/lib/i18n'
import { TUMBOD_COORDS } from '@/lib/weather'
import {
  LOCATIONS,
  SEA_ROUTES,
  MAINLAND_ROUTES,
  composeSeaJourney,
} from '@/lib/content/palawan-routes'

interface Props {
  locale: Locale
  defaultMode?: 'windy' | 'satellite'
  initialWindSpeed?: number
  initialWindDir?: number
  initialWaveHeight?: number
}

const {
  locale,
  defaultMode = 'windy',
  initialWindSpeed = 14,
  initialWindDir = 65,
  initialWaveHeight = 0.6,
} = Astro.props

const fil = locale === 'fil'
const lat = TUMBOD_COORDS.lat
const lon = TUMBOD_COORDS.lon

const LAYERS = [
  { id: 'wind', labelFil: 'Hangin', labelEn: 'Wind', icon: 'wind' },
  { id: 'waves', labelFil: 'Alon', labelEn: 'Waves', icon: 'bangka' },
  { id: 'rain', labelFil: 'Ulan', labelEn: 'Rain', icon: 'droplet' },
  { id: 'gust', labelFil: 'Bugso', labelEn: 'Gusts', icon: 'wind' },
  { id: 'temp', labelFil: 'Temperatura', labelEn: 'Temp', icon: 'sun' },
  { id: 'clouds', labelFil: 'Ulap', labelEn: 'Clouds', icon: 'cloud' },
] as const

const defaultSea = composeSeaJourney('tumbod-to-liminangcong')
const windyDirectUrl = `https://www.windy.com/${lat}/${lon}?${lat},${lon},11`
---

<div class="weather-map-wrapper" id="weather-map-section" data-reveal="pending">
  {/* Controls Header */}
  <div class="weather-map__header">
    <div class="weather-map__title-group">
      <div class="weather-map__badge">
        <span class="live-dot" aria-hidden="true"></span>
        <span>{fil ? 'Live Radar at Mapa ng Ruta sa Palawan' : 'Live Weather Radar & Palawan Route Map'}</span>
      </div>
      <h3 class="weather-map__heading">
        {fil ? 'Live Windy Radar at Satelayt ng mga Ruta' : 'Live Windy Radar & Palawan Travel Routes'}
      </h3>
      <p class="weather-map__subtitle">
        {
          fil
            ? 'Live na hangin at alon sa Pulo ng Tuluran, kasama ang mga beripikadong rutang pandagat at kalsada mula Liminangcong Port.'
            : 'Live wind/wave radar around Tuluran Island paired with verified sea channels and Palawan mainland highways via Liminangcong Port.'
        }
      </p>
    </div>

    <div class="weather-map__toolbar">
      <div class="weather-map__mode-tabs" role="tablist" aria-label={fil ? 'Uri ng Mapa' : 'Map Mode'}>
        <button
          type="button"
          class={`map-tab-btn ${defaultMode === 'windy' ? 'map-tab-btn--active' : ''}`}
          id="tab-windy"
          role="tab"
          aria-selected={defaultMode === 'windy' ? 'true' : 'false'}
          aria-controls="panel-windy"
        >
          <Icon name="wind" size={14} />
          <span>Windy Live Radar</span>
        </button>
        <button
          type="button"
          class={`map-tab-btn ${defaultMode === 'satellite' ? 'map-tab-btn--active' : ''}`}
          id="tab-satellite"
          role="tab"
          aria-selected={defaultMode === 'satellite' ? 'true' : 'false'}
          aria-controls="panel-satellite"
        >
          <Icon name="compass" size={14} />
          <span>{fil ? 'Mapa ng Ruta (Satelayt)' : 'Satellite Route Map'}</span>
        </button>
      </div>

      <button
        type="button"
        class="btn btn--secondary btn--sm"
        id="map-fullscreen-toggle"
        aria-pressed="false"
        title={fil ? 'Palakihin ang mapa' : 'Toggle fullscreen'}
      >
        <Icon name="maximize" size={15} />
        <span>{fil ? 'Palakihin' : 'Fullscreen'}</span>
      </button>
    </div>
  </div>

  {/* Layer Selector Bar (visible when Windy Live Radar tab is active) */}
  <div class="weather-map__layers-bar" id="windy-layers-bar" hidden={defaultMode !== 'windy'}>
    <span class="weather-map__layers-label">{fil ? 'Live Radar Layer:' : 'Live Radar Layer:'}</span>
    <div class="weather-map__layer-pills" role="group" aria-label={fil ? 'Mga patong ng radar' : 'Radar layers'}>
      {LAYERS.map((layer, idx) => (
        <button
          type="button"
          class={`layer-pill ${idx === 0 ? 'layer-pill--active' : ''}`}
          data-layer={layer.id}
          aria-pressed={idx === 0 ? 'true' : 'false'}
        >
          <Icon name={layer.icon as any} size={14} />
          <span>{fil ? layer.labelFil : layer.labelEn}</span>
        </button>
      ))}
    </div>
  </div>

  {/* Compact Route Bar (visible when Satellite Route Map tab is active — zero pill clutter) */}
  <div class="weather-map__layers-bar weather-map__route-bar" id="satellite-route-bar" hidden={defaultMode !== 'satellite'}>
    <label for="map-quick-route" class="weather-map__layers-label">
      {fil ? 'Ipakita ang Ruta:' : 'Highlight Route:'}
    </label>
    <select id="map-quick-route" class="map-route-select">
      <optgroup label={fil ? 'Biyaheng Bangka (Dagat Lamang)' : 'Island Boat Trips (Sea Only)'}>
        {SEA_ROUTES.map((r) => (
          <option value={`sea:${r.id}`}>
            {LOCATIONS[r.fromId]?.[fil ? 'nameFil' : 'nameEn'].replace(' (Tuluran Island)', '').replace(' (Coastal Gateway)', '')} →{' '}
            {LOCATIONS[r.toId]?.[fil ? 'nameFil' : 'nameEn'].replace(' (Coastal Gateway)', '').replace(' (Malampaya Sound)', '')} ({r.distanceKm} km)
          </option>
        ))}
      </optgroup>
      <optgroup label={fil ? 'Mula Tumbod → Mainland Palawan (Bangka + Kalsada)' : 'Tumbod → Mainland Palawan (Boat + Road)'}>
        {MAINLAND_ROUTES.map((r) => (
          <option value={`multi:${r.toId}`}>
            Tumbod → Liminangcong → {LOCATIONS[r.toId]?.[fil ? 'nameFil' : 'nameEn']} ({(0.7 + r.highwayKm).toFixed(1)} km)
          </option>
        ))}
      </optgroup>
    </select>

    <div class="map-legend" aria-label={fil ? 'Gabay sa kulay' : 'Map legend'}>
      <span class="map-legend__item">
        <span class="map-legend__swatch map-legend__swatch--sea" aria-hidden="true"></span>
        <span>{fil ? 'Dagat (Bangka)' : 'Sea (Boat)'}</span>
      </span>
      <span class="map-legend__item">
        <span class="map-legend__swatch map-legend__swatch--road" aria-hidden="true"></span>
        <span>{fil ? 'Kalsada (Van/Bus/Motor)' : 'Highway (Van/Motor)'}</span>
      </span>
    </div>
  </div>

  {/* Map Viewport Stage */}
  <div class="weather-map__stage" id="weather-map-stage">
    {/* Panel 1: Live Windy.com Radar */}
    <div
      class={`weather-map__panel ${defaultMode === 'windy' ? 'weather-map__panel--active' : ''}`}
      id="panel-windy"
      role="tabpanel"
      aria-labelledby="tab-windy"
      hidden={defaultMode !== 'windy'}
    >
      <div id="windy-placeholder" class="windy-placeholder" hidden={defaultMode === 'windy'}>
        <p class="windy-placeholder__desc" id="windy-placeholder-desc">
          {fil
            ? 'Buksan ang live radar ng Windy.com para sa Tuluran Island at Taytay Bay.'
            : 'Open the live interactive Windy.com radar map for Tuluran Island and Taytay Bay.'}
        </p>
        <div class="windy-placeholder__actions">
          <button type="button" id="btn-load-windy" class="btn btn--primary">
            <Icon name="wind" size={16} />
            <span>{fil ? 'Buksan ang Windy Live Radar' : 'Load Windy Live Radar'}</span>
          </button>
          <a
            href={windyDirectUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn btn--ghost-inverse btn--sm"
          >
            <span>{fil ? 'Buksan sa Windy.com' : 'Open on Windy.com'}</span>
            <Icon name="external" size={14} />
          </a>
        </div>
      </div>

      <div id="windy-loading" class="windy-loading" role="status" aria-live="polite" hidden={defaultMode !== 'windy'}>
        <span class="windy-spinner" aria-hidden="true"></span>
        <span>{fil ? 'Ikinakarga ang live Windy radar ng Tuluran Island...' : 'Loading live Windy radar for Tuluran Island...'}</span>
      </div>

      <iframe
        id="windy-iframe"
        title={fil ? 'Windy Live Interactive Weather Radar para sa Tuluran Island' : 'Windy Live Interactive Weather Radar for Tuluran Island'}
        data-src={`https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=default&metricTemp=default&metricWind=default&zoom=11&overlay=wind&product=ecmwf&level=surface&lat=${lat}&lon=${lon}&detailLat=${lat}&detailLon=${lon}&marker=true&pressure=true&message=true`}
        class="windy-frame"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allow="fullscreen"
        allowfullscreen
        hidden
      ></iframe>

      <div class="windy-attribution">
        <span>
          {fil
            ? 'Live ECMWF / GFS · Windy.com · Pulo ng Tuluran'
            : 'Live ECMWF / GFS · Windy.com · Tuluran Island'}
        </span>
        <a
          href={windyDirectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="windy-attribution__link"
        >
          Windy.com ↗
        </a>
      </div>
    </div>

    {/* Panel 2: Satellite Route Map (Synced Sea Channels + Mainland Palawan Highways) */}
    <div
      class={`weather-map__panel ${defaultMode === 'satellite' ? 'weather-map__panel--active' : ''}`}
      id="panel-satellite"
      role="tabpanel"
      aria-labelledby="tab-satellite"
      hidden={defaultMode !== 'satellite'}
    >
      <div class="satellite-map-container" id="satellite-container">
        <div
          id="tumbod-leaflet-map"
          class="leaflet-stage"
          role="application"
          aria-label={fil ? 'Satelayt na mapa ng mga ruta sa Dagat at Mainland Palawan' : 'Satellite map of Palawan sea and road travel routes'}
        ></div>

        <canvas
          id="satellite-wind-overlay"
          class="wind-overlay-canvas"
          aria-hidden="true"
        ></canvas>

        <div id="satellite-status" class="windy-loading" role="status" aria-live="polite" hidden>
          <span class="windy-spinner" aria-hidden="true"></span>
          <span>{fil ? 'Ikinakarga ang satelayt na mapa...' : 'Loading satellite map...'}</span>
        </div>

        {/* Minimal Unobtrusive Active Route HUD Card */}
        <div class="marine-waypoint-card" id="marine-waypoint-info" aria-live="polite">
          <div class="marine-waypoint-card__head">
            <span class="marine-waypoint-card__title" id="map-hud-title">
              {fil ? 'Tumbod → Liminangcong Port' : 'Tumbod → Liminangcong Port'}
            </span>
            <span class="marine-waypoint-card__badge" id="map-hud-badge">
              {fil ? 'Bangka Lamang' : 'Boat Only'}
            </span>
          </div>
          <p class="marine-waypoint-card__desc" id="map-hud-desc">
            {fil
              ? 'Direktang tawid sa Endeavor Strait patungong Liminangcong Port.'
              : 'Direct boat crossing across Endeavor Strait to Liminangcong Port.'}
          </p>
          <div class="marine-waypoint-stats">
            <div class="waypoint-stat">
              <span class="waypoint-stat__label">{fil ? 'Dagat' : 'Sea'}</span>
              <strong class="waypoint-stat__val figure" id="map-hud-sea">{defaultSea.seaDistanceKm} km</strong>
            </div>
            <div class="waypoint-stat">
              <span class="waypoint-stat__label">{fil ? 'Kalsada' : 'Road'}</span>
              <strong class="waypoint-stat__val figure" id="map-hud-road">0 km</strong>
            </div>
            <div class="waypoint-stat">
              <span class="waypoint-stat__label">{fil ? 'Dagat Ngayon' : 'Wind / Wave'}</span>
              <strong class="waypoint-stat__val figure" id="map-hud-weather">{initialWindSpeed} km/h · {initialWaveHeight} m</strong>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Reading Guide */}
  <div class="weather-map__guide">
    <div class="guide-item">
      <div class="guide-item__icon" aria-hidden="true">
        <Icon name="bangka" size={18} />
      </div>
      <div>
        <strong class="guide-item__title">{fil ? 'Liminangcong Port: Coastal Gateway' : 'Liminangcong Port: Coastal Gateway'}</strong>
        <p class="guide-item__desc">
          {fil
            ? 'Ang Liminangcong Port ay daungan ng bangka sa baybayin — hiwalay mula sa Taytay Poblacion (~54 km ang layo sa kalsada).'
            : 'Liminangcong Port is the coastal boat landing linking Tuluran Island to Taytay (~54.4 km south by road) and the Palawan highway network.'}
        </p>
      </div>
    </div>

    <div class="guide-item">
      <div class="guide-item__icon" aria-hidden="true">
        <Icon name="shield" size={18} />
      </div>
      <div>
        <strong class="guide-item__title">{fil ? 'Bangka sa Dagat · Van/Motor sa Kalsada' : 'Sea vs. Mainland Transport Rules'}</strong>
        <p class="guide-item__desc">
          {fil
            ? 'Pawang bangka lamang sa Cataban, San Jose Island, at Calapa; van, bus, o motorsiklo naman pagkatapos dumaong sa Liminangcong.'
            : 'Island settlements are served exclusively by boat; mainland municipalities (Taytay, Puerto Princesa, Quezon, Rizal, El Nido) use road vehicles from Liminangcong.'}
        </p>
      </div>
    </div>
  </div>
</div>

<style>
  .weather-map-wrapper {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--space-5);
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    margin-block: var(--space-4);
    display: grid;
    gap: var(--space-4);
  }

  .weather-map__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .weather-map__title-group {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .weather-map__badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--interactive);
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--status-open);
    box-shadow: 0 0 0 3px var(--status-open-surface);
    flex-shrink: 0;
  }

  .weather-map__heading {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--ink-strong);
  }

  .weather-map__subtitle {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: 62ch;
  }

  .weather-map__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .weather-map__mode-tabs {
    display: inline-flex;
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    padding: 3px;
    gap: 2px;
  }

  .map-tab-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 6px 12px;
    border-radius: var(--radius-sm);
    border: 0;
    background: transparent;
    color: var(--ink-muted);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .map-tab-btn:hover {
    color: var(--ink-strong);
  }

  .map-tab-btn--active {
    background: var(--surface-raised);
    color: var(--ink-strong);
    box-shadow: var(--shadow-sm);
  }

  /* Bars */
  .weather-map__layers-bar {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-sunken);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
  }

  .weather-map__layers-bar[hidden] {
    display: none;
  }

  .weather-map__layers-label {
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--ink-muted);
  }

  .weather-map__layer-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .layer-pill {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    min-height: 34px;
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .layer-pill:hover {
    border-color: var(--interactive);
    color: var(--interactive);
  }

  .layer-pill--active {
    background: var(--action);
    border-color: var(--action);
    color: var(--action-ink);
  }

  .layer-pill--active:hover {
    color: var(--action-ink);
  }

  .map-route-select {
    min-height: 38px;
    padding: 4px 10px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--surface-raised);
    color: var(--ink-strong);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    max-width: min(26rem, 100%);
  }

  .map-legend {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
    flex-wrap: wrap;
  }

  .map-legend__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink);
  }

  .map-legend__swatch {
    width: 18px;
    height: 3px;
    border-radius: 2px;
  }

  .map-legend__swatch--sea {
    border-top: 3px dashed #38bdf8;
    height: 0;
  }

  .map-legend__swatch--road {
    background: #f59e0b;
  }

  /* Stage */
  .weather-map__stage {
    position: relative;
    width: 100%;
    height: 520px;
    border-radius: var(--r-card);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    background: #0a1628;
  }

  .weather-map__panel {
    width: 100%;
    height: 100%;
    position: relative;
    display: none;
  }

  .weather-map__panel--active {
    display: block;
  }

  .windy-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    height: 100%;
    padding: var(--space-6);
    background: #0a1628;
    text-align: center;
  }

  .windy-placeholder[hidden] {
    display: none;
  }

  .windy-placeholder__desc {
    color: #cbd5e1;
    font-size: var(--text-sm);
    max-width: 44ch;
    margin: 0;
  }

  .windy-placeholder__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--space-2);
  }

  .windy-loading {
    position: absolute;
    inset: 0;
    z-index: 450;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: rgb(10 22 40 / 0.86);
    color: #f8fafc;
    font-size: var(--text-sm);
    font-weight: 600;
    pointer-events: none;
  }

  .windy-loading[hidden] {
    display: none;
  }

  .windy-spinner {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 2px solid rgb(125 211 252 / 0.3);
    border-top-color: #38bdf8;
    animation: windy-spin 0.8s linear infinite;
  }

  @keyframes windy-spin {
    to { transform: rotate(360deg); }
  }

  .windy-frame {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .windy-attribution {
    position: absolute;
    bottom: 8px;
    left: 10px;
    z-index: 10;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: rgb(10 22 40 / 0.9);
    color: #cbd5e1;
    border: 1px solid rgb(255 255 255 / 0.14);
    padding: 4px 10px;
    border-radius: var(--radius-sm);
    font-size: 11px;
  }

  .windy-attribution__link {
    color: #7dd3fc;
    font-weight: 600;
    text-decoration: none;
  }

  .windy-attribution__link:hover {
    text-decoration: underline;
    color: #ffffff;
  }

  /* Satellite Map */
  .satellite-map-container {
    width: 100%;
    height: 100%;
    position: relative;
    background: #0a1628;
  }

  .leaflet-stage {
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .wind-overlay-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 380;
    pointer-events: none;
  }

  /* Minimal Top-Left HUD Card */
  .marine-waypoint-card {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    z-index: 420;
    max-width: min(320px, calc(100% - 64px));
    background: rgb(10 22 40 / 0.92);
    border: 1px solid rgb(255 255 255 / 0.16);
    border-radius: var(--r-inner);
    padding: var(--space-3);
    color: #f8fafc;
    box-shadow: var(--shadow-md);
    display: grid;
    gap: 6px;
  }

  .marine-waypoint-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .marine-waypoint-card__title {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: #ffffff;
  }

  .marine-waypoint-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: #082f49;
    color: #bae6fd;
    border: 1px solid rgb(56 189 248 / 0.35);
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .marine-waypoint-card__badge.is-road {
    background: #2d1b06;
    color: #fde68a;
    border-color: #92400e;
  }

  .marine-waypoint-card__desc {
    margin: 0;
    font-size: var(--text-xs);
    color: #cbd5e1;
    line-height: 1.45;
  }

  .marine-waypoint-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 6px;
    padding-top: 6px;
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  .waypoint-stat {
    display: grid;
    gap: 1px;
  }

  .waypoint-stat__label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: #94a3b8;
  }

  .waypoint-stat__val {
    font-size: var(--text-xs);
    font-weight: 700;
    color: #ffffff;
  }

  .satellite-map-container :global(.leaflet-top.leaflet-left) {
    left: auto;
    right: 10px;
  }

  /* Fullscreen */
  .weather-map-wrapper.is-fullscreen {
    position: fixed;
    inset: 0;
    z-index: 9999;
    margin: 0;
    border-radius: 0;
    display: flex;
    flex-direction: column;
  }

  .weather-map-wrapper.is-fullscreen .weather-map__stage {
    flex: 1;
    height: auto;
  }

  /* Reading Guide */
  .weather-map__guide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--line);
  }

  .guide-item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }

  .guide-item__icon {
    width: 36px;
    height: 36px;
    border-radius: var(--r-inner);
    background: var(--interactive-surface);
    border: 1px solid var(--interactive-border);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--interactive);
    flex-shrink: 0;
  }

  .guide-item__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink-strong);
    margin-bottom: 2px;
  }

  .guide-item__desc {
    margin: 0;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
  }

  @media (max-width: 768px) {
    .map-tab-btn,
    .layer-pill,
    .map-route-select {
      min-height: 44px;
    }

    .map-route-select {
      font-size: 16px;
      width: 100%;
      max-width: 100%;
    }
  }

  @media (max-width: 640px) {
    .weather-map-wrapper {
      padding: var(--space-4);
    }

    .weather-map__stage {
      height: 460px;
    }

    .satellite-map-container {
      display: flex;
      flex-direction: column;
    }

    .leaflet-stage {
      flex: 1;
      min-height: 0;
    }

    .marine-waypoint-card {
      position: relative;
      top: auto;
      left: auto;
      max-width: 100%;
      width: 100%;
      border-radius: 0;
      border-inline: 0;
      border-bottom: 0;
      padding: 10px var(--space-3);
      flex-shrink: 0;
    }

    .marine-waypoint-card__desc {
      display: none;
    }

    .map-legend {
      margin-left: 0;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    lat,
    lon,
    defaultMode,
    initialWindSpeed,
    initialWindDir,
    initialWaveHeight,
    locations: LOCATIONS,
    seaRoutes: SEA_ROUTES,
    mainlandRoutes: MAINLAND_ROUTES,
    fil,
  }}
>
  ;(function () {
    var tabWindy = document.getElementById('tab-windy')
    var tabSatellite = document.getElementById('tab-satellite')
    var panelWindy = document.getElementById('panel-windy')
    var panelSatellite = document.getElementById('panel-satellite')
    var layersBar = document.getElementById('windy-layers-bar')
    var routeBar = document.getElementById('satellite-route-bar')
    var quickRouteSelect = document.getElementById('map-quick-route')

    var iframe = document.getElementById('windy-iframe')
    var fsBtn = document.getElementById('map-fullscreen-toggle')
    var mapWrap = document.getElementById('weather-map-section')
    var btnLoadWindy = document.getElementById('btn-load-windy')
    var windyPlaceholder = document.getElementById('windy-placeholder')
    var windyPlaceholderDesc = document.getElementById('windy-placeholder-desc')
    var windyLoading = document.getElementById('windy-loading')
    var satelliteStatus = document.getElementById('satellite-status')

    var hudTitle = document.getElementById('map-hud-title')
    var hudBadge = document.getElementById('map-hud-badge')
    var hudDesc = document.getElementById('map-hud-desc')
    var hudSea = document.getElementById('map-hud-sea')
    var hudRoad = document.getElementById('map-hud-road')
    var hudWeather = document.getElementById('map-hud-weather')

    var currentLayer = 'wind'
    var activeMode = defaultMode || 'windy'
    var liveWindSpeed = Number(initialWindSpeed) || 14
    var liveWindDir = Number(initialWindDir) || 65
    var liveWaveHeight = Number(initialWaveHeight) || 0.6

    /* ── 1. Windy.com Live Radar ────────────────────────────── */
    function buildWindyUrl(layer) {
      return (
        'https://embed.windy.com/embed.html?type=map&location=coordinates&metricRain=default&metricTemp=default&metricWind=default&zoom=11&overlay=' +
        layer +
        '&product=ecmwf&level=surface&lat=' +
        lat +
        '&lon=' +
        lon +
        '&detailLat=' +
        lat +
        '&detailLon=' +
        lon +
        '&marker=true&pressure=true&message=true'
      )
    }

    function activateWindy() {
      if (!iframe) return
      if (navigator.onLine === false) {
        if (windyLoading) windyLoading.hidden = true
        if (windyPlaceholder) windyPlaceholder.hidden = false
        if (windyPlaceholderDesc) {
          windyPlaceholderDesc.textContent = fil
            ? 'Walang koneksyon sa internet ngayon. Buksan ang Satelayt na Mapa o subukan muli kapag may signal.'
            : 'You are currently offline. Switch to the Satellite Route Map tab or retry once back online.'
        }
        return
      }
      if (!iframe.src || iframe.hidden) {
        if (windyLoading) windyLoading.hidden = false
        iframe.src = buildWindyUrl(currentLayer)
        iframe.hidden = false
        if (windyPlaceholder) windyPlaceholder.hidden = true
      }
    }

    if (iframe) {
      iframe.addEventListener('load', function () {
        if (windyLoading) windyLoading.hidden = true
      })
    }

    if (btnLoadWindy) {
      btnLoadWindy.addEventListener('click', activateWindy)
    }

    /* ── 2. Leaflet Satellite Route Map + Synced Journey Layer ─ */
    var leafletMap = null
    var leafletLoading = false
    var activeRouteLayerGroup = null
    var staticPinsGroup = null
    var pendingJourney = null

    var overlayCanvas = document.getElementById('satellite-wind-overlay')
    var overlayCtx = overlayCanvas ? overlayCanvas.getContext('2d') : null
    var particles = []
    var rafId = null
    var reducedMotion =
      typeof window.matchMedia === 'function' && window.matchMedia('(prefers-reduced-motion: reduce)').matches

    function loadAsset(href, tag) {
      return new Promise(function (resolve, reject) {
        if (tag === 'css' && document.querySelector('link[href="' + href + '"]')) return resolve()
        if (tag === 'js' && window.L) return resolve()
        var el
        if (tag === 'css') {
          el = document.createElement('link')
          el.rel = 'stylesheet'
          el.href = href
        } else {
          el = document.createElement('script')
          el.src = href
        }
        el.onload = resolve
        el.onerror = reject
        document.head.appendChild(el)
      })
    }

    function buildJourneyFromSelect(val) {
      var parts = (val || 'sea:tumbod-to-liminangcong').split(':')
      var kind = parts[0]
      var key = parts[1]
      if (kind === 'sea') {
        var sr = seaRoutes.find(function (x) { return x.id === key }) || seaRoutes[0]
        return {
          originId: sr.fromId,
          destinationId: sr.toId,
          seaKm: sr.distanceKm,
          roadKm: 0,
          modeLabel: fil ? 'Bangka Lamang' : 'Boat Only',
          isRoadOnly: false,
          legs: [{ network: 'sea', desc: fil ? sr.notesFil : sr.notesEn, path: sr.path }],
        }
      }
      var mr = mainlandRoutes.find(function (x) { return x.toId === key }) || mainlandRoutes[0]
      var sc = seaRoutes[0]
      return {
        originId: 'tumbod',
        destinationId: mr.toId,
        seaKm: sc.distanceKm,
        roadKm: mr.highwayKm,
        modeLabel: fil ? 'Bangka + Kalsada' : 'Boat + Road',
        isRoadOnly: false,
        legs: [
          { network: 'sea', path: sc.path, desc: '' },
          { network: 'mainland', path: mr.path, desc: fil ? mr.viaFil : mr.viaEn },
        ],
      }
    }

    function drawJourneyOnMap(journey) {
      if (!journey) journey = buildJourneyFromSelect('sea:tumbod-to-liminangcong')
      pendingJourney = journey

      var orig = locations[journey.originId]
      var dest = locations[journey.destinationId]
      if (hudTitle && orig && dest) {
        hudTitle.textContent =
          (fil ? orig.nameFil : orig.nameEn).replace(' (Tuluran Island)', '').replace(' (Coastal Gateway)', '') +
          ' → ' +
          (fil ? dest.nameFil : dest.nameEn).replace(' (Coastal Gateway)', '').replace(' (Malampaya Sound)', '')
      }
      if (hudBadge) {
        hudBadge.textContent = journey.roadKm > 0 && journey.seaKm === 0
          ? (fil ? 'Kalsada Lamang' : 'Road Only')
          : journey.roadKm > 0
            ? (fil ? 'Bangka + Kalsada' : 'Boat + Road')
            : (fil ? 'Bangka Lamang' : 'Boat Only')
        hudBadge.classList.toggle('is-road', journey.roadKm > 0 && journey.seaKm === 0)
      }
      if (hudDesc) {
        var lastLeg = journey.legs[journey.legs.length - 1]
        hudDesc.textContent = (lastLeg && lastLeg.desc) || (dest ? (fil ? dest.roleFil : dest.roleEn) : '')
      }
      if (hudSea) hudSea.textContent = (journey.seaKm || 0) + ' km'
      if (hudRoad) hudRoad.textContent = (journey.roadKm || 0) + ' km'
      if (hudWeather) hudWeather.textContent = Math.round(liveWindSpeed) + ' km/h · ' + Number(liveWaveHeight).toFixed(1) + ' m'

      if (!leafletMap || !window.L) return
      var L = window.L
      if (!activeRouteLayerGroup) activeRouteLayerGroup = L.layerGroup().addTo(leafletMap)
      activeRouteLayerGroup.clearLayers()

      var allBoundsPts = []
      journey.legs.forEach(function (leg) {
        if (!leg.path || !leg.path.length) return
        var isSea = leg.network === 'sea'
        L.polyline(leg.path, {
          color: isSea ? '#38bdf8' : '#f59e0b',
          weight: isSea ? 3.5 : 4,
          dashArray: isSea ? '8 6' : null,
          opacity: 0.95,
        }).addTo(activeRouteLayerGroup)
        leg.path.forEach(function (pt) { allBoundsPts.push(pt) })
      })

      // Highlight origin, gateway (when multi-leg), and destination pins
      var keyIds = [journey.originId]
      if (journey.seaKm > 0 && journey.roadKm > 0) keyIds.push('liminangcong')
      if (journey.destinationId && keyIds.indexOf(journey.destinationId) === -1) keyIds.push(journey.destinationId)

      keyIds.forEach(function (id, idx) {
        var loc = locations[id]
        if (!loc) return
        var isDest = idx === keyIds.length - 1
        var isGateway = loc.kind === 'gateway-port'
        var fill = isGateway ? '#0ea5e9' : loc.kind === 'mainland-town' ? '#f59e0b' : '#38bdf8'
        var m = L.circleMarker([loc.lat, loc.lon], {
          radius: isDest ? 9 : 7,
          color: '#ffffff',
          weight: 2.5,
          fillColor: fill,
          fillOpacity: 1,
        }).addTo(activeRouteLayerGroup)
        m.bindPopup(
          '<strong>' + (fil ? loc.nameFil : loc.nameEn) + '</strong><br>' +
            (fil ? loc.roleFil : loc.roleEn) +
            '<br><small>' + loc.lat.toFixed(4) + '&deg; N, ' + loc.lon.toFixed(4) + '&deg; E</small>',
        )
        allBoundsPts.push([loc.lat, loc.lon])
      })

      if (allBoundsPts.length >= 2) {
        leafletMap.flyToBounds(L.latLngBounds(allBoundsPts), {
          paddingTopLeft: [28, 36],
          paddingBottomRight: [28, 28],
          maxZoom: journey.roadKm === 0 && journey.seaKm < 2 ? 14 : 12,
          duration: 0.7,
        })
      }
    }

    function resizeWindCanvas() {
      if (!overlayCanvas) return
      var host = document.getElementById('satellite-container')
      if (!host) return
      var rect = host.getBoundingClientRect()
      var w = Math.max(1, Math.floor(rect.width))
      var h = Math.max(1, Math.floor(rect.height))
      var dpr = Math.min(window.devicePixelRatio || 1, 2)
      overlayCanvas.width = w * dpr
      overlayCanvas.height = h * dpr
      if (overlayCtx) overlayCtx.setTransform(dpr, 0, 0, dpr, 0, 0)
      if (!particles.length) {
        for (var i = 0; i < 48; i++) {
          particles.push({
            x: Math.random() * w,
            y: Math.random() * h,
            len: 12 + Math.random() * 18,
            speed: 0.5 + Math.random() * 0.9,
            alpha: 0.2 + Math.random() * 0.35,
          })
        }
      }
    }

    function tickWindOverlay() {
      if (activeMode !== 'satellite' || document.hidden || reducedMotion || !overlayCtx || !overlayCanvas) {
        rafId = null
        return
      }
      var host = document.getElementById('satellite-container')
      if (!host) { rafId = null; return }
      var rect = host.getBoundingClientRect()
      var w = rect.width
      var h = rect.height
      overlayCtx.clearRect(0, 0, w, h)

      var rad = ((liveWindDir + 180) * Math.PI) / 180
      var vx = Math.sin(rad)
      var vy = -Math.cos(rad)
      var mult = Math.max(0.7, Math.min(liveWindSpeed / 14, 2.2))

      overlayCtx.lineCap = 'round'
      for (var i = 0; i < particles.length; i++) {
        var p = particles[i]
        p.x += vx * p.speed * mult
        p.y += vy * p.speed * mult
        if (p.x < -30) p.x = w + 30
        if (p.x > w + 30) p.x = -30
        if (p.y < -30) p.y = h + 30
        if (p.y > h + 30) p.y = -30

        overlayCtx.strokeStyle = 'rgba(186, 230, 253, ' + p.alpha.toFixed(2) + ')'
        overlayCtx.lineWidth = 1.4
        overlayCtx.beginPath()
        overlayCtx.moveTo(p.x, p.y)
        overlayCtx.lineTo(p.x - vx * p.len, p.y - vy * p.len)
        overlayCtx.stroke()
      }

      rafId = requestAnimationFrame(tickWindOverlay)
    }

    function startWindOverlay() {
      resizeWindCanvas()
      if (!reducedMotion && !rafId && activeMode === 'satellite' && !document.hidden) {
        rafId = requestAnimationFrame(tickWindOverlay)
      }
    }

    function initSatelliteMap() {
      var mapHost = document.getElementById('tumbod-leaflet-map')
      if (!mapHost) return
      if (leafletMap) {
        requestAnimationFrame(function () {
          leafletMap.invalidateSize()
          drawJourneyOnMap(pendingJourney || window.__tumbodActiveJourney || buildJourneyFromSelect(quickRouteSelect && quickRouteSelect.value))
          startWindOverlay()
        })
        return
      }
      if (leafletLoading) return
      leafletLoading = true
      if (satelliteStatus) satelliteStatus.hidden = false

      Promise.all([
        loadAsset('/vendor/leaflet/leaflet.css', 'css'),
        loadAsset('/vendor/leaflet/leaflet.js', 'js'),
      ])
        .then(function () {
          var L = window.L
          if (!L) return
          leafletMap = L.map(mapHost, {
            center: [10.995, 119.32],
            zoom: 12,
            scrollWheelZoom: false,
            zoomControl: true,
          })

          var satellite = L.tileLayer(
            'https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}',
            { maxZoom: 18, crossOrigin: true, attribution: 'Imagery &copy; Esri, Maxar' },
          )
          var labels = L.tileLayer(
            'https://server.arcgisonline.com/ArcGIS/rest/services/Reference/World_Boundaries_and_Places/MapServer/tile/{z}/{y}/{x}',
            { maxZoom: 18, crossOrigin: true },
          )
          var hybrid = L.layerGroup([satellite, labels]).addTo(leafletMap)
          var streets = L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 18,
            crossOrigin: true,
            attribution: '&copy; OpenStreetMap contributors',
          })

          var baseLayers = {}
          baseLayers[fil ? 'Satelayt + Pangalan' : 'Satellite Hybrid'] = hybrid
          baseLayers[fil ? 'Mapa ng Kalsada' : 'OpenStreetMap'] = streets
          L.control.layers(baseLayers, null, { collapsed: true }).addTo(leafletMap)

          // Add subtle reference markers for the 5 key local points
          staticPinsGroup = L.layerGroup().addTo(leafletMap)
          ;['tumbod', 'liminangcong', 'cataban', 'san-jose', 'calapa'].forEach(function (id) {
            var loc = locations[id]
            if (!loc) return
            L.circleMarker([loc.lat, loc.lon], {
              radius: 4.5,
              color: '#e2e8f0',
              weight: 1.5,
              fillColor: loc.kind === 'gateway-port' ? '#0ea5e9' : '#38bdf8',
              fillOpacity: 0.75,
            })
              .bindPopup(
                '<strong>' + (fil ? loc.nameFil : loc.nameEn) + '</strong><br>' +
                  (fil ? loc.roleFil : loc.roleEn),
              )
              .addTo(staticPinsGroup)
          })

          leafletMap.once('click', function () {
            leafletMap.scrollWheelZoom.enable()
          })

          if (satelliteStatus) satelliteStatus.hidden = true
          requestAnimationFrame(function () {
            leafletMap.invalidateSize()
            drawJourneyOnMap(pendingJourney || window.__tumbodActiveJourney || buildJourneyFromSelect(quickRouteSelect && quickRouteSelect.value))
            startWindOverlay()
          })
        })
        .catch(function () {
          leafletLoading = false
          if (satelliteStatus) {
            satelliteStatus.textContent = fil
              ? 'Hindi maikarga ang satelayt na mapa — tiyaking may koneksyon sa internet.'
              : 'Could not load satellite map tiles — check your internet connection.'
          }
        })
    }

    /* ── 3. Tabs, Layer Controls & Planner Sync ─────────────── */
    function showWindyTab(deferEmbed) {
      if (!tabWindy || !tabSatellite || !panelWindy || !panelSatellite) return
      activeMode = 'windy'
      tabWindy.classList.add('map-tab-btn--active')
      tabWindy.setAttribute('aria-selected', 'true')
      tabSatellite.classList.remove('map-tab-btn--active')
      tabSatellite.setAttribute('aria-selected', 'false')

      panelWindy.classList.add('weather-map__panel--active')
      panelWindy.hidden = false
      panelSatellite.classList.remove('weather-map__panel--active')
      panelSatellite.hidden = true
      if (layersBar) layersBar.hidden = false
      if (routeBar) routeBar.hidden = true
      if (deferEmbed !== true) {
        mapHydrated = true
        syncHudWeather()
        activateWindy()
      }
    }

    function showSatelliteTab(deferLoad) {
      if (!tabWindy || !tabSatellite || !panelWindy || !panelSatellite) return
      activeMode = 'satellite'
      tabSatellite.classList.add('map-tab-btn--active')
      tabSatellite.setAttribute('aria-selected', 'true')
      tabWindy.classList.remove('map-tab-btn--active')
      tabWindy.setAttribute('aria-selected', 'false')

      panelSatellite.classList.add('weather-map__panel--active')
      panelSatellite.hidden = false
      panelWindy.classList.remove('weather-map__panel--active')
      panelWindy.hidden = true
      if (layersBar) layersBar.hidden = true
      if (routeBar) routeBar.hidden = false
      if (deferLoad !== true) {
        mapHydrated = true
        syncHudWeather()
        initSatelliteMap()
      }
    }

    if (tabWindy && tabSatellite) {
      tabWindy.addEventListener('click', showWindyTab)
      tabSatellite.addEventListener('click', showSatelliteTab)
    }

    if (quickRouteSelect) {
      quickRouteSelect.addEventListener('change', function () {
        drawJourneyOnMap(buildJourneyFromSelect(quickRouteSelect.value))
      })
    }

    // Listen to InteractiveCrossingPlanner route updates
    window.addEventListener('tumbod:route-change', function (ev) {
      if (!ev || !ev.detail) return
      pendingJourney = ev.detail
      drawJourneyOnMap(ev.detail)
    })

    window.addEventListener('tumbod:focus-satellite-route', function (ev) {
      if (ev && ev.detail) pendingJourney = ev.detail
      showSatelliteTab()
    })

    var layerPills = document.querySelectorAll('.layer-pill')
    layerPills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        layerPills.forEach(function (p) {
          p.classList.remove('layer-pill--active')
          p.setAttribute('aria-pressed', 'false')
        })
        pill.classList.add('layer-pill--active')
        pill.setAttribute('aria-pressed', 'true')
        currentLayer = pill.getAttribute('data-layer') || 'wind'
        if (activeMode !== 'windy') {
          showWindyTab()
          return
        }
        if (iframe && !iframe.hidden) {
          if (windyLoading) windyLoading.hidden = false
          iframe.src = buildWindyUrl(currentLayer)
        } else {
          activateWindy()
        }
      })
    })

    function setFullscreen(on) {
      if (!mapWrap || !fsBtn) return
      mapWrap.classList.toggle('is-fullscreen', on)
      fsBtn.setAttribute('aria-pressed', on ? 'true' : 'false')
      document.documentElement.style.overflow = on ? 'hidden' : ''
      if (leafletMap) {
        requestAnimationFrame(function () {
          leafletMap.invalidateSize()
          resizeWindCanvas()
        })
      }
    }

    if (fsBtn && mapWrap) {
      fsBtn.addEventListener('click', function () {
        setFullscreen(!mapWrap.classList.contains('is-fullscreen'))
      })
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && mapWrap.classList.contains('is-fullscreen')) {
          setFullscreen(false)
        }
      })
    }

    window.addEventListener('resize', function () {
      resizeWindCanvas()
      if (leafletMap) leafletMap.invalidateSize()
    })

    document.addEventListener('visibilitychange', function () {
      if (!document.hidden && activeMode === 'satellite') startWindOverlay()
    })

    // Sync live wind/wave readings from Open-Meteo and hydrate heavy map embeds
    // after initial load/idle so above-the-fold LCP stays unobstructed on Slow 4G.
    var liveHudSynced = false
    function syncHudWeather() {
      if (liveHudSynced || navigator.onLine === false) return
      liveHudSynced = true
      Promise.all([
        fetch('https://api.open-meteo.com/v1/forecast?latitude=' + lat + '&longitude=' + lon + '&current=wind_speed_10m,wind_direction_10m&timezone=Asia%2FManila').then(function (r) { return r.json() }),
        fetch('https://marine-api.open-meteo.com/v1/marine?latitude=' + lat + '&longitude=' + lon + '&current=wave_height&timezone=Asia%2FManila').then(function (r) { return r.json() }),
      ])
        .then(function (res) {
          if (res[0] && res[0].current) {
            if (typeof res[0].current.wind_speed_10m === 'number') liveWindSpeed = res[0].current.wind_speed_10m
            if (typeof res[0].current.wind_direction_10m === 'number') liveWindDir = res[0].current.wind_direction_10m
          }
          if (res[1] && res[1].current && typeof res[1].current.wave_height === 'number') {
            liveWaveHeight = res[1].current.wave_height
          }
          if (hudWeather) hudWeather.textContent = Math.round(liveWindSpeed) + ' km/h · ' + Number(liveWaveHeight).toFixed(1) + ' m'
        })
        .catch(function () {})
    }

    var conn = navigator.connection || {}
    var slowOrMetered =
      conn.saveData === true ||
      conn.effectiveType === '2g' ||
      conn.effectiveType === 'slow-2g'

    var mapHydrated = false
    function hydrateLiveMap() {
      if (mapHydrated) return
      mapHydrated = true
      syncHudWeather()
      if (activeMode === 'windy' && navigator.onLine !== false) {
        if (slowOrMetered) {
          if (windyLoading) windyLoading.hidden = true
          if (windyPlaceholder) windyPlaceholder.hidden = false
        } else {
          activateWindy()
        }
      } else {
        initSatelliteMap()
      }
    }

    if (activeMode === 'windy' && navigator.onLine !== false) {
      showWindyTab(true)
    } else {
      showSatelliteTab(true)
    }

    var scheduleMapHydration = function () {
      if ('IntersectionObserver' in window && mapWrap) {
        var mapIo = new IntersectionObserver(
          function (entries) {
            if (entries.some(function (e) { return e.isIntersecting })) {
              mapIo.disconnect()
              hydrateLiveMap()
            }
          },
          { rootMargin: '250px' },
        )
        mapIo.observe(mapWrap)
        return
      }
      if ('requestIdleCallback' in window) {
        requestIdleCallback(hydrateLiveMap, { timeout: 1200 })
      } else {
        setTimeout(hydrateLiveMap, 400)
      }
    }

    if (document.readyState === 'complete') {
      scheduleMapHydration()
    } else {
      window.addEventListener('load', scheduleMapHydration, { once: true })
    }
  })()
</script>
