---
/**
 * News mega panel — featured story, latest list, upcoming events, quick access.
 *
 * WHERE THE CONTENT COMES FROM. If the barangay has published anything, this
 * panel shows THAT: `ANNOUNCEMENTS` and `CALENDAR` from `active.ts` win over
 * everything else. Only when both are empty — which is the state today — does
 * it fall back to `sample.ts`, and then the column is topped with a visible
 * SAMPLE DATA chip and every headline carries "(sample)".
 *
 * That ordering is the whole design. The panel is populated so the layout can
 * be reviewed and handed over, and it becomes real automatically the moment
 * content exists, with no code change and no flag to remember to flip.
 */
import Icon from '../Icon.astro'
import SampleChip from '../SampleChip.astro'
/*
 * Content comes from `articles.ts` — database first, samples second — 2026-08-07.
 *
 * Two changes rolled into one import:
 *
 * 1. THESE ARTICLES HAVE PAGES. Sample headlines used to have no slug, so
 *    every row pointed at `/balita`: six headlines, one destination, and a
 *    reader who clicked the third story landed on a list and had to find it
 *    again. Each row now goes to its own article.
 *
 * 2. THE PANEL AND THE PAGE AGREE. The panel previously read `ANNOUNCEMENTS`
 *    (an empty array outside demo mode) while /balita read something else.
 *    Both now resolve through the same function, so the header can no longer
 *    advertise stories the page it links to does not have.
 */
import { articleHref } from '@/lib/content/sample-news'
import { getNews, getUpcomingEvents } from '@/lib/content/articles'
import { NEWS_QUICK, prefix, label, note } from '@/lib/content/menu'
import { formatAbsolute, monthAbbrev } from '@/lib/time'
import type { Locale } from '@/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const fil = locale === 'fil'
const p = prefix(locale)

/**
 * Normalised to one shape so the template does not branch on provenance.
 *
 * `body`/`image` are `string | undefined` rather than optional: the project
 * runs `exactOptionalPropertyTypes`, under which `body?: string` refuses an
 * explicit `undefined`.
 */
interface Card {
  title: string
  body: string | undefined
  date: string
  category: string
  image: string | undefined
  href: string
}

const news = await getNews()
const upcoming = await getUpcomingEvents()

const usingSampleStories = news.isSample
const usingSampleEvents = upcoming.isSample

const [leadArticle, ...restArticles] = news.items

const featured: Card | undefined = leadArticle && {
  title: fil ? leadArticle.titleFil : leadArticle.titleEn,
  body: (fil ? leadArticle.leadFil : leadArticle.leadEn) || undefined,
  date: formatAbsolute(leadArticle.publishedAt, locale),
  category: fil ? leadArticle.categoryFil : leadArticle.categoryEn,
  image: leadArticle.image?.thumb,
  href: articleHref(leadArticle, locale),
}

const latest: Card[] = restArticles.slice(0, 5).map((s) => ({
  title: fil ? s.titleFil : s.titleEn,
  body: undefined,
  date: formatAbsolute(s.publishedAt, locale),
  category: fil ? s.categoryFil : s.categoryEn,
  image: s.image?.thumb,
  href: articleHref(s, locale),
}))

const events = upcoming.items.slice(0, 4).map((e) => ({
  month: monthAbbrev(e.startsAt!, locale),
  day: String(e.startsAt!.getDate()),
  title: fil ? e.titleFil : e.titleEn,
  place: (fil ? e.locationFil : e.locationEn) ?? '',
  href: articleHref(e, locale),
}))
---

{/* ── Column 1: featured ─────────────────────────────────────── */}
<section class="mega__col">
  <h2 class="mega__heading">
    {fil ? 'Pangunahing balita' : 'Featured story'}
    {usingSampleStories && <SampleChip locale={locale} />}
  </h2>

  {/* `featured` is undefined only if the barangay has published nothing AND
      the sample set were emptied — but the panel must not throw in that case,
      because it is in the header of every page including /ligtas. */}
  {
    featured ? (
      <a class="mega-feature" href={featured.href}>
        <span class="mega-feature__media">
          {featured.image ? (
            <img src={featured.image} alt="" width="320" height="180" loading="lazy" decoding="async" />
          ) : (
            <span class="mega-feature__noimg">{fil ? 'Walang larawan' : 'No photograph'}</span>
          )}
        </span>
        <span class="mega-feature__body">
          {featured.category && <span class="mega-badge">{featured.category}</span>}
          <span class="mega-feature__title">{featured.title}</span>
          {featured.body && <span class="mega-feature__excerpt">{featured.body}</span>}
          <span class="mega__meta">{featured.date}</span>
          <span class="mega-cta">
            {fil ? 'Basahin ang buong balita' : 'Read full story'}
            <Icon name="chevron-right" size={16} />
          </span>
        </span>
      </a>
    ) : (
      <p class="mega__meta">
        {fil ? 'Wala pang nailathalang balita.' : 'No news has been published yet.'}
      </p>
    )
  }
</section>

{/* ── Column 2: latest ───────────────────────────────────────── */}
<section class="mega__col">
  <h2 class="mega__heading">
    {fil ? 'Pinakabagong balita' : 'Latest news'}
    {usingSampleStories && <SampleChip locale={locale} />}
  </h2>

  {/* Upgraded in place by LiveContent once the database answers. The rows
      below are the fallback and stay put if it does not. */}
  <ul
    class="mega-list"
    data-live="announcements"
    data-live-tpl="news"
    data-live-query="select=*&is_published=eq.true&order=published_at.desc&limit=5&offset=1"
  >
    {
      latest.map((s) => (
        <li>
          <a class="mega-row" href={s.href}>
            <span class="mega-row__thumb">
              {s.image ? (
                <img src={s.image} alt="" width="56" height="56" loading="lazy" decoding="async" />
              ) : (
                <Icon name="megaphone" size={20} />
              )}
            </span>
            <span class="mega-row__body">
              <span class="mega-row__title">{s.title}</span>
              <span class="mega__meta">
                {s.date}
                {s.category && <span class="mega-badge mega-badge--sm">{s.category}</span>}
              </span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  <a class="mega__viewall" href={`${p}/balita`}>
    {fil ? 'Lahat ng balita' : 'View all news'}
    <Icon name="chevron-right" size={16} />
  </a>
</section>

{/* ── Column 3: events ───────────────────────────────────────── */}
<section class="mega__col">
  <h2 class="mega__heading">
    {fil ? 'Mga darating na kaganapan' : 'Upcoming events'}
    {usingSampleEvents && <SampleChip locale={locale} />}
  </h2>

  <ul
    class="mega-list"
    data-live="events"
    data-live-tpl="events"
    data-live-query="select=*&is_published=eq.true&order=starts_at.asc&limit=4"
  >
    {
      events.map((e) => (
        <li>
          <a class="mega-event" href={e.href}>
            {/* `aria-hidden`: "AGO 15" read as two separate strings is noise.
                The full date follows in the visually-hidden run. */}
            <span class="mega-event__date" aria-hidden="true">
              <span class="mega-event__month">{e.month}</span>
              <span class="mega-event__day">{e.day}</span>
            </span>
            <span class="mega-event__body">
              <span class="mega-row__title">{e.title}</span>
              <span class="mega__meta">
                <Icon name="pin" size={14} />
                {e.place}
              </span>
              <span class="u-visually-hidden">{`${e.month} ${e.day}`}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {/* /kaganapan, not /balita. "View all events" pointing at the news list was
      the same wrong-destination bug as the rows above, one level up. */}
  <a class="mega__viewall" href={`${p}/kaganapan`}>
    {fil ? 'Lahat ng kaganapan' : 'View all events'}
    <Icon name="chevron-right" size={16} />
  </a>
</section>

{/* ── Column 4: quick access ─────────────────────────────────── */}
<section class="mega__col">
  <h2 class="mega__heading">{fil ? 'Mabilisang daan' : 'Quick access'}</h2>
  <ul class="mega-cards">
    {
      NEWS_QUICK.map((item) => (
        <li>
          <a class="mega-card" href={`${p}${item.href}`}>
            <span class="mega-card__icon">
              <Icon name={item.icon} size={18} />
            </span>
            <span class="mega-card__body">
              <span class="mega-row__title">{label(locale, item)}</span>
              <span class="mega__meta">{note(locale, item)}</span>
            </span>
            <span class="mega-tile__arrow" aria-hidden="true">
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</section>
