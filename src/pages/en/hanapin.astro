---
import Base from '@/layouts/Base.astro'
import SearchView from '@/views/SearchView.astro'
import { getDictionary } from '@/lib/i18n'

const locale = 'en'
const t = getDictionary(locale)
---

<Base
  locale={locale}
  pathname="/en/hanapin"
  title={t.home.search}
  description="Search services, officials, emergency hotlines, and advisories on the Barangay Tumbod website."
>
  <SearchView locale={locale} />
</Base>
