---
import type { GetStaticPaths } from 'astro'
import Base from '@/layouts/Base.astro'
import ServiceDetailView from '@/views/ServiceDetailView.astro'
import { SERVICE_DETAILS } from '@/lib/content/active'

export const getStaticPaths = (() =>
  SERVICE_DETAILS.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths

const { service } = Astro.props
---

<Base
  locale="en"
  pathname={`/en/serbisyo/${service.slug}`}
  title={service.nameEn}
  description={service.descriptionEn}
>
  <ServiceDetailView service={service} locale="en" />
</Base>
