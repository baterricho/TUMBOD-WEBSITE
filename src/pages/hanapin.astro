---
import Base from '@/layouts/Base.astro'
import SearchView from '@/views/SearchView.astro'
import { getDictionary, DEFAULT_LOCALE } from '@/lib/i18n'

const locale = DEFAULT_LOCALE
const t = getDictionary(locale)
---

<Base
  locale={locale}
  pathname="/hanapin"
  title={t.home.search}
  description="Hanapin ang kailangan mo sa website ng Barangay Tumbod."
>
  <SearchView locale={locale} />
</Base>
