---
/**
 * ContactView — Verified location details, sea travel routes, emergency
 * numbers (via PhoneNumber demo/placeholder guards), and opt-in LocationMap.
 */
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import Placeholder from '@/components/Placeholder.astro'
import PhoneNumber from '@/components/PhoneNumber.astro'
import LocationMap from '@/components/LocationMap.astro'
import { getDictionary, type Locale, prefix } from '@/lib/i18n'
import { SITE } from '@/lib/content/site'
import { getHotlines } from '@/lib/content/live-collections'
import { isPlaceholder } from '@/lib/content/placeholder'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const HOTLINES = (await getHotlines()).items
const t = getDictionary(locale)
const fil = locale === 'fil'
const p = prefix(locale)

const TRAVEL_ROUTES = [
  {
    originFil: 'Liminangcong Port (Coastal Gateway)',
    originEn: 'Liminangcong Port (Coastal Gateway)',
    destinationFil: 'Pantalan ng Tumbod (Tuluran Island)',
    destinationEn: 'Tumbod Pier (Tuluran Island)',
    modeFil: 'Bangka / Motorized Outrigger (Dagat Lamang)',
    modeEn: 'Motorized Bangka / Boat (Sea Only)',
    distanceFil: '~0.7 km tawid sa Endeavor Strait · tinatayang ~5–10 minuto',
    distanceEn: '~0.7 km across Endeavor Strait · estimated ~5–10 minutes',
    scheduleFil: 'Mga biyahe ayon sa iskedyul ng mga bangkero at lagay ng dagat',
    scheduleEn: 'Departures subject to registered boat operators and sea conditions',
    operatorFil: 'Mga Rehistradong Bangkero ng Tumbod (Boat Operators Association)',
    operatorEn: 'Registered Boat Operators of Barangay Tumbod',
  },
  {
    originFil: 'Pantalan ng Tumbod (Tuluran Island)',
    originEn: 'Tumbod Pier (Tuluran Island)',
    destinationFil: 'Taytay Poblacion at Mainland Palawan',
    destinationEn: 'Taytay Poblacion & Mainland Palawan',
    modeFil: '2 Yugto: Bangka (Dagat) + Van / Bus / Motorsiklo (Kalsada)',
    modeEn: 'Multi-Leg: Boat (Sea) + Van / Bus / Motorcycle (Highway)',
    distanceFil: '~0.7 km dagat papuntang Liminangcong Port + ~54.4 km kalsada patungong Taytay (~262.7 km patungong Puerto Princesa)',
    distanceEn: '~0.7 km sea to Liminangcong Port + ~54.4 km road to Taytay (~262.7 km road to Puerto Princesa)',
    scheduleFil: 'Hiwalay ang paglipat sa Liminangcong Port; tanungin ang bangkero o terminal sa oras ng alis',
    scheduleEn: 'Transfer at Liminangcong Port; verify current departures with boat crews and highway van terminals',
    operatorFil: 'Bangka Operators Association (Dagat) + Mainland Palawan Van / Bus Lines',
    operatorEn: 'Tumbod Boat Association (Sea) + Mainland Palawan Van / Bus Lines',
  },
]
---

<Section divider={false} class="section--airy">
  <h1 class="page-title">{t.nav.contact}</h1>
  <p class="section-lede">
    {fil
      ? 'Lokasyon ng Barangay Hall sa Pulo ng Tuluran, iskedyul ng bangka, at opisyal na numerong pang-emergency.'
      : 'Barangay Hall location on Tuluran Island, boat crossing routes, and verified emergency contact numbers.'}
  </p>
</Section>

<Section title={fil ? 'Saan kami' : 'Where we are'} titleId="location">
  <div class="contact-card card">
    <p class="contact-place">
      Barangay Tumbod, {fil ? 'Pulo ng Tuluran' : 'Tuluran Island'}, {SITE.municipality},{' '}
      {SITE.province}, {SITE.region}.
    </p>
    <p class="contact-coords">
      <Icon name="pin" size={18} />
      <span class="figure">{SITE.coordinates.lat} N, {SITE.coordinates.lng} E</span>
    </p>
    <p class="small">
      <strong>{t.footer.address}:</strong>{' '}
      {isPlaceholder(SITE.address) ? <Placeholder value={SITE.address} /> : SITE.address}
    </p>
    <p class="small">
      <strong>{t.footer.officeHours}:</strong>{' '}
      {isPlaceholder(SITE.officeHours) ? <Placeholder value={SITE.officeHours} /> : SITE.officeHours}
    </p>
  </div>
</Section>

<Section title={fil ? 'Paano marating ang Tumbod' : 'How to reach Tumbod'} titleId="travel">
  <div class="routes-stack">
    {
      TRAVEL_ROUTES.map((route) => (
        <article class="fcard route-card">
          <h3 class="route-card__title">
            {fil ? route.originFil : route.originEn} → {fil ? route.destinationFil : route.destinationEn}
          </h3>
          <ul class="route-card__list">
            <li><strong>{fil ? 'Sasakyan:' : 'Transport Mode:'}</strong> {fil ? route.modeFil : route.modeEn}</li>
            <li><strong>{fil ? 'Distansya at Tantyang Oras:' : 'Distance & Est. Time:'}</strong> {fil ? route.distanceFil : route.distanceEn}</li>
            <li><strong>{fil ? 'Paalala sa Biyahe:' : 'Travel Notes:'}</strong> {fil ? route.scheduleFil : route.scheduleEn}</li>
            <li><strong>{fil ? 'Mga Operator:' : 'Operators:'}</strong> {fil ? route.operatorFil : route.operatorEn}</li>
          </ul>
        </article>
      ))
    }
    <p class="is-water muted small">{t.safety.coastGuardRule}</p>
  </div>
</Section>

<Section title={t.nav.emergencyLabel} titleId="numbers">
  <div class="hotlines">
    <ul class="list-reset">
      {
        HOTLINES.slice(0, 3).map((line) => (
          <li class="row">
            <span>{fil ? line.labelFil : line.labelEn}</span>
            <PhoneNumber number={line.number} locale={locale} />
          </li>
        ))
      }
    </ul>
  </div>
  <p class="contact-dir-link">
    <a href={`${p}/ligtas/hotline`}>{t.home.fullDirectory} →</a>
  </p>
</Section>

<LocationMap locale={locale} />

<style>
  .contact-card {
    max-width: var(--measure);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  .contact-place {
    font-weight: 600;
    color: var(--ink-strong);
  }

  .contact-coords {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--interactive);
    font-weight: 600;
  }

  .routes-stack {
    max-width: var(--measure);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
  }

  .route-card {
    padding: var(--space-5);
  }

  .route-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink-strong);
    margin: 0;
  }

  .route-card__list {
    margin: 0;
    padding-inline-start: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink);
    line-height: 1.65;
    display: grid;
    gap: 6px;
  }

  .contact-dir-link {
    margin-top: var(--space-4);
  }
</style>
