---
/**
 * GalleryView — Authentic Barangay Tumbod photography and drone footage
 * with category filtering, accessible lightbox modal (focus restoration,
 * keyboard navigation, clean video teardown), and consent policy.
 */
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import { prefix, type Locale } from '@/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const fil = locale === 'fil'
const p = prefix(locale)

const GALLERY_ITEMS = [
  {
    id: 'falls',
    type: 'photo',
    category: 'falls',
    src: '/media/tumbod-falls.jpg',
    thumb: '/media/tumbod-falls-thumb.jpg',
    titleFil: 'Talon sa Baybayin ng Tuluran',
    titleEn: 'Shoreline Waterfall of Tuluran',
    descFil: 'Talon na bumubuhos mula sa matarik na bangin patungo sa malinaw na look. May bangkang de-katig na nakatigil sa mababaw na bahagi.',
    descEn: 'A waterfall cascading down steep cliffs directly into a pristine cove. An outrigger boat rests peacefully in the shallows.',
    locationFil: 'Hilagang Baybayin ng Pulo ng Tuluran',
    locationEn: 'Northern Shoreline, Tuluran Island',
    width: 960,
    height: 539,
    tagFil: 'Talon',
    tagEn: 'Waterfall',
  },
  {
    id: 'cove-1',
    type: 'photo',
    category: 'cove',
    src: '/media/tumbod-cove-1.jpg',
    thumb: '/media/tumbod-cove-1-thumb.jpg',
    titleFil: 'Look ng Tuluran mula sa Itaas',
    titleEn: 'Tuluran Cove from Above',
    descFil: 'Tanaw mula sa himpapawid ng isang protektadong look — mababaw at malinaw ang tubig sa gilid, malalim at asul sa labas. Isang bangkang de-katig ang nasa gitna.',
    descEn: 'Aerial perspective of a sheltered cove — crystalline shallow waters meeting deep oceanic blue, centered by an outrigger boat.',
    locationFil: 'Silangang Look, Tuluran Island',
    locationEn: 'East Cove, Tuluran Island',
    width: 960,
    height: 539,
    tagFil: 'Look at Dagat',
    tagEn: 'Cove & Sea',
  },
  {
    id: 'cove-2',
    type: 'photo',
    category: 'cove',
    src: '/media/tumbod-cove-2.jpg',
    thumb: '/media/tumbod-cove-2-thumb.jpg',
    titleFil: 'Bahura at Katig sa Mababaw na Tubig',
    titleEn: 'Reef and Outrigger in Clear Shallows',
    descFil: 'Tanaw mula sa itaas ng buhay na bahura na malinaw na nakikita sa ilalim ng tubig, may bangkang de-katig na nakadaong malapit sa mabatong pampang.',
    descEn: 'Overhead view of thriving coastal coral reefs visible through translucent water, with an outrigger moored along the rugged shoreline.',
    locationFil: 'Baybaying Bahura ng Tumbod',
    locationEn: 'Tumbod Coastal Reef',
    width: 960,
    height: 539,
    tagFil: 'Look at Bahura',
    tagEn: 'Reef & Waters',
  },
  {
    id: 'pantalan',
    type: 'photo',
    category: 'pantalan',
    src: '/media/tumbod-pantalan.jpg',
    thumb: '/media/tumbod-pantalan-thumb.jpg',
    titleFil: 'Ang Pantalan ng Tumbod',
    titleEn: 'Tumbod Pier & Boat Landing',
    descFil: 'Kongkretong pantalan na may dilaw na gilid, palamuting bandera at lobo. Nakadaong ang maraming bangka sa magkabilang panig; may bundok at bahayan sa likuran.',
    descEn: 'Concrete landing pier edged in safety yellow, with decorated bunting. Multiple outrigger boats moored alongside, framed by verdant hills and coastal dwellings.',
    locationFil: 'Poblacion Pantalan, Barangay Tumbod',
    locationEn: 'Main Pier, Barangay Tumbod',
    width: 1080,
    height: 1920,
    tagFil: 'Pantalan',
    tagEn: 'Pier',
  },
  {
    id: 'video-hero',
    type: 'video',
    category: 'video',
    src: '/media/tumbod-hero.mp4',
    poster: '/media/tumbod-hero-poster.jpg',
    thumb: '/media/tumbod-hero-poster.jpg',
    titleFil: 'Himpapawid na Tanawin ng Baybaying Pamayanan',
    titleEn: 'Aerial View of Coastal Settlement',
    descFil: 'Maikling video mula sa himpapawid na nagpapakita ng baybaying pamayanan, mga tahanan sa tabi ng dagat, at mga bangkang de-katig sa golden hour.',
    descEn: 'Aerial footage capturing the stilt settlement along the bay, coastline houses, and outrigger boats during sunset.',
    locationFil: 'Baybaying Pamayanan ng Tumbod',
    locationEn: 'Tumbod Coastal Settlement',
    tagFil: 'Video Footage',
    tagEn: 'Video Footage',
  },
]

const CATEGORIES = [
  { id: 'all', labelFil: 'Lahat ng Media', labelEn: 'All Media' },
  { id: 'cove', labelFil: 'Mga Look at Bahura', labelEn: 'Coves & Reefs' },
  { id: 'falls', labelFil: 'Talon sa Baybayin', labelEn: 'Waterfalls' },
  { id: 'pantalan', labelFil: 'Pantalan at Bangka', labelEn: 'Pier & Boats' },
  { id: 'video', labelFil: 'Mga Video', labelEn: 'Videos' },
]

const WANTED = [
  { fil: 'Barangay hall at Health Station', en: 'Barangay Hall & Health Station' },
  { fil: 'Paaralang Elementarya ng Tumbod', en: 'Tumbod Elementary School' },
  { fil: 'Pook-likasan kapag may bagyo', en: 'Typhoon Evacuation Center' },
  { fil: 'Bakawan at Protected Mangrove Sanctuary', en: 'Protected Mangrove Sanctuary' },
  { fil: 'Pista at tradisyunal na pagtitipon', en: 'Fiesta & Community Gatherings' },
]
---

<Section divider={false} class="section--airy">
  <h1 class="page-title">{fil ? 'Mga Larawan at Video ng Tumbod' : 'Photos and Videos of Tumbod'}</h1>
  <p class="section-lede">
    {fil
      ? 'Tunay na larawan at footage ng Pulo ng Tuluran at Barangay Tumbod. Walang stock photos o AI generation — ang bawat kuha ay totoong lugar sa ating isla.'
      : 'Authentic photography and video captures of Tuluran Island and Barangay Tumbod. No stock photos or AI-generated imagery — every view shows real places on the island.'}
  </p>
</Section>

<Section divider={false}>
  <div class="gallery-filters" role="tablist" aria-label={fil ? 'I-filter ayon sa kategorya' : 'Filter by category'}>
    {CATEGORIES.map((cat, idx) => (
      <button
        type="button"
        class={`gallery-filter-btn${idx === 0 ? ' is-active' : ''}`}
        data-filter={cat.id}
        role="tab"
        aria-selected={idx === 0 ? 'true' : 'false'}
      >
        {fil ? cat.labelFil : cat.labelEn}
      </button>
    ))}
  </div>

  <div class="gallery-grid" id="gallery-grid">
    {
      GALLERY_ITEMS.map((item, index) => (
        <article
          class="gallery-card"
          data-category={item.category}
          data-type={item.type}
          data-index={index}
        >
          <div class="gallery-card__media-wrap">
            <img
              src={item.thumb}
              alt={fil ? item.titleFil : item.titleEn}
              class="gallery-card__img"
              loading="lazy"
              decoding="async"
            />
            <span class="gallery-card__badge">
              <Icon name={item.type === 'video' ? 'play' : 'camera'} size={13} />
              <span>{fil ? item.tagFil : item.tagEn}</span>
            </span>
          </div>
          <div class="gallery-card__caption">
            <h2 class="gallery-card__title">
              <button type="button" class="gallery-card__trigger" data-index={index}>
                {fil ? item.titleFil : item.titleEn}
              </button>
            </h2>
            <p class="gallery-card__desc">{fil ? item.descFil : item.descEn}</p>
            <p class="gallery-card__loc">
              <Icon name="pin" size={14} />
              <span>{fil ? item.locationFil : item.locationEn}</span>
            </p>
          </div>
        </article>
      ))
    }
  </div>
</Section>

{/* Accessible Media Lightbox */}
<dialog id="gallery-lightbox" class="lightbox-dialog" aria-labelledby="lightbox-title">
  <div class="lightbox-dialog__shell">
    <button
      type="button"
      class="lightbox-btn--close"
      id="lightbox-close"
      aria-label={fil ? 'Isara ang viewer' : 'Close media viewer'}
    >
      <Icon name="close" size={20} />
    </button>

    <div class="lightbox-dialog__stage" id="lightbox-stage"></div>

    <div class="lightbox-dialog__meta">
      <div class="lightbox-dialog__info">
        <h3 class="lightbox-dialog__title" id="lightbox-title"></h3>
        <p class="lightbox-dialog__desc" id="lightbox-desc"></p>
        <p class="lightbox-dialog__loc" id="lightbox-loc"></p>
      </div>
      <div class="lightbox-dialog__nav">
        <button type="button" class="lightbox-nav-btn" id="lightbox-prev" aria-label={fil ? 'Nakaraang Larawan' : 'Previous Media'}>
          <Icon name="chevron-left" size={20} />
        </button>
        <span class="lightbox-counter figure" id="lightbox-counter">1 / 5</span>
        <button type="button" class="lightbox-nav-btn" id="lightbox-next" aria-label={fil ? 'Susunod na Larawan' : 'Next Media'}>
          <Icon name="chevron-right" size={20} />
        </button>
      </div>
    </div>
  </div>
</dialog>

<Section title={fil ? 'Kailangan Pang Makunan sa Barangay' : 'Still To Be Photographed in Tumbod'} titleId="wanted" tone="sunken">
  <p class="gallery-wanted-lead">
    {fil
      ? 'Nais naming ipakita ang kabuuan ng buhay sa Tumbod. Kung mayroon kayong kuha ng mga sumusunod na lugar o gawain, maaaring ipagbigay-alam sa Barangay Hall:'
      : 'We aim to represent full island life in Tumbod. If you have photographs of the following landmarks or community activities, please reach out to the Barangay Hall:'}
  </p>
  <ul class="grid-cards grid-cards--tight">
    {
      WANTED.map((w) => (
        <li>
          <div class="fcard fcard--icon">
            <span class="fcard__icon" aria-hidden="true">
              <Icon name="camera" size={18} />
            </span>
            <span class="fcard__title">{fil ? w.fil : w.en}</span>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<Section title={fil ? 'Patakaran sa Pahintulot (Consent)' : 'About Consent and Rights'} titleId="consent">
  <div class="card gallery-consent">
    <p>
      {fil
        ? 'Bago ilathala ang larawan ng sinumang residente o kanilang bangka at tahanan, kailangan ang tahasang pahintulot para sa opisyal na website ng pamahalaan. Hindi sapat ang simpleng post sa social media dahil ang website na ito ay permanente at naka-index sa buong mundo.'
        : 'Before publishing photographs of residents, their outrigger vessels, or family homes, explicit consent for the official government website is required. Social media posts do not equate to consent for a permanent municipal archive.'}
    </p>
    <p class="small muted gallery-consent__cta">
      {fil
        ? 'Para mag-ambag o magpa-update ng impormasyon, magtungo sa Barangay Hall o makipag-ugnayan sa aming '
        : 'To contribute verified photography or request removals, visit the Barangay Hall or reach out via our '}
      <a href={`${p}/kontak`}>{fil ? 'Pahina ng Kontak' : 'Contact Page'}</a>.
    </p>
  </div>
</Section>

<style>
  .gallery-filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .gallery-filter-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px var(--space-4);
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .gallery-filter-btn:hover {
    border-color: var(--interactive);
    color: var(--interactive);
  }

  .gallery-filter-btn.is-active {
    background: var(--action);
    color: var(--action-ink);
    border-color: var(--action-edge);
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(19rem, 100%), 1fr));
    gap: var(--space-4);
  }

  .gallery-card {
    position: relative;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    overflow: hidden;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-sm);
    transition:
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-base) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  .gallery-card:hover,
  .gallery-card:has(.gallery-card__trigger:focus-visible) {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    border-color: var(--interactive);
  }

  .gallery-card__media-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--surface-sunken);
    overflow: hidden;
  }

  .gallery-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--motion-slow) var(--ease-standard);
  }

  .gallery-card:hover .gallery-card__img {
    transform: scale(1.03);
  }

  .gallery-card__badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 8px;
    border-radius: var(--radius-sm);
    background: rgb(15 23 42 / 0.85);
    color: #ffffff;
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .gallery-card__caption {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .gallery-card__title {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink-strong);
    margin: 0;
    line-height: var(--leading-snug);
  }

  .gallery-card__trigger {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }

  .gallery-card__trigger:focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  .gallery-card__trigger::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .gallery-card__desc {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .gallery-card__loc {
    margin-top: auto;
    padding-top: var(--space-2);
    font-size: var(--text-xs);
    color: var(--interactive);
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 600;
  }

  .gallery-wanted-lead {
    max-width: var(--measure);
    margin-bottom: var(--space-4);
    color: var(--ink-muted);
  }

  .gallery-consent {
    max-width: var(--measure);
  }

  .gallery-consent__cta {
    margin-top: var(--space-3);
  }

  /* Lightbox Dialog */
  .lightbox-dialog {
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: var(--r-panel);
    padding: 0;
    background: #0f172a;
    color: #f8fafc;
    width: min(94vw, 1020px);
    max-height: 92vh;
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    margin: auto;
  }

  .lightbox-dialog::backdrop {
    background: rgb(2 6 23 / 0.82);
  }

  .lightbox-dialog__shell {
    position: relative;
    display: flex;
    flex-direction: column;
    max-height: 92vh;
  }

  .lightbox-btn--close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    z-index: 10;
    width: 44px;
    height: 44px;
    border-radius: var(--r-inner);
    border: 1px solid rgb(255 255 255 / 0.28);
    background: rgb(15 23 42 / 0.85);
    color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .lightbox-btn--close:hover {
    background: rgb(30 41 59 / 0.98);
  }

  .lightbox-dialog__stage {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #020617;
    min-height: 280px;
    max-height: 62vh;
    overflow: hidden;
  }

  .lightbox-dialog__meta {
    padding: var(--space-4);
    background: #0f172a;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    border-top: 1px solid rgb(255 255 255 / 0.12);
  }

  @media (min-width: 640px) {
    .lightbox-dialog__meta {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .lightbox-dialog__title {
    font-size: var(--text-lg);
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 4px;
  }

  .lightbox-dialog__desc {
    font-size: var(--text-xs);
    color: #cbd5e1;
    margin: 0 0 4px;
    max-width: 58ch;
    line-height: 1.5;
  }

  .lightbox-dialog__loc {
    font-size: var(--text-xs);
    color: #7dd3fc;
    margin: 0;
    font-weight: 600;
  }

  .lightbox-dialog__nav {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    align-self: flex-end;
  }

  .lightbox-nav-btn {
    width: 44px;
    height: 44px;
    border-radius: var(--r-inner);
    border: 1px solid rgb(255 255 255 / 0.25);
    background: rgb(255 255 255 / 0.08);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .lightbox-nav-btn:hover {
    background: rgb(255 255 255 / 0.2);
  }

  .lightbox-counter {
    font-size: var(--text-xs);
    color: #cbd5e1;
    font-weight: 600;
    min-width: 44px;
    text-align: center;
  }
</style>

<script is:inline define:vars={{ items: GALLERY_ITEMS, fil }}>
  ;(function () {
    var filterBtns = [].slice.call(document.querySelectorAll('.gallery-filter-btn'))
    var cards = [].slice.call(document.querySelectorAll('.gallery-card'))
    var dialog = document.getElementById('gallery-lightbox')
    var stage = document.getElementById('lightbox-stage')
    var titleEl = document.getElementById('lightbox-title')
    var descEl = document.getElementById('lightbox-desc')
    var locEl = document.getElementById('lightbox-loc')
    var counterEl = document.getElementById('lightbox-counter')
    var closeBtn = document.getElementById('lightbox-close')
    var prevBtn = document.getElementById('lightbox-prev')
    var nextBtn = document.getElementById('lightbox-next')

    var activeIndex = 0
    var lastTrigger = null
    var visibleIndices = items.map(function (_, i) { return i })

    filterBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        filterBtns.forEach(function (b) {
          b.classList.remove('is-active')
          b.setAttribute('aria-selected', 'false')
        })
        btn.classList.add('is-active')
        btn.setAttribute('aria-selected', 'true')

        var cat = btn.dataset.filter
        visibleIndices = []

        cards.forEach(function (card, idx) {
          var show = cat === 'all' || card.dataset.category === cat || (cat === 'video' && card.dataset.type === 'video')
          card.hidden = !show
          if (show) visibleIndices.push(idx)
        })
      })
    })

    function openMedia(index, triggerEl) {
      activeIndex = index
      if (triggerEl) lastTrigger = triggerEl
      var item = items[index]
      if (!item || !stage) return

      stage.innerHTML = ''
      if (item.type === 'video') {
        var video = document.createElement('video')
        video.src = item.src
        video.poster = item.poster
        video.controls = true
        video.playsInline = true
        video.style.maxWidth = '100%'
        video.style.maxHeight = '62vh'
        video.style.display = 'block'
        stage.appendChild(video)
      } else {
        var img = document.createElement('img')
        img.src = item.src
        img.alt = fil ? item.titleFil : item.titleEn
        img.style.maxWidth = '100%'
        img.style.maxHeight = '62vh'
        img.style.objectFit = 'contain'
        img.style.display = 'block'
        stage.appendChild(img)
      }

      if (titleEl) titleEl.textContent = fil ? item.titleFil : item.titleEn
      if (descEl) descEl.textContent = fil ? item.descFil : item.descEn
      if (locEl) locEl.textContent = fil ? item.locationFil : item.locationEn
      if (counterEl) counterEl.textContent = (index + 1) + ' / ' + items.length

      if (dialog && !dialog.open) {
        if (typeof dialog.showModal === 'function') dialog.showModal()
        else dialog.setAttribute('open', '')
      }
    }

    function teardown() {
      if (stage) stage.innerHTML = ''
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        lastTrigger.focus()
      }
    }

    cards.forEach(function (card) {
      var idx = parseInt(card.dataset.index, 10)
      var trigger = card.querySelector('.gallery-card__trigger')
      if (trigger) {
        trigger.addEventListener('click', function () {
          openMedia(idx, trigger)
        })
      }
    })

    function step(delta) {
      if (!visibleIndices.length) return
      var currentPos = visibleIndices.indexOf(activeIndex)
      var nextPos = (currentPos + delta + visibleIndices.length) % visibleIndices.length
      openMedia(visibleIndices[nextPos])
    }

    if (prevBtn) prevBtn.addEventListener('click', function () { step(-1) })
    if (nextBtn) nextBtn.addEventListener('click', function () { step(1) })

    if (dialog) {
      dialog.addEventListener('close', teardown)
      dialog.addEventListener('click', function (e) {
        if (e.target === dialog) dialog.close()
      })
    }

    if (closeBtn && dialog) {
      closeBtn.addEventListener('click', function () {
        if (typeof dialog.close === 'function') dialog.close()
        else {
          dialog.removeAttribute('open')
          teardown()
        }
      })
    }

    document.addEventListener('keydown', function (e) {
      if (dialog && dialog.open) {
        if (e.key === 'ArrowLeft') step(-1)
        if (e.key === 'ArrowRight') step(1)
      }
    })
  })()
</script>
