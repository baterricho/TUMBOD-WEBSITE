---
/**
 * Homepage body, locale-aware — civic-portal direction
 * (DECISION-redesign.md, 2026-08-05).
 *
 * THERE IS NOW A HERO. §12 and §35 forbade one until the owner retired that
 * rule. The ordering below is the compromise that keeps the site useful:
 *
 *   hero  →  office  →  actions  →  everything else
 *
 * ─────────────────────────────────────────────────────────────────
 * THE SEA BAND AND BOAT STRIP ARE GONE FROM HERE, 2026-08-07 (owner request).
 *
 * They used to sit directly under the hero as the page's first *fact*, bleeding
 * edge to edge in boat paint. Two things made that stop working:
 *
 *   1. Under the Deep Coastal Oceanic theme they were the only two full-bleed
 *      light slabs left on a near-black page — an amber band and a pale grey
 *      strip that read as a rendering fault rather than as emphasis.
 *   2. Almost everything in them was `[[NEEDS DATA]]`. Wind speed, route and
 *      departure time were all unfilled, so the loudest element on the
 *      homepage was mostly placeholder chips.
 *
 * THE READING ITSELF IS NOT GONE. It still lives in the Today mega panel,
 * which is in the header of every page and is where the sea state, the boat
 * and the office hours now sit together. The components are untouched and
 * still catalogued in /design-system, so putting the band back is one line.
 * ─────────────────────────────────────────────────────────────────
 *
 * Module order and the persona each serves: UX-STRATEGY.md §2.
 */
import Section from '@/components/Section.astro'
import Hero from '@/components/Hero.astro'
import Icon from '@/components/Icon.astro'
import SeaAdvisory from '@/components/SeaAdvisory.astro'
import WeatherMarineWidget from '@/components/WeatherMarineWidget.astro'
import WeatherMap from '@/components/WeatherMap.astro'
import InteractiveCrossingPlanner from '@/components/InteractiveCrossingPlanner.astro'
import InteractiveServiceCalculator from '@/components/InteractiveServiceCalculator.astro'
import { getSiteSettings } from '@/lib/content/live-collections'
import Placeholder from '@/components/Placeholder.astro'
import OfficeStatusBadge from '@/components/OfficeStatusBadge.astro'
import LastUpdated from '@/components/LastUpdated.astro'
import PhoneNumber from '@/components/PhoneNumber.astro'
import MonthCalendar from '@/components/MonthCalendar.astro'
import { getDictionary, type Locale, prefix } from '@/lib/i18n'
import { formatDate, isoAttr } from '@/lib/time'
import {
  officeHours,

  SERVICE_DETAILS,
  HEALTH_OUTREACH,
  STATS,
} from '@/lib/content/active'
import { isPlaceholder } from '@/lib/content/placeholder'
import { getHotlines, getProjects } from '@/lib/content/live-collections'
import { getNews, getUpcomingEvents } from '@/lib/content/articles'
import { articleHref } from '@/lib/content/sample-news'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
const settings = await getSiteSettings()
const p = prefix(locale)

const now = new Date()
const office = officeHours(formatDate(now))
const HOTLINES = (await getHotlines()).items

/* Database first, exactly like every other surface. Three strips on this page
   read permanently-empty arrays until 2026-08-07; see the note at module 5. */
const homeNews = (await getNews()).items.slice(0, 3)
const homeEvents = (await getUpcomingEvents()).items.slice(0, 4)
const PROJECTS = (await getProjects()).items

/*
 * Quick actions, rebuilt as CARDS (2026-08-06).
 *
 * These were four solid colour blocks — navy, red, gold, near-black — sitting
 * directly beneath a cinematic satellite hero. Each one was individually
 * defensible (colour + icon + label, every pair contrast-measured) and
 * together they were the worst adjacency on the site: a 2015 metro-tile grid
 * under a 2026 hero.
 *
 * The colour-coding rule is NOT retired. Every card still carries an icon and
 * a label, so colour is never the sole carrier (A11Y-PLAN.md §6). What changed
 * is that the colour is now a border and an icon wash rather than a full-bleed
 * fill, which lets four actions sit together without four saturated rectangles
 * fighting each other.
 *
 * The hotline card KEEPS the red treatment. It is the emergency path, it must
 * be findable under stress, and `.fcard--urgent` is reserved for exactly this.
 */
const quickActions = [
  {
    href: `${p}/serbisyo/barangay-clearance`,
    label: t.home.getClearance,
    icon: 'document',
    note: fil ? 'Requirements at bayad' : 'Requirements and fees',
    cls: '',
  },
  {
    href: `${p}/ligtas/hotline`,
    label: t.home.emergencyNumbers,
    icon: 'phone',
    note: fil ? 'Buong direktoryo' : 'Full directory',
    cls: ' fcard--urgent',
  },
  {
    href: `${p}/ligtas`,
    label: t.home.boatTrips,
    icon: 'bangka',
    note: fil ? 'Lagay ng dagat ngayon' : 'Sea conditions today',
    cls: ' fcard--accent',
  },
  {
    href: `${p}/hanapin`,
    label: t.home.search,
    icon: 'search',
    note: fil ? 'Buong site' : 'The whole site',
    cls: '',
  },
] as const

/**
 * Explore cards. The kicker text sits where a photograph will go once the
 * barangay supplies one with consent — it names what belongs there rather than
 * standing in for it with stock imagery (DECISION-redesign.md §3).
 */
const exploreCards = [
  {
    href: `${p}/kasaysayan`,
    kicker: fil ? 'Look ng Tuluran' : 'Tuluran Cove',
    image: '/media/tumbod-cove-1-thumb.jpg',
    title: fil ? 'Kasaysayan' : 'History',
    body: fil ? 'Paano nabuo ang barangay sa Pulo ng Tuluran.' : 'How the barangay formed on Tuluran Island.',
  },
  {
    href: `${p}/turismo`,
    kicker: fil ? 'Talon sa Baybayin' : 'Shoreline Falls',
    image: '/media/tumbod-falls-thumb.jpg',
    title: fil ? 'Turismo' : 'Tourism',
    body: fil ? 'Mga pasyalan at kung paano marating nang ligtas.' : 'Places to visit and how to reach them safely.',
  },
  {
    href: `${p}/proyekto`,
    kicker: fil ? 'Pantalan at Pondo' : 'Pier & Projects',
    image: '/media/tumbod-pantalan-thumb.jpg',
    title: fil ? 'Mga Proyekto' : 'Projects',
    body: fil ? 'Ano ang ginagawa, magkano, at saan galing ang pondo.' : 'What is being built, its cost, and its funding.',
  },
  {
    href: `${p}/opisyal`,
    kicker: fil ? 'Sangguniang Barangay' : 'Sangguniang Barangay',
    title: fil ? 'Mga Opisyal' : 'Officials',
    body: fil ? 'Sino ang naglilingkod, at hanggang kailan.' : 'Who serves, and until when.',
  },
  {
    href: `${p}/transparency`,
    kicker: fil ? 'Full Disclosure' : 'Full Disclosure',
    title: fil ? 'Transparency' : 'Transparency',
    body: fil ? 'Ang pitong dokumentong kailangan ng batas.' : 'The seven documents the law requires.',
  },
  {
    href: `${p}/larawan`,
    kicker: fil ? 'Bahura at Baybayin' : 'Reef & Coast',
    image: '/media/tumbod-cove-2-thumb.jpg',
    title: fil ? 'Mga Larawan' : 'Gallery',
    body: fil ? 'Tunay na larawan lamang ng Tumbod.' : 'Real photographs of Tumbod only.',
  },
]
---

{/* The hero owns the page's <h1> now, so the visually-hidden one is gone —
    two h1s would be a structure violation the a11y suite catches. */}
<Hero locale={locale} />

{/*
  Modules 1–3: the "today" answer. Still the first FACT on the page.

  THE CHART BAND IS GONE FROM HERE. `LivingChartHeader` — the island outline
  with the strait labels and the pulsing marker — used to sit directly under
  the hero. The hero now IS a map of the same island, at satellite resolution,
  with the same boundary drawn on it, so the chart repeated the one thing the
  reader had just seen and pushed the sea state (the first thing that actually
  changes day to day) another 400px down the page.

  It is unchanged and still in use on /kontak, where it is the only map on the
  page and answers "where is this place", and in the design-system catalogue.
*/}
<Section divider={false}>
  <div class="office">
    <OfficeStatusBadge hours={office} locale={locale} />
  </div>
</Section>

{/* Module 4: intent capture. */}
<Section title={t.home.quickActions} titleId="quick-actions">
  <ul class="grid-cards grid-cards--tight">
    {
      quickActions.map((a) => (
        <li>
          <a href={a.href} class={`fcard fcard--icon${a.cls}`} data-plain>
            <span class="fcard__icon">
              <Icon name={a.icon} size={20} />
            </span>
            <span class="fcard__text">
              <span class="fcard__title">{a.label}</span>
              <span class="fcard__body">{a.note}</span>
            </span>
            <span class="fcard__arrow" aria-hidden="true">
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Section>

{/*
  SEA SAFETY ADVISORY — placed here, above the emergency numbers, and that
  order is the argument.

  The hotline list answers "something has gone wrong, who do I call". The
  advisory answers "should I do the thing that would go wrong". Prevention
  outranks response, and this is the decision a fisherman or a boat operator
  makes before leaving the shore — several times a week, not once a crisis.

  It sits ABOVE the fold-adjacent emergency block and BELOW the quick actions,
  so the page reads: who we are, what you came to do, whether the sea will let
  you, and who to call if it does not.

  Full-bleed and outside <Section> on purpose: sections are a measured column,
  and this one spans the viewport like the band it replaces.
*/}
<SeaAdvisory advisory={settings.advisory} locale={locale} />

{/* Real-time Marine Weather & Sea Safety Warning Widget */}
<Section title={fil ? 'Panahon at Babala sa Paglalayag' : 'Marine Weather & Sea Travel Warning'} titleId="panahon-dagat">
  <WeatherMarineWidget locale={locale} />
</Section>

{/* Interactive Weather & Wind Map (Like the Windy Map) */}
<Section title={fil ? 'Mapa ng Hangin at Alon (Windy Radar)' : 'Interactive Wind & Sea Map (Windy Radar)'} titleId="mapa-hangin">
  <WeatherMap locale={locale} />
</Section>

{/* Interactive Crossing Planner for Island Residents & Boats */}
<Section title={fil ? 'Plano ng Paglalayag at Pagtawid sa Pulo' : 'Island Crossing & Strait Navigation'} titleId="crossing-guide">
  <InteractiveCrossingPlanner locale={locale} />
</Section>

{/* Module 7 promoted: emergency contacts now sit directly under the actions,
    in a bordered block, because they must be findable under stress. */}
<Section title={t.home.emergencyContacts} titleId="emergency-contacts">
  {/*
    The SAME card layout as everything else on this page, with one difference
    that is not cosmetic: these keep `.fcard--urgent`, so the badge and the
    link stay red. Red means emergency site-wide and this is the one place on
    the homepage it belongs.

    `PhoneNumber` still renders the number, so the `tel:` rules — no dialable
    sample numbers, plain text in demo mode, placeholder when missing — apply
    here exactly as they do on /ligtas/hotline. The card is NOT a link: making
    the whole thing dial would have meant duplicating that logic, and getting
    it wrong here is the worst bug this site can ship.
  */}
  <ul class="grid-cards">
    {
      HOTLINES.slice(0, 4).map((line) => (
        <li>
          <div class="fcard fcard--feature fcard--urgent">
            <span class="fcard__badge" aria-hidden="true">
              <Icon name="phone" size={24} />
            </span>
            <span class="fcard__title">{fil ? line.labelFil : line.labelEn}</span>
            <span class="fcard__body">
              <PhoneNumber number={line.number} locale={locale} large />
            </span>
          </div>
        </li>
      ))
    }
  </ul>
  <p style="margin-top:var(--space-4)">
    <a href={`${p}/ligtas/hotline`}>{t.home.fullDirectory} →</a>
  </p>
</Section>

{/* Module 6: next health outreach. Largest age band here is 5–9, so child
    health is not a minor module (RESEARCH.md §2.1). */}
{
  HEALTH_OUTREACH && (
    <Section title={t.home.nextHealth} titleId="health">
      <div class="card">
        <p style="font-family:var(--font-display);font-size:var(--text-xl)">
          {HEALTH_OUTREACH.titleFil}
        </p>
        <p class="figure" style="margin-top:var(--space-2)">
          {HEALTH_OUTREACH.date} · {HEALTH_OUTREACH.time}
        </p>
        <p class="muted">{HEALTH_OUTREACH.location} · {HEALTH_OUTREACH.provider}</p>
        <p style="margin-top:var(--space-2)">
          <strong>{t.home.bring}:</strong> {HEALTH_OUTREACH.bringFil}
        </p>
      </div>
    </Section>
  )
}

{/*
  Module 5: announcements.

  ─────────────────────────────────────────────────────────────────
  THIS READ `ANNOUNCEMENTS` FROM active.ts UNTIL 2026-08-07, and that export is
  `[]` outside demo mode. So the homepage news strip rendered its empty state
  permanently, while six announcements sat published in the database and the
  News mega panel — in the header of this very page — listed them.

  Found by marking the superseded exports `@deprecated`: the editor flagged
  three call sites here within a second of the annotation landing. That is the
  whole argument for ARCHITECTURE-REVIEW.md §3.1 in one file.
  ─────────────────────────────────────────────────────────────────
*/}
<Section title={t.home.announcements} titleId="announcements">
  <LastUpdated slot="aside" at={now} now={now} locale={locale} />
  {homeNews.length === 0 ? (
    <p class="muted" style="max-width:var(--measure)">{t.empty.announcements}</p>
  ) : (
    <ul class="grid-cards">
      {homeNews.map((a) => (
        <li>
          <a href={articleHref(a, locale)} class="fcard fcard--feature" data-plain>
            <span class="fcard__badge" aria-hidden="true">
              <Icon name="megaphone" size={24} />
            </span>
            <span class="fcard__title">{fil ? a.titleFil : a.titleEn}</span>
            {(fil ? a.leadFil : a.leadEn) && (
              <span class="fcard__body">{fil ? a.leadFil : a.leadEn}</span>
            )}
            <span class="fcard__meta">
              {fil ? a.categoryFil : a.categoryEn}
              {' · '}
              <time datetime={isoAttr(a.publishedAt)}>{formatDate(a.publishedAt)}</time>
            </span>
            <span class="fcard__more">
              {fil ? 'Basahin' : 'Learn more'}
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
  <p style="margin-top:var(--space-3)"><a href={`${p}/balita`}>{t.home.allAnnouncements} →</a></p>
</Section>

{/* Module 8: most requested documents — feature cards. */}
<Section title={t.home.commonDocuments} titleId="documents">
  <ul class="grid-cards">
    {
      SERVICE_DETAILS.slice(0, 6).map((s) => (
        <li>
          <a href={`${p}/serbisyo/${s.slug}`} class="fcard fcard--feature" data-plain>
            <span class="fcard__badge" aria-hidden="true">
              <Icon name="document" size={24} />
            </span>
            <span class="fcard__title">{fil ? s.nameFil : s.nameEn}</span>
            <span class="fcard__body">
              {fil ? s.descriptionFil : s.descriptionEn}
            </span>
            <span class="fcard__facts">
              <span class="fcard__fact">
                <span class="fcard__factlabel">{t.services.fee}</span>
                {isPlaceholder(s.fee) ? (
                  <Placeholder value={s.fee} />
                ) : (
                  <span class="figure">{s.fee}</span>
                )}
              </span>
            </span>
            <span class="fcard__more">
              {fil ? 'Alamin pa' : 'Learn more'}
              <Icon name="chevron-right" size={16} />
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p style="margin-top:var(--space-3)"><a href={`${p}/serbisyo`}>{fil ? 'Tingnan ang lahat ng serbisyo' : 'View all services'} →</a></p>

  {/* Interactive Calculator for Document Requirements and Legal Waivers */}
  <InteractiveServiceCalculator locale={locale} />
</Section>

{/*
  Module 9: calendar.

  A real month grid now, not a list of dates. The list is still there — beside
  the grid, where it answers "what is it" that a marked square cannot.
*/}
{
  homeEvents.length > 0 && (
    <Section title={t.home.calendar} titleId="calendar">
      <MonthCalendar locale={locale} events={homeEvents} />
    </Section>
  )
}

{/* Module 10: projects — transparency made visible on the homepage. */}
{
  PROJECTS.length > 0 && (
    <Section title={t.home.projects} titleId="projects">
      <ul class="grid-cards">
        {PROJECTS.map((proj) => (
          <li>
            <a href={`${p}/proyekto`} class="fcard fcard--feature" data-plain>
              <span class="fcard__badge" aria-hidden="true">
                <Icon name="checklist" size={24} />
              </span>
              <span class="fcard__title">{proj.title}</span>
              {/* Progress is stated as TEXT with the figure, never as a bar
                  alone — a bar carries meaning by length and colour only. */}
              <span class="fcard__body">
                <strong>{proj.status}</strong>
                <span class="figure"> · {proj.percent}%</span>
              </span>
              <span
                aria-hidden="true"
                style="height:6px;border-radius:var(--radius-full);background:var(--surface-sunken);overflow:hidden;display:block"
              >
                <span
                  style={`height:100%;display:block;width:${proj.percent}%;background:${
                    proj.percent === 100 ? 'var(--status-open)' : 'var(--accent)'
                  }`}
                />
              </span>
              <span class="fcard__facts">
                <span class="fcard__fact">
                  <span class="fcard__factlabel">{fil ? 'Badyet' : 'Budget'}</span>
                  <span class="figure">{proj.budget}</span>
                </span>
                <span class="fcard__fact">
                  <span class="fcard__factlabel">{fil ? 'Pondo' : 'Funded by'}</span>
                  <span>{proj.fund}</span>
                </span>
              </span>
              <span class="fcard__more">
                {fil ? 'Alamin pa' : 'Learn more'}
                <Icon name="chevron-right" size={16} />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </Section>
  )
}

{/* Explore — the card grid §35 forbade. Every destination here is a real
    route; none is a placeholder link. */}
<Section title={fil ? 'Tuklasin ang Tumbod' : 'Explore Tumbod'} titleId="explore">
  <div class="grid-cards">
    {
      exploreCards.map((c) => (
        <a class="fcard" href={c.href} data-reveal="pending">
          <div class="fcard__media" aria-hidden="true">
            {c.image && (
              <img src={c.image} alt="" class="fcard__media-thumb" loading="lazy" />
            )}
            <span class="fcard__media-badge">{c.kicker}</span>
          </div>
          <span class="fcard__title">{c.title}</span>
          <span class="fcard__meta">{c.body}</span>
        </a>
      ))
    }
  </div>
</Section>

{/* Module 13: "about us", now with the census figures alongside it.
    Every number is PSA-sourced — a stat row of invented counts is exactly the
    failure observed on brgy.to (PRECEDENT-SCAN.md §5). */}
<Section title={t.home.aboutHeading} titleId="about" tone="sunken">
  <div class="prose" style="margin-bottom:var(--space-4)">
    <p>{t.home.aboutBody}</p>
  </div>

  <div class="stats">
    {
      STATS.map((s) => (
        <div class="stat" data-reveal="pending">
          <p class="stat__value">{s.value}</p>
          <p class="stat__label">{fil ? s.labelFil : s.labelEn}</p>
          {/* The source is part of the figure, not a footnote. */}
          <p class="stat__note">{fil ? s.noteFil : s.noteEn}</p>
        </div>
      ))
    }
  </div>

  <p style="margin-top:var(--space-4)"><a href={`${p}/kasaysayan`}>{t.home.readHistory} →</a></p>
</Section>
