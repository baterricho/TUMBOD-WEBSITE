---
/**
 * Hotline directory view — instant category filter, keyword search,
 * 1-tap verified calling, and clipboard copy, with full zero-JS fallback
 * and >=44px mobile touch targets.
 */
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import Placeholder from '@/components/Placeholder.astro'
import { getDictionary, type Locale } from '@/lib/i18n'
import { getHotlines } from '@/lib/content/live-collections'
import { isPlaceholder } from '@/lib/content/placeholder'
import { IS_DEMO } from '@/lib/content/active'
import { formatDay } from '@/lib/time'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const HOTLINES = (await getHotlines()).items
const t = getDictionary(locale)
const fil = locale === 'fil'

const CATEGORY_ICON = {
  barangay: 'megaphone',
  disaster: 'warning',
  health: 'health',
  maritime: 'anchor',
  police: 'shield',
} as const

const CATEGORY_LABELS = [
  { id: 'all', fil: 'Lahat ng Hotline', en: 'All Hotlines' },
  { id: 'disaster', fil: 'BDRRMC at Saklolo', en: 'Disaster & Rescue' },
  { id: 'maritime', fil: 'Coast Guard & Pantalan', en: 'Coast Guard & Maritime' },
  { id: 'health', fil: 'Kalusugan & Ospital', en: 'Health & Ambulance' },
  { id: 'police', fil: 'Pulisya (PNP)', en: 'Police (PNP)' },
  { id: 'barangay', fil: 'Barangay Hall', en: 'Barangay Hall' },
]

const dialable = (n: string) => n.replace(/[^\d+]/g, '')
---

<Section divider={false} class="section--airy">
  <h1 class="page-title">{t.nav.emergencyLabel}</h1>
  <p class="section-lede">{t.safety.mayBeNewer}</p>

  <div class="hotline-controls">
    <div class="hotline-search-wrap">
      <label for="hotline-filter-input" class="sr-only">
        {fil ? 'Maghanap ng emergency contact' : 'Search emergency contact'}
      </label>
      <span class="hotline-search-icon" aria-hidden="true">
        <Icon name="search" size={18} />
      </span>
      <input
        type="search"
        id="hotline-filter-input"
        placeholder={fil ? 'Hanapin (hal. Coast Guard, Ambulansya, Pulis)...' : 'Quick search (e.g. Coast Guard, Ambulance, Police)...'}
        class="hotline-search-input"
      />
    </div>

    <div class="hotline-cat-pills" role="tablist" aria-label={fil ? 'Kategorya ng hotline' : 'Hotline categories'}>
      {
        CATEGORY_LABELS.map((cat, idx) => (
          <button
            type="button"
            class={`hotline-cat-btn${idx === 0 ? ' is-active' : ''}`}
            data-cat={cat.id}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
          >
            {fil ? cat.fil : cat.en}
          </button>
        ))
      }
    </div>
  </div>
</Section>

<Section>
  <ul class="hotgrid" id="hotgrid">
    {
      HOTLINES.map((line) => {
        const label = fil ? line.labelFil : line.labelEn
        const icon = CATEGORY_ICON[line.category] ?? 'phone'
        const missing = isPlaceholder(line.number)
        const callable = !missing && !IS_DEMO
        const rawNum = typeof line.number === 'string' ? line.number : ''

        const inner = (
          <>
            <span class="hotcard__icon" aria-hidden="true">
              <Icon name={icon} size={22} />
            </span>
            <span class="hotcard__body">
              <span class="hotcard__label">{label}</span>
              {missing ? (
                <Placeholder value={line.number} />
              ) : (
                <span class="hotcard__number figure">{line.number}</span>
              )}
              {line.verifiedAt && !missing && (
                <span class="hotcard__verified">
                  {fil ? 'Na-verify noong ' : 'Verified '}
                  <time datetime={line.verifiedAt.toISOString().slice(0, 10)}>
                    {formatDay(line.verifiedAt, locale)}
                  </time>
                </span>
              )}
            </span>
            <div class="hotcard__actions">
              {callable ? (
                <span class="hotcard__cta">
                  <Icon name="phone" size={16} />
                  {fil ? 'Tumawag' : 'Call now'}
                </span>
              ) : (
                <span class="hotcard__cta hotcard__cta--off">
                  {IS_DEMO ? 'Demo' : fil ? 'Wala pa' : 'Not yet'}
                </span>
              )}
              {!missing && (
                <button
                  type="button"
                  class="hotcard__copy-btn"
                  data-number={rawNum}
                  title={fil ? 'Kopyahin ang numero' : 'Copy phone number'}
                  aria-label={`${fil ? 'Kopyahin ang numero ng' : 'Copy phone number for'} ${label}`}
                >
                  <Icon name="copy" size={15} />
                  <span class="hotcard__copy-text">{fil ? 'Kopyahin' : 'Copy'}</span>
                </button>
              )}
            </div>
          </>
        )

        return (
          <li class="hotgrid__item" data-category={line.category} data-label={label.toLowerCase()}>
            {callable ? (
              <a class="hotcard" href={`tel:${dialable(line.number as string)}`} data-plain>
                {inner}
              </a>
            ) : (
              <div class="hotcard hotcard--missing">{inner}</div>
            )}
          </li>
        )
      })
    }
  </ul>

  <div id="hotline-empty-msg" class="empty-state hotline-empty" hidden>
    <p class="empty-state__title">
      {fil ? 'Walang nahanap na numero' : 'No matching emergency contacts'}
    </p>
    <p class="empty-state__desc">
      {fil
        ? 'Subukan ang ibang salita o ipakita muli ang lahat ng kategorya.'
        : 'Try another search keyword or reset the category filter.'}
    </p>
    <button type="button" class="btn btn--secondary btn--sm" id="hotline-reset-btn">
      {fil ? 'Ipakita ang lahat ng hotline' : 'Show all hotlines'}
    </button>
  </div>
</Section>

<style>
  .hotline-controls {
    margin-top: var(--space-4);
    display: grid;
    gap: var(--space-3);
  }

  .hotline-search-wrap {
    position: relative;
    display: flex;
    align-items: center;
    max-width: var(--measure);
  }

  .hotline-search-icon {
    position: absolute;
    left: var(--space-3);
    color: var(--ink-muted);
    pointer-events: none;
    display: inline-flex;
  }

  .hotline-search-input {
    padding-left: calc(var(--space-4) + 20px) !important;
  }

  .hotline-cat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .hotline-cat-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: var(--r-inner);
    border: 1px solid var(--line);
    background: var(--surface-raised);
    color: var(--ink-strong);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    cursor: pointer;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .hotline-cat-btn:hover {
    border-color: var(--interactive);
    color: var(--interactive);
  }

  /* High contrast in both light and dark modes */
  .hotline-cat-btn.is-active {
    background: var(--action);
    color: var(--action-ink);
    border-color: var(--action-edge);
  }

  .hotcard__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: auto;
    flex-wrap: wrap;
  }

  .hotcard__copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    min-height: 44px;
    padding: 6px 12px;
    border-radius: var(--r-inner);
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink-strong);
    font-size: var(--text-xs);
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
    z-index: 2;
  }

  .hotcard__copy-btn:hover {
    background: var(--surface-sunken);
    border-color: var(--interactive);
    color: var(--interactive);
  }

  .hotcard__copy-btn.is-copied {
    background: var(--status-open-surface);
    border-color: var(--status-open-border);
    color: var(--status-open-ink);
  }

  .hotline-empty {
    margin-top: var(--space-4);
  }

  @media (max-width: 36rem) {
    .hotcard__actions {
      width: 100%;
    }

    .hotcard__actions > .hotcard__cta,
    .hotcard__actions > .hotcard__copy-btn {
      flex: 1;
      justify-content: center;
    }
  }
</style>

<script is:inline define:vars={{ fil }}>
  ;(function () {
    var input = document.getElementById('hotline-filter-input')
    var catBtns = [].slice.call(document.querySelectorAll('.hotline-cat-btn'))
    var items = [].slice.call(document.querySelectorAll('.hotgrid__item'))
    var emptyMsg = document.getElementById('hotline-empty-msg')
    var resetBtn = document.getElementById('hotline-reset-btn')
    var copyBtns = [].slice.call(document.querySelectorAll('.hotcard__copy-btn'))

    var activeCat = 'all'

    function filter() {
      var q = (input ? input.value : '').toLowerCase().trim()
      var visible = 0

      items.forEach(function (item) {
        var cat = item.dataset.category
        var label = item.dataset.label || ''
        var matchesCat = activeCat === 'all' || cat === activeCat
        var matchesQuery = !q || label.indexOf(q) !== -1
        var show = matchesCat && matchesQuery
        item.hidden = !show
        if (show) visible++
      })

      if (emptyMsg) emptyMsg.hidden = visible > 0
    }

    if (input) input.addEventListener('input', filter)

    catBtns.forEach(function (btn) {
      btn.addEventListener('click', function () {
        catBtns.forEach(function (b) {
          b.classList.remove('is-active')
          b.setAttribute('aria-selected', 'false')
        })
        btn.classList.add('is-active')
        btn.setAttribute('aria-selected', 'true')
        activeCat = btn.dataset.cat || 'all'
        filter()
      })
    })

    if (resetBtn) {
      resetBtn.addEventListener('click', function () {
        if (input) input.value = ''
        activeCat = 'all'
        catBtns.forEach(function (b, idx) {
          b.classList.toggle('is-active', idx === 0)
          b.setAttribute('aria-selected', idx === 0 ? 'true' : 'false')
        })
        filter()
        if (input) input.focus()
      })
    }

    copyBtns.forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault()
        e.stopPropagation()
        var num = btn.dataset.number
        if (!num || !navigator.clipboard || !navigator.clipboard.writeText) return

        navigator.clipboard
          .writeText(num)
          .then(function () {
            var labelSpan = btn.querySelector('.hotcard__copy-text')
            if (!labelSpan) return
            var origText = labelSpan.textContent
            labelSpan.textContent = fil ? 'Nakopya' : 'Copied'
            btn.classList.add('is-copied')
            setTimeout(function () {
              labelSpan.textContent = origText
              btn.classList.remove('is-copied')
            }, 2000)
          })
          .catch(function () {})
      })
    })
  })()
</script>
