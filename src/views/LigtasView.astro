---
/**
 * LigtasView — Disaster preparedness, live maritime warnings, fishermen safety,
 * evacuation sites, and offline-ready emergency instructions.
 */
import Section from '@/components/Section.astro'
import Alert from '@/components/Alert.astro'
import Icon from '@/components/Icon.astro'
import Placeholder from '@/components/Placeholder.astro'
import FishermanWeatherSafety from '@/components/FishermanWeatherSafety.astro'
import RealtimeWeatherWarningBanner from '@/components/RealtimeWeatherWarningBanner.astro'
import EmergencyContactDirectory from '@/components/EmergencyContactDirectory.astro'
import { getDictionary, type Locale, prefix } from '@/lib/i18n'
import { CHECKLIST as TYPHOON_CHECKLIST, EVACUATION_SITES } from '@/lib/content/active'
import { isPlaceholder } from '@/lib/content/placeholder'
import { fetchLiveMarineWeather } from '@/lib/weather'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
const p = prefix(locale)

const report = await fetchLiveMarineWeather()
const cur = report.current
const alertLevel =
  cur.safetyLevel === 'danger' ? 'emergency' : cur.safetyLevel === 'caution' ? 'warning' : 'info'
---

<Section divider={false} class="section--airy">
  <RealtimeWeatherWarningBanner locale={locale} report={report} />

  <div class="safety-page-header">
    <span class="chip chip--danger">
      <Icon name="shield" size={14} />
      <span>{fil ? 'BDRRMC at Kaligtasan sa Tuluran' : 'BDRRMC & Tuluran Island Disaster Safety'}</span>
    </span>
    <h1 class="page-title">{t.safety.title}</h1>
    <p class="section-lede">
      {fil
        ? 'Opisyal na impormasyon sa kaligtasan, real-time na babala sa panahon at alon para sa mga mangingisda at mamamayan, lilikasan sa bagyo, at mga numerong matatawagan sa saklolo.'
        : 'Official safety portal: real-time weather and sea warnings for fishermen and island residents, typhoon storm surge evacuation zones, and emergency rescue hotlines.'}
    </p>
  </div>
</Section>

<Section title={t.safety.currentStatus} titleId="status" divider={false}>
  <Alert level={alertLevel} locale={locale}>
    <strong>
      {cur.safetyLevel === 'danger'
        ? fil ? 'MAY MATINDING BABALA SA PAGLALAYAG (GALE / STORM ADVISORY)' : 'SEVERE MARITIME WARNING (GALE / STORM ADVISORY)'
        : cur.safetyLevel === 'caution'
          ? fil ? 'MAY PAALALA: KATAMTAMANG ALON AT CHOP SA KIPOT' : 'ADVISORY: MODERATE SWELL & CHANNEL CHOP'
          : fil ? 'NORMAL NA KALAGAYAN: LIGTAS ANG KARAGATAN' : 'NORMAL CONDITIONS: WATERS GENERALLY CALM'}
    </strong>
    <br />
    {fil ? cur.safetyExplanationFil : cur.safetyExplanationEn}
  </Alert>
  <p class="safety-note">{t.safety.mayBeNewer}</p>
</Section>

<Section
  title={fil ? 'Kasalukuyang Datos ng Dagat at Hangin' : 'Live Marine Sea & Wind Snapshot'}
  titleId="telemetry"
  divider={true}
>
  <div class="emergency-telemetry-card">
    <div class="telemetry-snapshot-grid">
      <div class="telemetry-snap-item">
        <span class="telemetry-snap-label">{fil ? 'Taas ng Alon' : 'Wave Height'}</span>
        <strong
          class={`telemetry-snap-val figure ${cur.waveHeightM > 1.2 ? 'telemetry-snap-val--danger' : 'telemetry-snap-val--calm'}`}
        >
          {cur.waveHeightM} m
        </strong>
        <span class="telemetry-snap-sub">{fil ? cur.waveStateFil : cur.waveStateEn}</span>
      </div>
      <div class="telemetry-snap-item">
        <span class="telemetry-snap-label">{fil ? 'Bilis ng Hangin' : 'Wind Speed'}</span>
        <strong class="telemetry-snap-val figure">{cur.windSpeedKph} km/h</strong>
        <span class="telemetry-snap-sub">
          {fil ? cur.windCardinalFil : cur.windCardinal} ({cur.windDirectionDeg}°)
        </span>
      </div>
      <div class="telemetry-snap-item">
        <span class="telemetry-snap-label">{fil ? 'Temperatura' : 'Temperature'}</span>
        <strong class="telemetry-snap-val figure">{cur.temperature}°C</strong>
        <span class="telemetry-snap-sub">{fil ? cur.weatherDescFil : cur.weatherDescEn}</span>
      </div>
    </div>
    <div class="telemetry-snapshot-cta">
      <a href={`${p}/panahon`} class="btn btn--primary" data-plain>
        <Icon name="wind" size={16} />
        <span>
          {fil ? 'Buksan ang Kumpletong Live Radar at Mapa ng Panahon' : 'Open Full Weather Chart & Live Radar'}
        </span>
        <Icon name="chevron-right" size={16} />
      </a>
    </div>
  </div>
</Section>

<Section
  title={fil ? 'Babala sa Panahon at Kaligtasan ng mga Mangingisda' : 'Fishermen Weather Warnings & Maritime Directives'}
  titleId="mangingisda-safety"
  divider={true}
>
  <FishermanWeatherSafety locale={locale} report={report} />
</Section>

<Section title={t.safety.callNow} titleId="hotlines" divider={true}>
  <EmergencyContactDirectory locale={locale} />
</Section>

<Section title={t.safety.whereToEvacuate} titleId="evacuation">
  <div class="evac-list">
    {
      EVACUATION_SITES.map((site) => (
        <div class="card">
          {isPlaceholder(site.name) ? (
            <Placeholder value={site.name} display="block" />
          ) : (
            <>
              <p class="card__title">{site.name}</p>
              <p class="small muted">
                {!isPlaceholder(site.purok) && <span>{t.safety.purok}: {site.purok}</span>}
                {!isPlaceholder(site.capacity) && (
                  <span> · {t.safety.capacity}: <span class="figure">{site.capacity}</span></span>
                )}
              </p>
              {!isPlaceholder(site.accessNoteFil) && <p class="evac-note">{site.accessNoteFil}</p>}
              {!isPlaceholder(site.contactPerson) && (
                <p class="small muted evac-contact">{site.contactPerson}</p>
              )}
            </>
          )}
        </div>
      ))
    }
    {
      EVACUATION_SITES.some((s) => isPlaceholder(s.name)) && (
        <p class="muted small">{t.safety.evacuationIncomplete}</p>
      )
    }
  </div>
</Section>

<Section title={t.safety.beforeTyphoon} titleId="checklist">
  <ul class="typhoon-checklist list-reset">
    {
      TYPHOON_CHECKLIST.map((item) => (
        <li class="typhoon-checklist__item">
          <span class="typhoon-checklist__box" aria-hidden="true"></span>
          <span>{fil ? item.labelFil : item.labelEn}</span>
        </li>
      ))
    }
  </ul>
</Section>

<Section title={t.safety.seaTravel} titleId="sea-travel">
  <p class="is-water prose-line">{t.safety.coastGuardRule}</p>
</Section>

<Section title={t.safety.noSignal} titleId="no-signal">
  <ul class="no-signal-list">
    <li>
      <strong>{fil ? 'Radyong De-Baterya:' : 'Battery-Powered Radio:'}</strong>{' '}
      {fil ? 'Makinig sa mga ulat panahon mula sa PAGASA at mga lokal na istasyon sa Palawan.' : 'Tune in to regional disaster and PAGASA bulletins on AM/FM frequencies.'}
    </li>
    <li>
      <strong>{fil ? 'Bandillo at Tambuli ng Purok:' : 'Purok Bandillo & Megaphone System:'}</strong>{' '}
      {fil ? 'Mag-iikot ang mga Barangay Tanod at BDRRMC responders sa mga purok dala ang megafone upang maghatid ng opisyal na abiso at direktiba.' : 'Barangay Tanods and BDRRMC responders conduct house-to-house warnings via megaphone and traditional tambuli.'}
    </li>
    <li>
      <strong>{fil ? 'VHF Two-Way Marine Radio:' : 'VHF Two-Way Marine Radio:'}</strong>{' '}
      {fil ? 'Nananatiling bukas ang radyong pang-komunikasyon sa Barangay Hall (VHF Ch. 16) direkta sa Coast Guard Sub-station at MDRRMO Taytay.' : 'The Barangay Command Post maintains direct two-way radio link (VHF Ch. 16) with PCG Sub-station and MDRRMO Taytay.'}
    </li>
    <li>
      <strong>{fil ? 'Sirena ng Sapilitang Paglikas:' : 'Evacuation Siren & Bell:'}</strong>{' '}
      {fil ? 'Ang tuloy-tuloy na tunog ng sirena sa Barangay Hall at Paaralan ay hudyat ng agarang paglikas paakyat sa mataas na gulod sa banta ng daluyong (storm surge).' : 'Continuous siren sounding at the Barangay Hall or School signals immediate mandatory evacuation to higher ground.'}
    </li>
    <li>
      <strong>{fil ? 'Pumunta sa Barangay Hall:' : 'Proceed to Barangay Hall:'}</strong>{' '}
      {fil ? 'Kung ligtas ang daan, magtungo sa Barangay Hall o evacuation center para sa beripikadong impormasyon at tulong.' : 'If pathways are safe, proceed directly to the Barangay Hall or designated evacuation center.'}
    </li>
  </ul>
  <p class="safety-cta-row">
    <a href={`${p}/ligtas/hotline`}>{t.nav.emergencyLabel} →</a>
  </p>
</Section>

<style>
  .safety-page-header {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .safety-note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .emergency-telemetry-card {
    padding: var(--space-5);
    border: 1px solid var(--line);
    border-inline-start: 3px solid var(--accent);
    background: var(--surface-raised);
    border-radius: var(--r-card);
    box-shadow: var(--shadow-sm);
    display: grid;
    gap: var(--space-4);
  }

  .telemetry-snapshot-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(12rem, 100%), 1fr));
    gap: var(--space-3);
  }

  .telemetry-snap-item {
    padding: var(--space-3);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    display: grid;
    gap: 4px;
  }

  .telemetry-snap-label {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .telemetry-snap-val {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--ink-strong);
  }

  .telemetry-snap-val--danger {
    color: var(--alert-emergency-on-surface);
  }

  .telemetry-snap-val--calm {
    color: var(--interactive);
  }

  .telemetry-snap-sub {
    font-size: var(--text-xs);
    color: var(--ink-muted);
  }

  .telemetry-snapshot-cta {
    border-top: 1px solid var(--line);
    padding-top: var(--space-3);
  }

  .evac-list {
    display: grid;
    gap: var(--space-3);
    max-width: var(--measure);
  }

  .evac-note {
    margin-top: var(--space-2);
  }

  .evac-contact {
    margin-top: var(--space-1);
  }

  .typhoon-checklist {
    display: grid;
    gap: var(--space-2);
    max-width: var(--measure);
  }

  .typhoon-checklist__item {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    min-height: 44px;
    padding: var(--space-2) var(--space-3);
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
  }

  .typhoon-checklist__box {
    width: 18px;
    height: 18px;
    margin-top: 3px;
    border: 1.5px solid var(--line-strong);
    border-radius: 4px;
    flex-shrink: 0;
  }

  .prose-line {
    max-width: var(--measure);
  }

  .no-signal-list {
    padding-inline-start: var(--space-5);
    max-width: var(--measure);
    line-height: 1.65;
    display: grid;
    gap: var(--space-3);
  }

  .safety-cta-row {
    margin-top: var(--space-4);
  }
</style>
