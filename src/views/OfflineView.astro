---
/**
 * Offline fallback body, locale-aware.
 *
 * Never a dead end and never an apology (§13.8). Lists what IS available
 * offline, with working links, so someone who lost signal mid-task still
 * reaches the hotline directory.
 */
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import { getDictionary, type Locale, prefix } from '@/lib/i18n'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const fil = locale === 'fil'
const p = prefix(locale)

const available = [
  { href: `${p}/ligtas/hotline`, label: t.nav.emergencyLabel },
  { href: `${p}/ligtas`, label: t.safety.title },
  { href: p || '/', label: t.home.title },
]
---

<Section divider={false}>
  <p class="offline-kicker">
    <Icon name="offline" size={18} />
    <span>{fil ? 'Walang koneksyon ngayon.' : 'No connection right now.'}</span>
  </p>
  <h1 class="page-title offline-title">
    {fil ? 'May magagamit ka pa rin' : 'You can still use these'}
  </h1>
  <p class="section-lede offline-lede">
    {
      fil
        ? 'Ang mga pahinang ito ay naka-save na sa telepono mo. Bubuksan ang mga ito kahit walang signal.'
        : 'These pages are already saved on your phone. They will open with no signal.'
    }
  </p>
</Section>

<Section>
  <ul class="offline-list card" role="list">
    {
      available.map((item) => (
        <li class="offline-item">
          <a href={item.href} class="offline-link">
            <span>{item.label}</span>
            <span class="offline-arrow" aria-hidden="true">→</span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="offline-note">
    {
      fil
        ? 'Ang mga numerong nakikita mo ay ang huling nakuha. Kung may bagyo o emergency, tumawag pa rin — baka may mas bago nang abiso.'
        : 'The numbers you see are the last ones saved. During a typhoon or emergency, call anyway — there may be a newer advisory.'
    }
  </p>
</Section>

<style>
  .offline-kicker {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-muted);
    margin: 0;
  }
  .offline-title {
    margin-top: var(--space-2);
  }
  .offline-lede {
    margin-top: var(--space-3);
  }
  .offline-list {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    max-width: var(--measure);
  }
  .offline-item + .offline-item {
    border-top: 1px solid var(--line);
  }
  .offline-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 56px;
    padding: 0 var(--space-4);
    font-weight: 600;
    color: var(--ink-strong);
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }
  .offline-link:hover {
    background: var(--surface-sunken);
    color: var(--interactive);
  }
  .offline-arrow {
    color: var(--ink-muted);
  }
  .offline-note {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--ink-muted);
    max-width: var(--measure);
    line-height: var(--leading-body);
  }
</style>
