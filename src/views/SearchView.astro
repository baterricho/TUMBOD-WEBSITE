---
/**
 * Site search view, locale-aware.
 *
 * Works progressively: with JavaScript off, renders the complete directory
 * of all services, emergency contacts, and governance documents.
 * With JavaScript on, delivers instant search with URL `?q=` hydration,
 * suggestion chips, accessible category filters, live match highlights,
 * and an actionable empty state.
 */
import Section from '@/components/Section.astro'
import Icon from '@/components/Icon.astro'
import { getDictionary, type Locale, prefix } from '@/lib/i18n'
import { SERVICE_DETAILS } from '@/lib/content/active'
import { getHotlines } from '@/lib/content/live-collections'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const fil = locale === 'fil'
const p = prefix(locale)
const HOTLINES = (await getHotlines()).items
const t = getDictionary(locale)

const SUGGESTIONS = fil
  ? ['Barangay Clearance', 'Hotline', 'Bangka', 'Indigency', 'Opisyal', 'Talon', 'Health Station', 'Transparency']
  : ['Barangay Clearance', 'Hotline', 'Boat', 'Indigency', 'Officials', 'Health Station', 'Transparency', 'Weather']

const groups = [
  {
    heading: t.nav.safety,
    category: 'ligtas',
    links: [
      {
        href: `${p}/ligtas/hotline`,
        label: t.nav.emergencyLabel,
        desc: fil
          ? 'Mga numerong matatawagan para sa ambulansya, bumbero, at saklolo.'
          : 'Verified emergency numbers for barangay response, Coast Guard, and RHU.',
      },
      {
        href: `${p}/ligtas`,
        label: t.safety.title,
        desc: fil
          ? 'Lagay ng dagat, babala sa bagyo, at ligtas na paglalayag.'
          : 'Sea state, typhoon readiness, evacuation centers, and marine safety.',
      },
      {
        href: `${p}/panahon`,
        label: fil ? 'Panahon at Dagat' : 'Weather & Sea',
        desc: fil
          ? 'Live na ulat ng alon, hangin, radar, at 7-araw na pagtataya.'
          : 'Live wave height, wind gusts, local marine chart, and 7-day forecast.',
      },
    ],
  },
  {
    heading: t.services.title,
    category: 'serbisyo',
    links: SERVICE_DETAILS.map((s) => ({
      href: `${p}/serbisyo/${s.slug}`,
      label: fil ? s.nameFil : s.nameEn,
      desc: fil ? s.descriptionFil : s.descriptionEn,
    })),
  },
  {
    heading: t.nav.more,
    category: 'pamamahala',
    links: [
      {
        href: `${p}/opisyal`,
        label: t.nav.officials,
        desc: fil
          ? 'Punong Barangay at mga Kagawad ng Sangguniang Barangay.'
          : 'Punong Barangay, Sangguniang Barangay councilors, SK, and staff.',
      },
      {
        href: `${p}/transparency`,
        label: t.nav.transparency,
        desc: fil
          ? 'Badyet, pondo, at mga pampublikong ulat ng pamahalaan.'
          : 'Public budget, procurement notices, projects, and barangay ordinances.',
      },
      {
        href: `${p}/balita`,
        label: t.nav.news,
        desc: fil
          ? 'Pinakahuling anunsyo at ulat sa komunidad.'
          : 'Latest barangay advisories and community announcements.',
      },
      {
        href: `${p}/tungkol`,
        label: t.nav.about,
        desc: fil
          ? 'Kasaysayan at heograpiya ng Pulo ng Tuluran.'
          : 'Geography, population, and history of Tuluran Island.',
      },
      {
        href: `${p}/larawan`,
        label: fil ? 'Mga Larawan at Video' : 'Photos & Videos',
        desc: fil
          ? 'Tunay na kuha ng baybayin, talon, at pantalan.'
          : 'Field photography and video of shorelines, waterfalls, and ports.',
      },
      {
        href: `${p}/kontak`,
        label: t.nav.contact,
        desc: fil
          ? 'Barangay Hall address at mga opisyal na channel.'
          : 'Barangay Hall hours, location, and how to reach the island.',
      },
    ],
  },
]

const categoryLabels = {
  all: fil ? 'Lahat' : 'All',
  serbisyo: fil ? 'Serbisyo' : 'Services',
  ligtas: fil ? 'Ligtas' : 'Safety',
  pamamahala: fil ? 'Pamamahala' : 'Governance',
  komunidad: fil ? 'Komunidad' : 'Community',
}
---

<Section divider={false} class="section--airy">
  <h1 class="page-title">{t.home.search}</h1>
  <p class="section-lede search-lede">
    {
      fil
        ? 'Mabilisang hanapin ang mga serbisyo, requirements, opisyal, emergency hotlines, at anunsyo sa buong isla.'
        : 'Quickly find barangay services, requirements, officials, emergency hotlines, and island advisories.'
    }
  </p>

  <form
    role="search"
    class="search-form"
    action={`${p}/hanapin`}
    method="get"
    data-search-form
    data-locale={locale}
    data-prefix={p}
    data-lbl-found={fil ? '{n} resulta para sa "{q}"' : '{n} results for "{q}"'}
    data-lbl-empty={fil ? 'Walang nahanap para sa "{q}". Subukan ang ibang salita.' : 'No matches found for "{q}". Try another keyword.'}
    data-lbl-loading={fil ? 'Naghahanap...' : 'Searching...'}
    data-lbl-reset={fil ? 'Burahin ang filter' : 'Clear search'}
    data-cat-labels={JSON.stringify(categoryLabels)}
  >
    <div class="search-input-wrap">
      <label class="sr-only" for="q">
        {fil ? 'Ano ang hinahanap mo?' : 'What are you looking for?'}
      </label>
      <span class="search-icon-left" aria-hidden="true">
        <Icon name="search" size={18} />
      </span>
      <input
        id="q"
        name="q"
        type="search"
        autocomplete="off"
        placeholder={
          fil
            ? 'I-type ang hinahanap (hal. clearance, hotline, bangka)...'
            : 'Type to search (e.g. clearance, hotline, boat)...'
        }
        class="search-input"
      />
      <button
        type="button"
        id="q-clear"
        class="search-clear-btn"
        aria-label={fil ? 'Burahin ang nilagay' : 'Clear query'}
        hidden
      >
        <Icon name="close" size={16} />
      </button>
    </div>

    <div class="search-suggestions" aria-label={fil ? 'Mga mungkahi' : 'Suggested queries'}>
      <span class="search-suggestions-label">{fil ? 'Mungkahi:' : 'Try:'}</span>
      {SUGGESTIONS.map((sug) => (
        <button type="button" class="suggestion-chip" data-query={sug}>
          {sug}
        </button>
      ))}
    </div>

    <p id="q-status" role="status" aria-live="polite" class="search-status"></p>
  </form>
</Section>

{/* Results container (revealed by JS when user searches) */}
<Section title={fil ? 'Resulta ng Paghahanap' : 'Search Results'} titleId="results" divider={false}>
  <div id="results-wrapper" hidden>
    <div class="search-category-filters" id="search-category-filters" role="group" aria-label={fil ? 'Kategorya ng resulta' : 'Result categories'}>
      <button type="button" class="search-filter-pill is-active" data-cat="all" aria-pressed="true">{categoryLabels.all}</button>
      <button type="button" class="search-filter-pill" data-cat="serbisyo" aria-pressed="false">{categoryLabels.serbisyo}</button>
      <button type="button" class="search-filter-pill" data-cat="ligtas" aria-pressed="false">{categoryLabels.ligtas}</button>
      <button type="button" class="search-filter-pill" data-cat="pamamahala" aria-pressed="false">{categoryLabels.pamamahala}</button>
    </div>
    <ul id="results-list" class="results-grid" role="list"></ul>
    <div id="results-empty" class="empty-state" hidden>
      <p class="empty-state__title">{fil ? 'Walang tumugmang resulta' : 'No matching pages found'}</p>
      <p class="empty-state__body">
        {
          fil
            ? 'Subukan ang mas maikling salita tulad ng "clearance", "hotline", o "bangka", o tingnan ang kumpletong direktoryo sa ibaba.'
            : 'Try a shorter keyword like "clearance", "hotline", or "boat", or browse the full directory below.'
        }
      </p>
      <button type="button" class="btn btn--secondary btn--sm" id="results-reset-btn">
        {fil ? 'Burahin ang paghahanap' : 'Reset search'}
      </button>
    </div>
  </div>
</Section>

{/* Complete directory fallback — accessible to everyone with JS off or empty query */}
<Section title={fil ? 'Direktoryo ng Lahat ng Pahina' : 'Complete Page Directory'} titleId="all-pages">
  <div class="directory-groups">
    {
      groups.map((group) => (
        <div class="directory-group card">
          <h2 class="directory-heading">{group.heading}</h2>
          <ul class="directory-list" role="list">
            {group.links.map((link) => (
              <li class="directory-item">
                <a href={link.href} class="directory-link">
                  <span class="directory-link-title">{link.label}</span>
                  {link.desc && <span class="directory-link-desc">{link.desc}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="directory-hotline-bar card">
    <p class="directory-hotline-text">
      <Icon name="phone" size={18} />
      <span>
        {
          fil
            ? `${HOTLINES.length} numerong pang-emergency sa `
            : `${HOTLINES.length} emergency numbers in the `
        }
        <a href={`${p}/ligtas/hotline`}>
          {fil ? 'direktoryo ng hotline' : 'hotline directory'}
        </a>.
      </span>
    </p>
  </div>
</Section>

<style>
  .search-lede {
    margin-top: var(--space-2);
  }

  .search-form {
    max-width: var(--measure);
    margin-top: var(--space-4);
  }

  .search-input-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .search-icon-left {
    position: absolute;
    left: var(--space-3);
    color: var(--ink-muted);
    pointer-events: none;
    display: flex;
    align-items: center;
  }

  .search-input {
    width: 100%;
    min-height: 48px;
    font-family: inherit;
    font-size: var(--text-base);
    padding: 0 48px 0 42px;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-inner);
    background: var(--surface-raised);
    color: var(--ink-strong);
    box-shadow: var(--shadow-sm);
    transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
  }

  .search-input::placeholder {
    color: var(--ink-muted);
  }

  .search-input:focus {
    outline: none;
    border-color: var(--interactive);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--focus-ring) 28%, transparent);
  }

  .search-clear-btn {
    position: absolute;
    right: 4px;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: none;
    color: var(--ink-muted);
    cursor: pointer;
    border-radius: var(--r-inner);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .search-clear-btn:hover {
    background: var(--surface-sunken);
    color: var(--ink-strong);
  }

  .search-suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-3);
  }

  .search-suggestions-label {
    font-size: var(--text-xs);
    color: var(--ink-muted);
    font-weight: 600;
    margin-right: 2px;
  }

  .suggestion-chip {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-inner);
    min-height: 36px;
    padding: 0 10px;
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--ink);
    cursor: pointer;
    font-family: inherit;
    transition: border-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard);
  }

  .suggestion-chip:hover {
    background: var(--interactive-surface);
    border-color: var(--interactive);
    color: var(--interactive);
  }

  .search-status {
    margin: var(--space-2) 0 0;
    min-height: 1.4em;
    font-size: var(--text-sm);
    color: var(--ink-muted);
  }

  .search-category-filters {
    display: flex;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
    flex-wrap: wrap;
  }

  .search-filter-pill {
    background: var(--surface-raised);
    border: 1px solid var(--line-strong);
    border-radius: var(--r-inner);
    min-height: 38px;
    padding: 0 12px;
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--ink-muted);
    cursor: pointer;
    transition: border-color var(--motion-fast) var(--ease-standard), background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .search-filter-pill:hover {
    border-color: var(--interactive);
    color: var(--ink-strong);
  }

  .search-filter-pill.is-active {
    background: var(--action);
    color: var(--action-ink);
    border-color: var(--action);
  }

  .results-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(18rem, 100%), 1fr));
    gap: var(--space-3);
  }

  .results-grid :global(.result-card) {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--ink);
    height: 100%;
    transition: border-color var(--motion-fast) var(--ease-standard), box-shadow var(--motion-fast) var(--ease-standard);
  }

  .results-grid :global(.result-card:hover),
  .results-grid :global(.result-card:focus-visible) {
    border-color: var(--interactive);
    box-shadow: var(--shadow-sm);
  }

  .results-grid :global(.result-card-badge) {
    display: inline-flex;
    align-self: flex-start;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    padding: 2px 8px;
    border-radius: var(--radius-sm);
    background: var(--interactive-surface);
    border: 1px solid var(--interactive-border);
    color: var(--interactive);
    margin-bottom: var(--space-2);
  }

  .results-grid :global(.result-card-title) {
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink-strong);
    margin: 0 0 4px;
    line-height: 1.3;
  }

  .results-grid :global(.result-card:hover .result-card-title) {
    color: var(--interactive);
  }

  .results-grid :global(.result-card-desc) {
    font-size: var(--text-sm);
    color: var(--ink-muted);
    margin: 0;
    line-height: var(--leading-body);
  }

  .results-grid :global(.highlight) {
    background: var(--alert-advisory-surface);
    color: var(--alert-advisory-ink);
    font-weight: 700;
    border-radius: 3px;
    padding: 0 2px;
  }

  .directory-groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(20rem, 100%), 1fr));
    gap: var(--space-4);
  }

  .directory-group {
    padding: var(--space-4);
  }

  .directory-heading {
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink-strong);
    margin: 0 0 var(--space-3);
    border-bottom: 1px solid var(--line);
    padding-bottom: var(--space-2);
  }

  .directory-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .directory-link {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 44px;
    padding: 6px 8px;
    margin: 0 -8px;
    border-radius: var(--r-inner);
    text-decoration: none;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .directory-link:hover {
    background: var(--surface-sunken);
  }

  .directory-link-title {
    display: block;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--interactive);
  }

  .directory-link-desc {
    display: block;
    font-size: var(--text-xs);
    color: var(--ink-muted);
    margin-top: 2px;
    line-height: 1.45;
  }

  .directory-hotline-bar {
    margin-top: var(--space-4);
    padding: var(--space-4);
  }

  .directory-hotline-text {
    margin: 0;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    color: var(--ink-strong);
  }

  @media (max-width: 768px) {
    .suggestion-chip,
    .search-filter-pill {
      min-height: 44px;
      padding: 0 12px;
    }
  }
</style>

<script is:inline>
  ;(function () {
    var form = document.querySelector('[data-search-form]')
    var input = document.getElementById('q')
    var clearBtn = document.getElementById('q-clear')
    var wrapper = document.getElementById('results-wrapper')
    var out = document.getElementById('results-list')
    var emptyBox = document.getElementById('results-empty')
    var resetBtn = document.getElementById('results-reset-btn')
    var status = document.getElementById('q-status')
    var chips = document.querySelectorAll('.suggestion-chip')
    var filterPills = document.querySelectorAll('.search-filter-pill')

    if (!form || !input || !out) return

    var urlPrefix = form.getAttribute('data-prefix') || ''
    var lblFound = form.getAttribute('data-lbl-found') || '{n} results for "{q}"'
    var lblEmpty = form.getAttribute('data-lbl-empty') || 'No results for "{q}".'
    var lblLoading = form.getAttribute('data-lbl-loading') || 'Searching...'
    var catLabels = {}
    try {
      catLabels = JSON.parse(form.getAttribute('data-cat-labels') || '{}')
    } catch (_) {}

    var index = null
    var loadPromise = null
    var currentCat = 'all'
    var lastHits = []

    form.addEventListener('submit', function (e) {
      e.preventDefault()
      var q = input.value
      loadIndex().then(function () { render(q) })
    })

    function loadIndex() {
      if (index) return Promise.resolve()
      if (loadPromise) return loadPromise
      if (status && input.value.trim()) status.textContent = lblLoading
      loadPromise = fetch('/search-index.json')
        .then(function (r) { return r.json() })
        .then(function (data) { index = Array.isArray(data) ? data : [] })
        .catch(function () { index = [] })
      return loadPromise
    }

    function norm(s) {
      return (s || '').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    }

    function localizeUrl(u) {
      if (!u || !urlPrefix) return u
      if (u.indexOf(urlPrefix + '/') === 0 || u === urlPrefix) return u
      if (u.charAt(0) === '/') return urlPrefix + u
      return u
    }

    function highlight(text, terms) {
      if (!text || !terms.length) return document.createTextNode(text || '')
      var frag = document.createDocumentFragment()
      var regex = new RegExp('(' + terms.map(function (t) { return t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') }).join('|') + ')', 'gi')
      var parts = text.split(regex)
      parts.forEach(function (part) {
        if (!part) return
        if (terms.some(function (t) { return norm(t) === norm(part) })) {
          var mark = document.createElement('mark')
          mark.className = 'highlight'
          mark.textContent = part
          frag.appendChild(mark)
        } else {
          frag.appendChild(document.createTextNode(part))
        }
      })
      return frag
    }

    function inferCategory(url) {
      var u = (url || '').toLowerCase()
      if (u.indexOf('/serbisyo') !== -1) return 'serbisyo'
      if (u.indexOf('/ligtas') !== -1 || u.indexOf('/panahon') !== -1) return 'ligtas'
      if (u.indexOf('/opisyal') !== -1 || u.indexOf('/transparency') !== -1 || u.indexOf('/proyekto') !== -1) return 'pamamahala'
      return 'komunidad'
    }

    function render(q) {
      var terms = norm(q).split(/\s+/).filter(Boolean)
      if (clearBtn) clearBtn.hidden = !q

      if (!terms.length || !index) {
        if (wrapper) wrapper.hidden = true
        if (emptyBox) emptyBox.hidden = true
        out.innerHTML = ''
        if (status) status.textContent = ''
        return
      }

      lastHits = index
        .map(function (e) {
          var hay = norm((e.t || '') + ' ' + (e.d || '') + ' ' + (e.k || ''))
          var score = 0
          for (var i = 0; i < terms.length; i++) {
            if (hay.indexOf(terms[i]) === -1) return null
            if (norm(e.t).indexOf(terms[i]) !== -1) score += 3
            else if (norm(e.d).indexOf(terms[i]) !== -1) score += 2
            else score += 1
          }
          var cat = inferCategory(e.u || '')
          return { e: e, score: score, cat: cat }
        })
        .filter(Boolean)
        .sort(function (a, b) { return b.score - a.score })

      displayResults(terms)
    }

    function displayResults(terms) {
      var filtered = lastHits.filter(function (h) {
        return currentCat === 'all' || h.cat === currentCat
      })

      out.innerHTML = ''

      filtered.forEach(function (h) {
        var li = document.createElement('li')
        var a = document.createElement('a')
        a.className = 'result-card'
        a.href = localizeUrl(h.e.u)

        var badge = document.createElement('span')
        badge.className = 'result-card-badge'
        badge.textContent = catLabels[h.cat] || h.cat
        a.appendChild(badge)

        var title = document.createElement('h3')
        title.className = 'result-card-title'
        title.appendChild(highlight(h.e.t, terms))
        a.appendChild(title)

        if (h.e.d) {
          var desc = document.createElement('p')
          desc.className = 'result-card-desc'
          desc.appendChild(highlight(h.e.d, terms))
          a.appendChild(desc)
        }

        li.appendChild(a)
        out.appendChild(li)
      })

      if (wrapper) wrapper.hidden = false
      if (emptyBox) emptyBox.hidden = filtered.length > 0
      if (status) {
        status.textContent = filtered.length
          ? lblFound.replace('{n}', String(filtered.length)).replace('{q}', input.value)
          : lblEmpty.replace('{q}', input.value)
      }
    }

    function resetSearch() {
      input.value = ''
      currentCat = 'all'
      filterPills.forEach(function (p) {
        var isAll = p.getAttribute('data-cat') === 'all'
        p.classList.toggle('is-active', isAll)
        p.setAttribute('aria-pressed', isAll ? 'true' : 'false')
      })
      render('')
      input.focus()
    }

    var timer
    input.addEventListener('input', function () {
      clearTimeout(timer)
      var q = input.value
      timer = setTimeout(function () {
        loadIndex().then(function () { render(q) })
      }, 100)
    })

    if (clearBtn) clearBtn.addEventListener('click', resetSearch)
    if (resetBtn) resetBtn.addEventListener('click', resetSearch)

    chips.forEach(function (chip) {
      chip.addEventListener('click', function () {
        var q = chip.getAttribute('data-query') || ''
        input.value = q
        input.focus()
        loadIndex().then(function () { render(q) })
      })
    })

    filterPills.forEach(function (pill) {
      pill.addEventListener('click', function () {
        filterPills.forEach(function (p) {
          p.classList.remove('is-active')
          p.setAttribute('aria-pressed', 'false')
        })
        pill.classList.add('is-active')
        pill.setAttribute('aria-pressed', 'true')
        currentCat = pill.getAttribute('data-cat') || 'all'
        var terms = norm(input.value).split(/\s+/).filter(Boolean)
        displayResults(terms)
      })
    })

    // Hydrate from `?q=` query parameter (e.g. submitted from the mobile drawer search form)
    try {
      var initialQ = new URLSearchParams(window.location.search).get('q')
      if (initialQ && initialQ.trim()) {
        input.value = initialQ.trim()
        loadIndex().then(function () { render(input.value) })
      }
    } catch (_) {}
  })()
</script>
