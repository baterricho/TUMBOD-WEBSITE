---
/**
 * WeatherView — Dedicated Marine Weather & Sea Safety portal.
 */
import Section from '@/components/Section.astro'
import WeatherMarineWidget from '@/components/WeatherMarineWidget.astro'
import WeatherMap from '@/components/WeatherMap.astro'
import InteractiveCrossingPlanner from '@/components/InteractiveCrossingPlanner.astro'
import Icon from '@/components/Icon.astro'
import PhoneNumber from '@/components/PhoneNumber.astro'
import type { Locale } from '@/lib/i18n'
import { fetchLiveMarineWeather } from '@/lib/weather'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const fil = locale === 'fil'

const report = await fetchLiveMarineWeather()
---

<Section divider={false} class="section--airy">
  <div class="weather-hero-head">
    <span class="chip chip--info">
      <Icon name="wind" size={14} />
      <span>{fil ? 'BDRRMC at Philippine Coast Guard Telemetry' : 'BDRRMC & Philippine Coast Guard Telemetry'}</span>
    </span>
    <h1 class="page-title">
      {fil ? 'Panahon at Kalagayan ng Dagat' : 'Marine Weather & Sea Safety'}
    </h1>
    <p class="section-lede">
      {fil
        ? 'Real-time na datos ng hangin, alon, at babala sa paglalayag sa paligid ng Pulo ng Tuluran at Look ng Taytay. Alamin kung ligtas pumalaot bago tumawid.'
        : 'Real-time wind velocity, wave heights, and sea travel advisories for Tuluran Island and Taytay Bay. Check sea conditions before departing.'}
    </p>
  </div>
</Section>

<Section
  title={fil ? 'Kasalukuyang Lagay ng Dagat' : 'Current Sea & Weather Telemetry'}
  titleId="telemetry"
  divider={false}
>
  <WeatherMarineWidget locale={locale} initialData={report} />
</Section>

<Section title={fil ? 'Mapa ng Hangin at Alon' : 'Interactive Wind & Sea Map'} titleId="mapa" divider={true}>
  <WeatherMap
    locale={locale}
    defaultMode="windy"
    initialWindSpeed={report.current.windSpeedKph}
    initialWindDir={report.current.windDirectionDeg}
    initialWaveHeight={report.current.waveHeightM}
  />
</Section>

<Section
  title={fil ? 'Tagaplano ng Pagtawid sa Kipot' : 'Tuluran Strait Crossing Planner'}
  titleId="tagaplano"
  divider={true}
>
  <InteractiveCrossingPlanner locale={locale} />
</Section>

<Section
  title={fil ? 'Patakaran sa Paglalayag at BDRRMC' : 'Maritime Regulations & Sea Travel Protocols'}
  titleId="patakaran"
  divider={true}
>
  <div class="safety-rules-grid">
    <div class="rule-card">
      <div class="rule-card__icon" aria-hidden="true">
        <Icon name="shield" size={22} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Alituntunin ng Philippine Coast Guard' : 'Philippine Coast Guard Directives'}
      </h3>
      <p class="rule-card__body">
        {fil
          ? 'Alinsunod sa PCG Memorandum Circular No. 03-01, ipinagbabawal ang paglalayag ng mga bangkang de-motor na mas mababa sa 3 Gross Tonnage (3 GT) kapag may Gale Warning o kapag ang alon ay umabot sa 2.5 metro pataas.'
          : 'Under PCG Memorandum Circular No. 03-01, watercraft below 3 Gross Tonnage (3 GT) are prohibited from sailing when a Gale Warning is hoisted or when significant wave heights reach 2.5 meters.'}
      </p>
    </div>

    <div class="rule-card">
      <div class="rule-card__icon" aria-hidden="true">
        <Icon name="checklist" size={22} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Batas sa Kasuotang Pangligtas (Life Vests)' : 'Mandatory Life Vest Requirement'}
      </h3>
      <p class="rule-card__body">
        {fil
          ? 'Lahat ng pasahero at tripulante ay dapat nakasuot ng rehistradong life vest bago umalis ng pantalan. Mahigpit na ipinagbabawal ang labis na pasahero o kargamento sa bangka.'
          : 'All passengers and crew must wear approved life jackets prior to unmooring. Overloading of cargo or passengers is strictly prohibited.'}
      </p>
    </div>

    <div class="rule-card">
      <div class="rule-card__icon rule-card__icon--emergency" aria-hidden="true">
        <Icon name="phone" size={22} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Saklolo sa Dagat (Emergency Hotlines)' : 'Emergency Marine Rescue'}
      </h3>
      <p class="rule-card__body">
        {fil
          ? 'Kung may aberya sa makina o inabot ng unos sa kipot, tumawag agad sa BDRRMC o Coast Guard Sub-Station Taytay:'
          : 'For engine failures, capsizing risks, or squalls in the strait, call the rescue team immediately:'}
      </p>
      <div class="rule-hotlines">
        <div class="rule-hotline-row">
          <span>Coast Guard Taytay</span>
          <PhoneNumber number="0917-842-7653" locale={locale} />
        </div>
        <div class="rule-hotline-row">
          <span>BDRRMC Tumbod</span>
          <PhoneNumber number="0917-123-4567" locale={locale} />
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
  .weather-hero-head {
    max-width: var(--measure);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }

  .safety-rules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17.5rem, 100%), 1fr));
    gap: var(--space-4);
    margin-top: var(--space-3);
  }

  .rule-card {
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    padding: var(--space-5);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .rule-card__icon {
    width: 44px;
    height: 44px;
    border-radius: var(--r-inner);
    background: var(--interactive-surface);
    border: 1px solid var(--interactive-border);
    color: var(--interactive);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .rule-card__icon--emergency {
    background: var(--alert-emergency-surface);
    border-color: var(--alert-emergency-border);
    color: var(--alert-emergency-on-surface);
  }

  .rule-card__title {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--ink-strong);
  }

  .rule-card__body {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--ink-muted);
    line-height: 1.55;
  }

  .rule-hotlines {
    margin-top: auto;
    padding-top: var(--space-3);
    display: grid;
    gap: var(--space-2);
    border-top: 1px solid var(--line);
  }

  .rule-hotline-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    font-size: var(--text-xs);
    color: var(--ink);
  }
</style>
