---
/**
 * WeatherView.astro
 *
 * Dedicated view for "Panahon at Kalagayan ng Dagat" (Marine Weather & Sea Safety).
 * Houses the live WeatherMarineWidget, the interactive WeatherMap (Windy radar + streamline chart),
 * safe sailing regulations, and emergency contact links.
 */
import Section from '@/components/Section.astro'
import WeatherMarineWidget from '@/components/WeatherMarineWidget.astro'
import WeatherMap from '@/components/WeatherMap.astro'
import InteractiveCrossingPlanner from '@/components/InteractiveCrossingPlanner.astro'
import Icon from '@/components/Icon.astro'
import PhoneNumber from '@/components/PhoneNumber.astro'
import type { Locale } from '@/lib/i18n'
import { fetchLiveMarineWeather } from '@/lib/weather'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const fil = locale === 'fil'

const report = await fetchLiveMarineWeather()
---

<Section divider={false} class="section--airy">
  <div class="weather-hero-head">
    <div class="weather-hero-badge">
      <Icon name="wind" size={16} />
      <span>{fil ? 'BDRRMC at Philippine Coast Guard Telemetry' : 'BDRRMC & Philippine Coast Guard Telemetry'}</span>
    </div>
    <h1 class="page-title">
      {fil ? 'Panahon at Kalagayan ng Dagat' : 'Marine Weather & Sea Safety'}
    </h1>
    <p class="weather-hero-desc">
      {fil
        ? 'Real-time na datos ng hangin, alon, at babala sa paglalayag sa paligid ng Pulo ng Tuluran at Look ng Taytay. Alamin kung ligtas pumalaot ang iyong bangka bago tumawid.'
        : 'Real-time wind velocity, wave heights, and sea travel advisories for Tuluran Island and Taytay Bay. Verify whether it is safe to set sail before embarking on your crossing.'}
    </p>
  </div>
</Section>

{/* 1. Real-Time Weather & Sea Safety Advisory Widget */}
<Section title={fil ? 'Kasalukuyang Lagay ng Dagat' : 'Current Sea & Weather Telemetry'} titleId="telemetry" divider={false}>
  <WeatherMarineWidget locale={locale} initialData={report} />
</Section>

{/* 2. Interactive Wind & Weather Map (Windy Radar + Local Streamlines) */}
<Section title={fil ? 'Mapa ng Hangin at Alon' : 'Interactive Wind & Sea Map'} titleId="mapa" divider={true}>
  <WeatherMap
    locale={locale}
    initialWindSpeed={report.current.windSpeedKph}
    initialWindDir={report.current.windDirectionDeg}
    initialWaveHeight={report.current.waveHeightM}
  />
</Section>

{/* 3. Interactive Crossing Planner */}
<Section title={fil ? 'Tagaplano ng Pagtawid sa Kipot' : 'Tuluran Strait Crossing Planner'} titleId="tagaplano" divider={true}>
  <InteractiveCrossingPlanner locale={locale} />
</Section>

{/* 4. Safety Regulations & Coast Guard Rules */}
<Section title={fil ? 'Patakaran sa Paglalayag at BDRRMC' : 'Maritime Regulations & Sea Travel Protocols'} titleId="patakaran" divider={true}>
  <div class="safety-rules-grid">
    <div class="rule-card">
      <div class="rule-card__icon">
        <Icon name="shield" size={24} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Alituntunin ng Philippine Coast Guard' : 'Philippine Coast Guard Directives'}
      </h3>
      <p class="small muted">
        {fil
          ? 'Alinsunod sa PCG Memorandum Circular No. 03-01, ipinagbabawal ang paglalayag ng mga bangkang de-motor na mas mababa sa 3 Gross Tonnage (3 GT) kapag may Gale Warning o kapag ang alon ay umabot sa 2.5 metro pataas.'
          : 'Under PCG Memorandum Circular No. 03-01, watercraft below 3 Gross Tonnage (3 GT) are prohibited from sailing when a Gale Warning is hoisted or when significant wave heights reach 2.5 meters.'}
      </p>
    </div>

    <div class="rule-card">
      <div class="rule-card__icon">
        <Icon name="checklist" size={24} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Batas sa Kasuotang Pangligtas (Life Vests)' : 'Mandatory Life Vest Requirement'}
      </h3>
      <p class="small muted">
        {fil
          ? 'Lahat ng pasahero at tripulante ay dapat nakasuot ng rehistradong life vest bago umalis ng pantalan. Mahigpit na ipinagbabawal ang labis na pasahero o kargamento sa bangka.'
          : 'All passengers and crew must wear approved life jackets prior to unmooring. Overloading of cargo or passengers is strictly prohibited by barangay tanods and maritime marshals.'}
      </p>
    </div>

    <div class="rule-card">
      <div class="rule-card__icon">
        <Icon name="phone" size={24} />
      </div>
      <h3 class="rule-card__title">
        {fil ? 'Saklolo sa Dagat (Emergency Hotlines)' : 'Emergency Marine Rescue'}
      </h3>
      <p class="small muted">
        {fil
          ? 'Kung may aberya sa makina o inabot ng unos sa kipot, tumawag agad sa BDRRMC o Coast Guard Sub-Station Taytay:'
          : 'For engine failures, capsizing risks, or squalls in the strait, call the rescue team immediately:'}
      </p>
      <div class="rule-hotlines">
        <div class="rule-hotline-row">
          <span>{fil ? 'Coast Guard Taytay:' : 'Coast Guard Taytay:'}</span>
          <PhoneNumber number="0917-842-7653" locale={locale} />
        </div>
        <div class="rule-hotline-row">
          <span>{fil ? 'BDRRMC Tumbod:' : 'BDRRMC Tumbod:'}</span>
          <PhoneNumber number="0917-123-4567" locale={locale} />
        </div>
      </div>
    </div>
  </div>
</Section>

<style>
.weather-hero-head {
  max-width: var(--measure);
}

.weather-hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 4px 12px;
  background: var(--palette-sea-100);
  color: var(--palette-sea-800);
  border-radius: var(--radius-full);
  font-size: var(--text-xs);
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: var(--tracking-caps);
  margin-bottom: var(--space-2);
}

.weather-hero-desc {
  font-size: var(--text-lg);
  color: var(--palette-slate-600);
  line-height: 1.6;
  margin-top: var(--space-2);
}

.safety-rules-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--space-3);
  margin-top: var(--space-3);
}

.rule-card {
  background: var(--palette-slate-50);
  border: 1px solid var(--palette-slate-200);
  border-radius: var(--radius-md);
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
}

.rule-card__icon {
  width: 44px;
  height: 44px;
  border-radius: var(--radius-md);
  background: var(--palette-ocean-100);
  color: var(--palette-ocean-700);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: var(--space-2);
}

.rule-card__title {
  margin: 0 0 8px;
  font-size: var(--text-base);
  font-weight: 700;
  color: var(--palette-slate-900);
}

.rule-hotlines {
  margin-top: auto;
  padding-top: var(--space-2);
  display: flex;
  flex-direction: column;
  gap: 6px;
  border-top: 1px solid var(--palette-slate-200);
}

.rule-hotline-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: var(--text-xs);
}
</style>
